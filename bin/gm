#!/usr/bin/env bash
# gm: the Guildmaster's single command. Step 1, one ticket that never forgets, tracing slices 1 and 2, Party
# Leaders kept running in herdr, and the zero-touch start: gm alone opens the Guildmaster at the front desk.
set -euo pipefail

gm_realpath() {
  local p=$1 l
  while [ -L "$p" ]; do
    l=$(readlink "$p")
    case $l in /*) p=$l ;; *) p=$(dirname "$p")/$l ;; esac
  done
  printf '%s/%s' "$(cd "$(dirname "$p")" && pwd -P)" "$(basename "$p")"
}

GM_SELF=$(gm_realpath "${BASH_SOURCE[0]}")
GM_ROOT=$(cd "$(dirname "$GM_SELF")/.." && pwd -P)
# shellcheck source=bin/gm-front-desk-lib.sh
. "$GM_ROOT/bin/gm-front-desk-lib.sh"
# The clone's committed hooks (.claude/settings.json) reach every session started at its root, contributors' too, so
# they act only at the patron's front desk. That is decided before anything else runs; elsewhere, nothing happens.
if [ "${1:-}" = hook ]; then
  case ${2:-}/${3:-} in
    front-desk/* | front-desk-guard/*) gm_front_desk_home "$GM_ROOT" || exit 0 ;;
  esac
fi
GM_TEMPLATES=$GM_ROOT/templates
GM_HALL=${GM_HALL:-$HOME/.guildmaster}
case $GM_HALL in /*) ;; *) GM_HALL=$PWD/$GM_HALL ;; esac
GM_DB=$GM_HALL/register.db
GM_CONF=$GM_HALL/guild.conf
GM_CONF_OLD=$GM_HALL/setup.conf
GM_OTELCOL_PINNED=0.162.0

# ---- The guild's configuration: guild.conf in the Guildhall ----
# One "key: value" a line, documented in the file itself, read once at every start. A setting with an environment
# variable is overridden by it; gm config shows each value and where it came from, gm config set changes one.
# Each row: key, the variable that overrides it (- for none), default (- for none), kind, what it is.
GM_CONF_TABLE="collector	GM_COLLECTOR	off	collector	Keep the local OpenTelemetry Collector (tracing) running, in herdr tab collector. gm init's answer sets it; later: not decided yet.
collector-port	GM_OTEL_PORT	4318	port	The port on 127.0.0.1 the collector listens on, and Party Leaders send their telemetry to.
telemetry	GM_TELEMETRY	on	onoff	Party Leaders that gm starts send Claude Code's telemetry to the collector.
chat	GM_CHAT	banners	chat	How the chat of the Guildmaster and the Party Leaders gm starts looks: off is Claude Code's own, banners sets each message under a heraldic banner (mods/guild-chat). A running session keeps what it started with.
autostart	-	on	onoff	A launchd agent (macOS) runs the muster at login and every autostart-every minutes.
autostart-every	-	5	minutes	Minutes between the launchd agent's musters.
muster-before-commands	GM_HERDR_AUTO	on	onoff	A gm command typed at a terminal first brings back, quietly, whatever is dead or missing.
attach	GM_ATTACH	on	onoff	gm alone attaches herdr at the guildmaster tab.
herdr-session	GM_HERDR_SESSION	default	name	The herdr session the guild lives in; default is the one plain herdr attaches to.
herdr-workspace	GM_HERDR_WORKSPACE	guild	name	The herdr workspace holding the guildmaster tab; each Party Leader has a workspace of its own shown under it.
launch-grace	GM_LAUNCH_GRACE	60	seconds	Seconds after a start during which a pane holding only a shell is starting, not dead.
start-tries	GM_START_TRIES	3	count	Starts in a row never seen alive before a Party Leader, the Guildmaster or the collector is held.
repo-roots	-	-	text	Folders, separated by spaces, where gm repos looks for clones instead of the usual source folders."
GM_CONF_ENV=' '
GM_CONF_VARS=' '
GM_CONF_VAL=''

# The file gm reads: guild.conf, or setup.conf, where the settings were before, until a command moves them.
gm_conf_file() {
  if [ -f "$GM_CONF" ] || [ ! -f "$GM_CONF_OLD" ]; then printf '%s' "$GM_CONF"; else printf '%s' "$GM_CONF_OLD"; fi
}

# key<TAB>value for each line of the file that sets something, the first line of each key.
gm_conf_lines() {
  local f=${1:-}
  [ -n "$f" ] || f=$(gm_conf_file)
  [ -f "$f" ] || return 0
  awk '/^[[:space:]]*#/ || index($0, ":") == 0 { next }
    { k = $0; sub(/:.*/, "", k); v = $0; sub(/^[^:]*:[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v)
      if (k ~ /^[a-z0-9-]+$/ && v != "" && !(k in seen)) { seen[k] = 1; printf "%s\t%s\n", k, v } }' "$f"
}

# gm_conf_norm <kind> <value>: sets GM_CONF_VAL to the value as gm uses it, or fails for one it cannot take. The
# collector setting also reads setup.conf's answers: installed is on, skipped is off.
gm_conf_norm() {
  local v=$2
  case $1 in
    onoff | collector)
      case $v in
        on | yes | true) v=on ;;
        off | no | false) v=off ;;
        installed) [ "$1" = collector ] || return 1; v=on ;;
        skipped) [ "$1" = collector ] || return 1; v=off ;;
        later) [ "$1" = collector ] || return 1 ;;
        *) return 1 ;;
      esac ;;
    chat)
      case $v in
        banners | on | yes | true) v=banners ;;
        off | no | false) v=off ;;
        *) return 1 ;;
      esac ;;
    port) [[ $v =~ ^[0-9]{1,5}$ ]] && [ "$v" -ge 1 ] && [ "$v" -le 65535 ] || return 1 ;;
    minutes | count) [[ $v =~ ^[0-9]{1,6}$ ]] && [ "$v" -ge 1 ] || return 1 ;;
    seconds) [[ $v =~ ^[0-9]{1,6}$ ]] || return 1 ;;
    name) [[ $v =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || return 1 ;;
    text) [ -n "$v" ] || return 1 ;;
    *) return 1 ;;
  esac
  GM_CONF_VAL=$v
}

# Each setting with a variable takes the file's value unless the variable is set; one the file gives a value it cannot
# take keeps its default (gm config and gm doctor say so). Runs once, before anything reads the variables.
gm_conf_load() {
  local lines key env def kind desc k v val
  lines=$(gm_conf_lines)
  while IFS=$'\t' read -r key env def kind desc; do
    [ "$env" != - ] || continue
    GM_CONF_VARS="$GM_CONF_VARS$env "
    if [ -n "${!env:-}" ]; then
      GM_CONF_ENV="$GM_CONF_ENV$env "
      continue
    fi
    val=''
    while IFS=$'\t' read -r k v; do
      [ "$k" != "$key" ] || { val=$v; break; }
    done <<<"$lines"
    if [ -n "$val" ] && gm_conf_norm "$kind" "$val"; then
      printf -v "$env" '%s' "$GM_CONF_VAL"
    fi
  done <<<"$GM_CONF_TABLE"
}
gm_conf_load

# Whether gm hands a variable on to what it starts (a pane's launch line, the launchd agent): always one it was given
# in its environment, never one it took from guild.conf, since the gm it starts reads guild.conf itself and then sees
# a setting changed later.
gm_conf_carried() {
  case $GM_CONF_ENV in *" $1 "*) return 0 ;; esac
  case $GM_CONF_VARS in *" $1 "*) return 1 ;; esac
  return 0
}
GM_SCHEMA_VERSION=5
GM_STOP_BUDGET=${GM_STOP_BUDGET:-3}
GM_NOW="strftime('%Y-%m-%dT%H:%M:%fZ','now')"
GM_NOW_MS="CAST(ROUND((julianday('now')-2440587.5)*86400000) AS INTEGER)"
GM_STOPWORDS="a an the to of in on at for and or but is are was were be been it its this that these those i me my we our you your he she they them please can could would should will just also so here there now then some any with from into about as by if not do does did have has had get got make let lets s t m ll re ve d ok okay hey hi hello"

gm_die() { printf 'gm: %s\n' "$*" >&2; exit 1; }

gm_q() {
  local s=$1 sq="'"
  printf "'%s'" "${s//$sq/$sq$sq}"
}

gm_qn() {
  if [ -n "$1" ]; then gm_q "$1"; else printf 'NULL'; fi
}

gm_shq() {
  local s=$1 sq="'"
  printf "'%s'" "${s//$sq/$sq\\$sq$sq}"
}

gm_sql() {
  sqlite3 -bail -batch -noheader -separator "$(printf '\t')" -cmd '.timeout 15000' -cmd 'PRAGMA foreign_keys=ON' "$GM_DB" "$@"
}

gm_json_field() {
  sqlite3 -batch :memory: "SELECT json_extract(CAST(readfile($(gm_q "$1")) AS TEXT),$(gm_q "\$.$2"));" 2>/dev/null || true
}

gm_tmp() {
  mkdir -p "$GM_HALL/tmp"
  mktemp "$GM_HALL/tmp/gm.XXXXXX"
}

# Schema 1, as step 1 created it; a new register runs it and then the migration to schema 2.
gm_schema1_sql() {
  cat <<'SQL'
CREATE TABLE focus(
  id INTEGER PRIMARY KEY,
  name TEXT NOT NULL UNIQUE,
  kind TEXT NOT NULL DEFAULT 'ticket',
  repo TEXT NOT NULL,
  camp TEXT NOT NULL UNIQUE,
  branch TEXT NOT NULL,
  phase TEXT,
  opened_at TEXT NOT NULL
);
CREATE TABLE ticket(
  key TEXT PRIMARY KEY,
  focus_id INTEGER NOT NULL REFERENCES focus(id)
);
CREATE TABLE message(
  id INTEGER PRIMARY KEY,
  focus_id INTEGER REFERENCES focus(id),
  at TEXT NOT NULL,
  session_id TEXT,
  prompt_id TEXT,
  words TEXT NOT NULL,
  disposition TEXT NOT NULL CHECK (disposition IN ('posting','addition','command','unplaced')),
  posting_id INTEGER REFERENCES posting(id),
  sorted_at TEXT
);
CREATE TABLE posting(
  id INTEGER PRIMARY KEY,
  focus_id INTEGER NOT NULL REFERENCES focus(id),
  num INTEGER NOT NULL,
  slug TEXT NOT NULL,
  words TEXT NOT NULL,
  state TEXT NOT NULL CHECK (state IN ('received','queued','active','parked','needs-you','done','failed','closed')),
  park_why TEXT,
  park_until TEXT,
  message_id INTEGER REFERENCES message(id),
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  UNIQUE (focus_id, num)
);
CREATE TABLE event(
  id INTEGER PRIMARY KEY,
  at TEXT NOT NULL,
  actor TEXT NOT NULL,
  kind TEXT NOT NULL,
  focus_id INTEGER REFERENCES focus(id),
  posting_id INTEGER REFERENCES posting(id),
  session_id TEXT,
  verb TEXT,
  detail TEXT,
  line TEXT
);
CREATE TABLE guard(
  session_id TEXT PRIMARY KEY,
  blocks INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX posting_state ON posting(focus_id, state);
CREATE INDEX message_focus ON message(focus_id, sorted_at);
CREATE INDEX event_focus ON event(focus_id, id);
CREATE INDEX event_posting ON event(posting_id, id);
SQL
}

# Schema 1 to 2: tracing. Only adds; nothing in schema 1 is rewritten or dropped.
gm_schema2_sql() {
  cat <<'SQL'
ALTER TABLE posting ADD COLUMN trace_id TEXT;
ALTER TABLE posting ADD COLUMN span_id TEXT;
ALTER TABLE posting ADD COLUMN span_start_ms INTEGER;
ALTER TABLE posting ADD COLUMN follows_id INTEGER REFERENCES posting(id);
CREATE TABLE span(
  trace_id TEXT NOT NULL,
  span_id TEXT NOT NULL,
  parent_id TEXT,
  name TEXT NOT NULL,
  start_ms INTEGER NOT NULL,
  end_ms INTEGER NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('ok','error','unset')),
  attrs TEXT NOT NULL DEFAULT '{}' CHECK (json_valid(attrs)),
  PRIMARY KEY (trace_id, span_id)
);
CREATE INDEX span_parent ON span(trace_id, parent_id);
CREATE INDEX span_start ON span(start_ms);
CREATE TABLE span_link(
  trace_id TEXT NOT NULL,
  span_id TEXT NOT NULL,
  linked_trace_id TEXT NOT NULL,
  linked_span_id TEXT NOT NULL,
  attrs TEXT NOT NULL DEFAULT '{}' CHECK (json_valid(attrs)),
  PRIMARY KEY (trace_id, span_id, linked_trace_id, linked_span_id)
);
CREATE TABLE open_span(
  key TEXT PRIMARY KEY,
  session_id TEXT,
  trace_id TEXT NOT NULL,
  span_id TEXT NOT NULL,
  parent_id TEXT,
  name TEXT NOT NULL,
  start_ms INTEGER NOT NULL,
  attrs TEXT NOT NULL DEFAULT '{}' CHECK (json_valid(attrs))
);
CREATE INDEX open_span_session ON open_span(session_id);
CREATE TABLE prompt_version(
  name TEXT NOT NULL,
  sha256 TEXT NOT NULL,
  first_seen TEXT NOT NULL,
  text TEXT NOT NULL,
  PRIMARY KEY (name, sha256)
);
CREATE TABLE model_sample(
  id INTEGER PRIMARY KEY,
  at_ms INTEGER NOT NULL,
  session_id TEXT,
  prompt_id TEXT,
  model TEXT,
  effort TEXT,
  cost_usd REAL
);
CREATE INDEX model_sample_session ON model_sample(session_id, id);
PRAGMA user_version=2;
SQL
}

# Schema 2 to 3: where each Party Leader lives in herdr, and retired focuses. Only adds.
gm_schema3_sql() {
  cat <<'SQL'
ALTER TABLE focus ADD COLUMN closed_at TEXT;
ALTER TABLE focus ADD COLUMN start_attempts INTEGER NOT NULL DEFAULT 0;
ALTER TABLE focus ADD COLUMN held_at TEXT;
ALTER TABLE focus ADD COLUMN held_told INTEGER NOT NULL DEFAULT 0;
CREATE TABLE endpoint(
  key TEXT PRIMARY KEY,
  role TEXT NOT NULL,
  focus_id INTEGER REFERENCES focus(id),
  session TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  tab_id TEXT NOT NULL,
  pane_id TEXT NOT NULL,
  label TEXT NOT NULL,
  launched_ms INTEGER,
  recorded_at TEXT NOT NULL
);
PRAGMA user_version=3;
SQL
}

# Schema 3 to 4: the front desk's Guildmaster is kept running like a Party Leader, with its own start count and
# hold on its endpoint row. Only adds.
gm_schema4_sql() {
  cat <<'SQL'
ALTER TABLE endpoint ADD COLUMN start_attempts INTEGER NOT NULL DEFAULT 0;
ALTER TABLE endpoint ADD COLUMN held_at TEXT;
ALTER TABLE endpoint ADD COLUMN held_told INTEGER NOT NULL DEFAULT 0;
PRAGMA user_version=4;
SQL
}

# Schema 4 to 5: a Party Leader that asks to close its own focus, which gm finishes once it has ended. Only adds.
gm_schema5_sql() {
  cat <<'SQL'
ALTER TABLE focus ADD COLUMN close_requested_at TEXT;
PRAGMA user_version=5;
SQL
}

gm_db_init() {
  mkdir -p "$GM_HALL"
  local tmp=$GM_DB.init.$$
  rm -f "$tmp"
  sqlite3 -bail -batch "$tmp" >/dev/null <<SQL
PRAGMA journal_mode=WAL;
BEGIN IMMEDIATE;
$(gm_schema1_sql)
$(gm_schema2_sql)
$(gm_schema3_sql)
$(gm_schema4_sql)
$(gm_schema5_sql)
COMMIT;
SQL
  # ln refuses an existing target, so exactly one concurrent first caller installs its register.
  ln "$tmp" "$GM_DB" 2>/dev/null || true
  rm -f "$tmp" "$tmp-wal" "$tmp-shm"
}

# An older register is migrated in place, in one transaction, by the first gm command that finds it.
# Two callers may race: the loser's ALTER fails and rolls back, and it finds the new schema already there.
gm_db_migrate() {
  local from=$1 sql err
  case $from in
    1) sql="$(gm_schema2_sql) $(gm_schema3_sql) $(gm_schema4_sql) $(gm_schema5_sql)" ;;
    2) sql="$(gm_schema3_sql) $(gm_schema4_sql) $(gm_schema5_sql)" ;;
    3) sql="$(gm_schema4_sql) $(gm_schema5_sql)" ;;
    4) sql=$(gm_schema5_sql) ;;
  esac
  if ! err=$(sqlite3 -bail -batch -cmd '.timeout 15000' "$GM_DB" "BEGIN IMMEDIATE; $sql COMMIT;" 2>&1 >/dev/null); then
    [ "$(gm_sql 'PRAGMA user_version;')" = "$GM_SCHEMA_VERSION" ] || gm_die "could not migrate the register at $GM_DB to schema $GM_SCHEMA_VERSION: $err"
  fi
}

gm_db_ensure() {
  [ -s "$GM_DB" ] || gm_db_init
  [ -z "${GM_DB_READY:-}" ] || return 0
  local v
  v=$(gm_sql 'PRAGMA user_version;')
  case $v in
    5) ;;
    1 | 2 | 3 | 4) gm_db_migrate "$v" ;;
    *) gm_die "the register at $GM_DB is schema $v; this gm knows schema $GM_SCHEMA_VERSION" ;;
  esac
  GM_DB_READY=1
}

# The words a posting is named from: the patron's words without what only wraps them. Peeled from the start, one
# layer at a time: a leading tag such as <pasted_content id="3">, then (once a leading tag was peeled) a closing tag
# the words end in; a stray leading closing tag; the front desk's "From the patron, relayed by the front desk:"
# lead-in. Tags inside the words are the patron's and stay. The words in the register are never changed.
# Kept small: it is spliced into large queries, and SQLite's parser has a depth limit.
gm_naming_sql() {
  local ws="' '||char(9,10,13)" lead="'from the patron, relayed by the front desk:'"
  local closer="rtrim(t,'>abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-:.')"
  printf "(WITH RECURSIVE s(t,n,w) AS (SELECT trim(%s,%s),0,0 UNION ALL SELECT CASE
  WHEN t GLOB '<[A-Za-z]*>*' OR t GLOB '</[A-Za-z]*>*' THEN trim(substr(t,instr(t,'>')+1),%s)
  WHEN lower(t) GLOB %s||'*' THEN trim(substr(t,length(%s)+1),%s)
  ELSE trim(substr(%s,1,length(%s)-2),%s) END, n+1, w OR t GLOB '<[A-Za-z]*>*'
  FROM s WHERE n<8 AND (t GLOB '<[A-Za-z]*>*' OR t GLOB '</[A-Za-z]*>*' OR lower(t) GLOB %s||'*'
    OR (w AND t GLOB '*</[A-Za-z]*>' AND substr(%s,-2)='</')))
SELECT t FROM s ORDER BY n DESC LIMIT 1)" \
    "$1" "$ws" "$ws" "$lead" "$lead" "$ws" "$closer" "$closer" "$ws" "$lead" "$closer"
}

# Event and notice summaries quote the start of the words the posting is named from.
gm_summary_sql() {
  printf "(SELECT substr(replace(replace(x,char(10),' '),char(13),' '),1,60)||CASE WHEN length(x)>60 THEN '…' ELSE '' END FROM (SELECT %s AS x))" "$(gm_naming_sql "$1")"
}

gm_slugify() {
  local text w out='' n=0
  text=$(sqlite3 -batch -noheader :memory: "SELECT $(gm_naming_sql "$(gm_q "$1")");" 2>/dev/null) || text=$1
  text=$(printf '%s' "$text" | head -c 400 | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -c 'a-z0-9' ' ')
  set -f
  for w in $text; do
    case " $GM_STOPWORDS " in *" $w "*) continue ;; esac
    out=${out:+$out-}$w
    n=$((n + 1))
    [ "$n" -ge 4 ] && break
  done
  set +f
  out=${out:0:40}
  out=${out%-}
  printf '%s' "${out:-posting}"
}

gm_valid_slug() {
  local re='^[a-z0-9][a-z0-9-]{0,39}$'
  [[ $1 =~ $re ]]
}

gm_context_focus() {
  if [ -n "${GM_FOCUS:-}" ]; then
    printf '%s' "$GM_FOCUS"
    return
  fi
  [ -s "$GM_DB" ] || return 0
  local pwd_p
  pwd_p=$(pwd -P)
  gm_sql "SELECT name FROM focus WHERE camp=$(gm_q "$pwd_p") OR substr($(gm_q "$pwd_p"),1,length(camp)+1)=camp||'/' ORDER BY length(camp) DESC LIMIT 1;"
}

gm_focus_id() {
  gm_sql "SELECT id FROM focus WHERE name=$(gm_q "$1");"
}

gm_focus_field() {
  gm_sql "SELECT $2 FROM focus WHERE name=$(gm_q "$1");"
}

gm_require_focus() {
  local f=${1:-}
  [ -n "$f" ] || f=$(gm_context_focus)
  [ -n "$f" ] || gm_die "no focus here: run inside a camp, set GM_FOCUS, or name the focus"
  [ -n "$(gm_focus_id "$f")" ] || gm_die "no focus named '$f'"
  printf '%s' "$f"
}

# Prints "posting<TAB>id<TAB>canonical" or "focus<TAB>id<TAB>name" for exactly one match.
gm_resolve() {
  local ref=$1 ctx fname='' num='' slug='' word='' ticket='' sql
  local re_num='^#?([0-9]+)$'
  local re_qnum='^([a-z0-9][a-z0-9-]*)?#([0-9]+)$'
  local re_qslug='^([a-z0-9][a-z0-9-]*)?#([a-z0-9][a-z0-9-]*)$'
  local re_ticket='^[A-Za-z][A-Za-z0-9]*-[0-9]+$'
  local re_word='^[a-z0-9][a-z0-9-]*$'
  gm_db_ensure
  ctx=$(gm_context_focus)
  if [[ $ref =~ $re_num ]]; then
    num=${BASH_REMATCH[1]}
  elif [[ $ref =~ $re_qnum ]]; then
    fname=${BASH_REMATCH[1]}
    num=${BASH_REMATCH[2]}
  elif [[ $ref =~ $re_qslug ]]; then
    fname=${BASH_REMATCH[1]}
    slug=${BASH_REMATCH[2]}
  elif [[ $ref =~ $re_ticket ]]; then
    ticket=$(printf '%s' "$ref" | tr '[:lower:]' '[:upper:]')
  elif [[ $ref =~ $re_word ]]; then
    word=$ref
  else
    gm_die "cannot read '$ref' as a reference (try 12, #12, focus#12, focus, or a ticket key)"
  fi
  local scope
  if [ -n "$fname" ]; then
    scope="f.name=$(gm_q "$fname")"
  elif [ -n "$ctx" ]; then
    scope="f.name=$(gm_q "$ctx")"
  else
    scope="1"
  fi
  if [ -n "$num" ]; then
    sql="SELECT 'posting', p.id, f.name||'#'||p.num||' '||p.slug FROM posting p JOIN focus f ON f.id=p.focus_id WHERE $scope AND p.num=$num ORDER BY f.name;"
  elif [ -n "$slug" ]; then
    sql="SELECT 'posting', p.id, f.name||'#'||p.num||' '||p.slug FROM posting p JOIN focus f ON f.id=p.focus_id WHERE $scope AND p.slug=$(gm_q "$slug") ORDER BY f.name, p.num;"
  elif [ -n "$ticket" ]; then
    sql="SELECT 'focus', f.id, f.name FROM ticket t JOIN focus f ON f.id=t.focus_id WHERE t.key=$(gm_q "$ticket");"
  else
    sql="SELECT 'focus', id, name FROM focus WHERE name=$(gm_q "$word")
         UNION ALL
         SELECT 'posting', p.id, f.name||'#'||p.num||' '||p.slug FROM posting p JOIN focus f ON f.id=p.focus_id WHERE $scope AND p.slug=$(gm_q "$word");"
  fi
  local out count
  out=$(gm_sql "$sql")
  count=$(printf '%s' "$out" | grep -c . || true)
  if [ "$count" -eq 0 ]; then
    gm_die "nothing matches '$ref'${ctx:+ in focus $ctx}"
  elif [ "$count" -gt 1 ]; then
    {
      printf "gm: '%s' is ambiguous; name one of:\n" "$ref"
      printf '%s\n' "$out" | cut -f3 | sed 's/^/  /'
    } >&2
    exit 1
  fi
  printf '%s\n' "$out"
}

gm_resolve_posting() {
  local kind id canon out
  out=$(gm_resolve "$1") || exit 1
  IFS=$'\t' read -r kind id canon <<<"$out"
  [ "$kind" = posting ] || gm_die "'$1' names the focus $canon, not a posting"
  printf '%s' "$id"
}

gm_hall_file() {
  local rel=$1 src=$2
  local dst=$GM_HALL/$rel
  if [ ! -e "$dst" ]; then
    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
  fi
  printf '%s' "$dst"
}

gm_playbook_path() { printf '%s' "$GM_HALL/playbooks/$1.md"; }
gm_rules_path() { printf '%s' "$GM_HALL/rules/$(basename "$1").md"; }
gm_charter_path() { printf '%s' "$GM_HALL/charter.md"; }

gm_setting() {
  local file=$1 key=$2
  [ -f "$file" ] || return 0
  sed -n "s/^$key:[[:space:]]*\\([^[:space:]].*\\)\$/\\1/p" "$file" | head -n 1 | sed 's/[[:space:]]*$//'
}

gm_phases() {
  local file=$1
  [ -f "$file" ] || return 0
  sed -n 's/^phase:[[:space:]]*\([a-z0-9][a-z0-9-]*\).*$/\1/p' "$file"
}

gm_phase_position() {
  local phase=$1 file=$2 i=0 n p pos=''
  n=$(gm_phases "$file" | grep -c . || true)
  for p in $(gm_phases "$file"); do
    i=$((i + 1))
    [ "$p" = "$phase" ] && pos="$i/$n"
  done
  printf '%s' "$pos"
}

gm_gm_command() {
  local onpath
  onpath=$(command -v gm 2>/dev/null || true)
  if [ -n "$onpath" ] && [ "$(gm_realpath "$onpath")" = "$GM_SELF" ]; then
    printf 'gm'
  else
    printf 'bash %s' "$GM_SELF"
  fi
}

gm_usage() {
  cat <<'EOF'
usage: gm [<command> [arguments]]

The patron needs none of these: claude, started in the clone, links gm into ~/.local/bin, checks the setup, keeps
autostart on, and starts the Guildmaster in herdr's guildmaster tab, where it always lives, with every Party Leader.
They are for advanced use, and for the Guildmaster.

  (no command)            the same from any terminal: opens herdr at the guildmaster tab, where gm starts the
                          Guildmaster and keeps it running; it checks the setup, keeps autostart on and brings
                          every Party Leader up. Without a terminal it only starts the Guildmaster and says where
  open <focus> --repo <path> [--ticket KEY]... [--branch NAME] [--base REF] [--kind ticket] [--no-launch]
                          record a focus, make its camp, install its Claude Code hooks, and start its Party
                          Leader in a herdr workspace of its own on the camp (└ <focus>, shown under workspace
                          guild), where it stays; never takes over the terminal it runs in, and needs none.
                          With --ticket, the focus name may be left out: it is the first ticket key in lower case
                          (crm-1234)
  open <focus>            the same for an existing focus: a running Party Leader is left as it is, a dead or
                          missing one starts again (a fresh session resumes from records); reopens a closed focus
  up [--quiet]            the muster, plain code with no model: start the front desk's Guildmaster, every open
                          focus's Party Leader and, while guild.conf says collector: on, the tracing collector,
                          whichever is dead or missing, and leave the running ones alone; one that fails to start
                          3 times in a row is held until gm open (gm, for the Guildmaster; a day, for the
                          collector); any other gm command at a terminal does the same, quietly
  config [get <key> | set <key> <value> | unset <key>]
                          the settings in guild.conf in the Guildhall: every one, its value and where it came
                          from (the environment, the file, or the default); set changes one and acts on it at
                          once (autostart, the collector); the Guildmaster runs it when the patron asks
  install herdr           install herdr, with Homebrew when it is there or else herdr's official installer, never
                          with sudo, finish the setup and start the Guildmaster in herdr; the session where the
                          patron started claude runs it on their yes
  autostart [on [--every MINUTES] | off | status]
                          a launchd agent (macOS) that runs gm up --quiet at login and every 5 minutes. The
                          Guildmaster turns it on by itself; off is the switch to stop it, and it stays off
  roster [--all]          the front desk's Guildmaster and each Party Leader with its herdr pane and state
                          (alive, starting, dead, missing, held, unknown; --all adds closed focuses)
  close <focus>           retire a focus: its Party Leader is not started again (end a running one first);
                          its camp and postings are kept. Run by that Party Leader itself, with every posting
                          finished, it asks to close: gm types /exit once its turn ends, then closes the focus
  start <focus> --pane ID what a Party Leader's herdr pane runs: claude in the camp (only in that pane);
                          start guildmaster --pane ID is what the front desk's pane runs
  repos [<word>]          repositories gm knows (from focuses) and git clones under the usual source folders
                          (guild.conf repo-roots: overrides them) whose folder name contains the word
  post [--slug S] [--from REF] [--follows REF] <words|->
                          add a posting to the current focus (state received)
  resolve <ref>           print the one record a reference names: 12, #12, focus#12, focus#slug, focus, KEY-123
  list [--all] [--state S] [focus]
                          postings of the current focus (or every focus at the front desk)
  show <ref>              a posting with the patron's words, additions and history
  notice <ref> <verb> [detail] [--slug S] [--follows REF]
                          record an event and print its one-line notice; --follows ties the posting
                          to an earlier one on the same topic
                          verbs: queued started resumed needs-you done failed closed update
  park <ref> --why TEXT [--until TIME-OR-EVENT]
                          set a posting aside, visibly, with a reason
  phase [focus] [phase]   show or set the focus's playbook phase
  where [focus]           the resume summary, built from the register
  statusline              the Claude Code status line (reads the session JSON on stdin)
  trace [posting|focus]   a posting's trace as a text waterfall (a focus: every posting and session)
  trace import            fold Claude Code's telemetry from the local collector into the register
                          (gm trace and gm stats run it first, quietly)
  stats [posting|focus]   measures computed from the spans: first reply, exchanges, steps, tokens, cost
  stats --by-prompt <template> [focus]
                          outcomes per version of a prompt template (charter, playbook, rules, resume)
  stats --compare <selection> [--over DURATION] [focus]
                          what sets a selection apart from the rest; selections: slow-tools (30s),
                          slow-hooks (1s), slow-replies (2m), slow-calls (30s), not-right-first-time
  collector               run the local OpenTelemetry Collector (templates/otelcol.yaml) in the foreground, unless
                          one already answers on its port; with collector: on, gm keeps one running in herdr
  init [--yes | --no | --later] [--again] [--bin-dir DIR]
                          the first-run check: what gm needs and what is missing; asks whether to install
                          the collector, skip it or decide later, and records the answer in guild.conf.
                          --yes installs every missing optional piece, --no goes without, --later decides
                          later; --again asks about a piece you skipped. The Guildmaster runs it by itself
                          at every start, without questions, and offers the collector in chat.
  doctor                  the state of setup and dependencies; that telemetry goes only to 127.0.0.1 and
                          that the collector answers

Environment (each one with a setting in guild.conf overrides it; gm config shows which): GM_HALL (default
  ~/.guildmaster), GM_FOCUS (focus context override), GM_COLLECTOR=on|off (keep the collector running),
  GM_OTEL_PORT (collector port, default 4318), GM_TELEMETRY=off (gm open starts sessions without telemetry),
  GM_CHAT=off|banners (how the chat of the sessions gm starts looks),
  GM_OTELCOL (the collector binary, default otelcol-contrib on PATH or where gm init put it),
  GM_BIN_DIR (where gm init installs it, default ~/.local/bin), GM_INTERACTIVE=1|0 (force or forbid questions
  and the muster before commands), GM_CLAUDE and GM_HERDR (the claude and herdr commands, default found on PATH),
  GM_HERDR_SESSION (herdr session, default default), GM_HERDR_WORKSPACE (default guild),
  GM_HERDR_AUTO=off (no muster before other commands), GM_ATTACH=off (gm alone never attaches herdr).
EOF
}

gm_cmd_open() {
  local focus='' repo='' branch='' base='' kind=ticket launch=1 tickets=''
  while [ $# -gt 0 ]; do
    case $1 in
      --repo) repo=${2:?--repo needs a path}; shift 2 ;;
      --ticket) tickets="$tickets $(printf '%s' "${2:?--ticket needs a key}" | tr '[:lower:]' '[:upper:]')"; shift 2 ;;
      --branch) branch=${2:?--branch needs a name}; shift 2 ;;
      --base) base=${2:?--base needs a ref}; shift 2 ;;
      --kind) kind=${2:?--kind needs a kind}; shift 2 ;;
      --no-launch) launch=0; shift ;;
      -*) gm_die "open: unknown option $1" ;;
      *) [ -z "$focus" ] || gm_die "open: one focus at a time"; focus=$1; shift ;;
    esac
  done
  local re_focus='^[a-z0-9][a-z0-9-]{0,31}$' re_key='^[A-Z][A-Z0-9]*-[0-9]+$' t
  for t in $tickets; do [[ $t =~ $re_key ]] || gm_die "open: '$t' is not a ticket key like CRM-8965"; done
  if [ -z "$focus" ] && [ -n "$tickets" ]; then
    set -f
    for t in $tickets; do focus=${focus:-$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]')}; done
    set +f
  fi
  [[ $focus =~ $re_focus ]] || gm_die "open: a focus name is lowercase letters, digits and dashes, for example appt-v2"
  [ "$focus" != "$GM_FRONT_DESK" ] || gm_die "open: $GM_FRONT_DESK is the front desk's name; choose another focus name"
  [ "$focus" != "$GM_COLLECTOR_TAB" ] || gm_die "open: $GM_COLLECTOR_TAB is the tracing collector's tab; choose another focus name"
  [ "$kind" = ticket ] || gm_die "open: step 1 knows only the ticket kind"
  gm_telemetry_refuse
  [ "$launch" = 0 ] || gm_herdr_require open
  gm_db_ensure

  local fid camp
  fid=$(gm_focus_id "$focus")
  if [ -n "$fid" ]; then
    local rec_repo
    rec_repo=$(gm_focus_field "$focus" repo)
    if [ -n "$repo" ] && [ "$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null || true)" != "$rec_repo" ]; then
      gm_die "open: focus $focus already works on $rec_repo"
    fi
    [ -z "$branch" ] || [ "$branch" = "$(gm_focus_field "$focus" branch)" ] || gm_die "open: focus $focus is recorded on branch $(gm_focus_field "$focus" branch); its branch never changes"
    repo=$rec_repo
    branch=$(gm_focus_field "$focus" branch)
    camp=$(gm_focus_field "$focus" camp)
    kind=$(gm_focus_field "$focus" kind)
    if [ ! -d "$camp" ]; then
      git -C "$repo" worktree add "$camp" "$branch" >&2 || gm_die "open: could not make the camp again at $camp"
    fi
  else
    [ -n "$repo" ] || gm_die "open: a new focus needs --repo <path to an existing clone>"
    [ -d "$repo" ] || gm_die "open: no directory $repo"
    repo=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || gm_die "open: $repo is not a git working tree"
    repo=$(cd "$repo" && pwd -P)
    local taken
    set -f
    for t in $tickets; do
      taken=$(gm_sql "SELECT f.name FROM ticket t JOIN focus f ON f.id=t.focus_id WHERE t.key=$(gm_q "$t");")
      [ -z "$taken" ] || gm_die "open: ticket $t is already attached to focus $taken"
    done
    set +f
    local rules first_ticket='' pattern
    rules=$(gm_hall_file "rules/$(basename "$repo").md" "$GM_TEMPLATES/rules/repository.md")
    set -f
    for t in $tickets; do first_ticket=${first_ticket:-$t}; done
    set +f
    if [ -z "$branch" ]; then
      pattern=$(gm_setting "$rules" feature-branch)
      pattern=${pattern:-feature/\{ticket\}}
      branch=${pattern//\{ticket\}/${first_ticket:-$focus}}
      branch=${branch//\{focus\}/$focus}
    fi
    git check-ref-format --branch "$branch" >/dev/null 2>&1 || gm_die "open: '$branch' is not a valid branch name"
    mkdir -p "$GM_HALL/camps"
    camp=$GM_HALL/camps/$focus
    [ ! -e "$camp" ] || gm_die "open: $camp already exists but no focus $focus is recorded"
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$repo" worktree add "$camp" "$branch" >&2 || gm_die "open: git would not check out $branch in a new camp (is it checked out in another worktree?)"
    elif [ -n "$(git -C "$repo" for-each-ref --format='%(refname)' "refs/remotes/*/$branch")" ]; then
      git -C "$repo" worktree add "$camp" "$branch" >&2 || gm_die "open: git would not track the remote $branch in a new camp"
    else
      if [ -z "$base" ]; then
        base=$(gm_setting "$rules" base-branch)
      fi
      if [ -z "$base" ]; then
        if git -C "$repo" rev-parse --verify -q origin/HEAD >/dev/null; then base=origin/HEAD; else base=HEAD; fi
      fi
      git -C "$repo" worktree add -b "$branch" "$camp" "$base" >&2 || gm_die "open: could not create $branch from $base in a new camp"
    fi
    camp=$(cd "$camp" && pwd -P)
    local ticket_sql=''
    set -f
    for t in $tickets; do
      ticket_sql="$ticket_sql INSERT INTO ticket(key, focus_id) SELECT $(gm_q "$t"), id FROM focus WHERE name=$(gm_q "$focus");"
    done
    set +f
    if ! gm_sql <<SQL
BEGIN IMMEDIATE;
INSERT INTO focus(name, kind, repo, camp, branch, phase, opened_at)
  VALUES ($(gm_q "$focus"), $(gm_q "$kind"), $(gm_q "$repo"), $(gm_q "$camp"), $(gm_q "$branch"), NULL, $GM_NOW);
$ticket_sql
INSERT INTO event(at, actor, kind, focus_id, detail, line)
  SELECT $GM_NOW, 'patron', 'focus.opened', id, $(gm_q "repo $repo, branch $branch, camp $camp"), name||' opened on '||branch FROM focus WHERE name=$(gm_q "$focus");
COMMIT;
SQL
    then
      git -C "$repo" worktree remove "$camp" >&2 || true
      gm_die "open: could not record focus $focus in the register"
    fi
    fid=$(gm_focus_id "$focus")
  fi
  if [ -n "$tickets" ] && [ -n "$fid" ]; then
    local add=''
    set -f
    for t in $tickets; do add="$add INSERT OR IGNORE INTO ticket(key, focus_id) VALUES ($(gm_q "$t"), $fid);"; done
    set +f
    gm_sql "BEGIN IMMEDIATE; $add COMMIT;"
  fi
  gm_hall_file "rules/$(basename "$repo").md" "$GM_TEMPLATES/rules/repository.md" >/dev/null
  gm_hall_file "playbooks/$kind.md" "$GM_TEMPLATES/playbooks/$kind.md" >/dev/null
  gm_hall_file charter.md "$GM_TEMPLATES/charter.md" >/dev/null
  gm_install_camp "$focus" "$camp"
  local playbook phase0
  playbook=$(gm_playbook_path "$kind")
  if [ -z "$(gm_focus_field "$focus" phase)" ]; then
    phase0=$(gm_phases "$playbook" | head -n 1)
    [ -z "$phase0" ] || gm_set_phase "$focus" "$phase0" gm >/dev/null
  fi
  printf '%s is open: camp %s on branch %s\n' "$focus" "$camp" "$branch"
  gm_reopen_focus "$focus"
  if [ "$launch" = 1 ]; then
    gm_party_leader_up "$focus"
    gm_party_leader_where "$focus"
  else
    printf 'Start its Party Leader in herdr with: gm open %s\n' "$focus"
  fi
}

gm_install_camp() {
  local focus=$1 camp=$2 settings dir exclude prefix gmcmd
  dir=$camp/.claude
  settings=$dir/settings.local.json
  if [ -e "$settings" ] && ! grep -q '"GM_FOCUS"' "$settings"; then
    gm_die "open: $settings exists and was not written by gm; move it aside first"
  fi
  if git -C "$camp" ls-files --error-unmatch .claude/settings.local.json >/dev/null 2>&1; then
    gm_die "open: the repository tracks .claude/settings.local.json; gm will not overwrite a tracked file"
  fi
  mkdir -p "$dir"
  prefix="GM_HALL=$(gm_shq "$GM_HALL") GM_FOCUS=$(gm_shq "$focus") bash $(gm_shq "$GM_SELF")"
  gmcmd="bash $GM_SELF"
  local tmp
  tmp=$(gm_tmp)
  sqlite3 -batch :memory: >"$tmp" <<SQL
SELECT json_object(
  'env', json_object('GM_HALL', $(gm_q "$GM_HALL"), 'GM_FOCUS', $(gm_q "$focus")),
  'permissions', json_object('allow', json_array('Bash(gm *)', $(gm_q "Bash($gmcmd *)"))),
  'hooks', json_object(
    'SessionStart', json_array(json_object('hooks', json_array(
      json_object('type','command','command', $(gm_q "$prefix hook session-start")),
      json_object('type','command','command', $(gm_q "$prefix hook charter"))))),
    'UserPromptSubmit', json_array(json_object('hooks', json_array(
      json_object('type','command','command', $(gm_q "$prefix hook prompt"))))),
    'Stop', json_array(json_object('hooks', json_array(
      json_object('type','command','command', $(gm_q "$prefix hook stop"))))),
    'PreCompact', json_array(json_object('hooks', json_array(
      json_object('type','command','command', $(gm_q "$prefix hook precompact"))))),
    'SessionEnd', json_array(json_object('hooks', json_array(
      json_object('type','command','command', $(gm_q "$prefix hook session-end"), 'timeout', 5)))),
    'PreToolUse', json_array(json_object('hooks', json_array(
      json_object('type','command','command', $(gm_q "$prefix hook pre-tool"), 'timeout', 10)))),
    'PostToolUse', json_array(json_object('hooks', json_array(
      json_object('type','command','command', $(gm_q "$prefix hook post-tool"), 'timeout', 10)))),
    'PostToolUseFailure', json_array(json_object('hooks', json_array(
      json_object('type','command','command', $(gm_q "$prefix hook post-tool-failure"), 'timeout', 10)))),
    'SubagentStart', json_array(json_object('hooks', json_array(
      json_object('type','command','command', $(gm_q "$prefix hook subagent-start"), 'timeout', 10)))),
    'SubagentStop', json_array(json_object('hooks', json_array(
      json_object('type','command','command', $(gm_q "$prefix hook subagent-stop"), 'timeout', 10)))),
    'StopFailure', json_array(json_object('hooks', json_array(
      json_object('type','command','command', $(gm_q "$prefix hook stop-failure"), 'timeout', 10))))
  ),
  'statusLine', json_object('type','command','command', $(gm_q "$prefix statusline"), 'refreshInterval', 5)
);
SQL
  mv "$tmp" "$settings"
  if ! git -C "$camp" check-ignore -q .claude/settings.local.json 2>/dev/null; then
    exclude=$(git -C "$camp" rev-parse --git-path info/exclude)
    case $exclude in /*) ;; *) exclude=$camp/$exclude ;; esac
    mkdir -p "$(dirname "$exclude")"
    printf '%s\n' '/.claude/settings.local.json' >>"$exclude"
  fi
}

# ---- The front desk: the Guildmaster's own Claude Code session (vision/zero-touch-start.md) ----
# It always lives in herdr, in the guild workspace's guildmaster tab: claude in the clone, whose committed start-up
# hook makes it the Guildmaster. The Guildhall's front-desk folder holds only its charter, the patron's own copy,
# never above a camp, so it never reaches a Party Leader.

gm_front_desk_dir() { printf '%s' "$GM_HALL/front-desk"; }

# What the Guildmaster's session carries, so the gm it runs reaches the same Guildhall, herdr session and launchd.
GM_DESK_VARS="GM_HALL GM_CLAUDE GM_TELEMETRY GM_CHAT GM_OTEL_ENDPOINT GM_OTEL_PORT GM_HERDR GM_HERDR_SESSION GM_HERDR_WORKSPACE GM_LAUNCH_AGENTS GM_LAUNCHCTL"

# The front desk's charter, CLAUDE.md in the Guildhall's front-desk folder: copied once, the patron's from then on.
gm_front_desk_files() {
  local dir
  dir=$(gm_front_desk_dir)
  mkdir -p "$dir"
  [ -e "$dir/CLAUDE.md" ] || cp "$GM_TEMPLATES/guildmaster.md" "$dir/CLAUDE.md"
}

# The required pieces that are missing, one "what: what to do" line each; nothing when gm can run.
# gm_required_problems [id]: leaves that piece out.
gm_required_problems() {
  local id level state detail
  while IFS=$'\t' read -r id level state detail; do
    [ -n "$id" ] && [ "$level" = required ] && [ "$state" != ok ] && [ "$id" != "${1:-}" ] || continue
    printf -- '- %s: %s\n' "$detail" "$(gm_init_meaning "$id")"
  done <<<"$(gm_init_probe)"
}

# Puts gm on the PATH of later shells and of the launchd agent: a symlink to this gm in ~/.local/bin, the folder made
# if needed, never with sudo, and never over another gm. Prints ok (already there), linked, foreign: <what is
# there>, or failed: <why>.
gm_link_ensure() {
  local dir=$HOME/.local/bin link
  link=$dir/gm
  if [ ! -L "$link" ] && [ ! -e "$link" ]; then
    mkdir -p "$dir" 2>/dev/null && ln -s "$GM_SELF" "$link" 2>/dev/null && { printf 'linked'; return 0; }
  fi
  if [ -L "$link" ] && [ -e "$link" ] && [ "$(gm_realpath "$link")" = "$GM_SELF" ]; then
    printf 'ok'
  elif [ -L "$link" ]; then
    printf 'foreign: a link to %s' "$(readlink "$link")"
  elif [ -e "$link" ]; then
    printf 'foreign: a file of its own'
  else
    printf 'failed: could not write %s' "$link"
  fi
}

# The clone's SessionStart hook, as the committed .claude/settings.json runs it, at the patron's front desk only (the
# check at the top of this file). It never fails the session: whatever goes wrong becomes one line for the Guildmaster
# to pass on.
gm_hook_clone() {
  local out err rc=0 why
  err=$(mktemp "${TMPDIR:-/tmp}/gm-hook.XXXXXX" 2>/dev/null) || err=''
  out=$(gm_hook_front_desk 2>"${err:-/dev/null}") || rc=$?
  if [ "$rc" = 0 ] && [ -n "$out" ]; then
    printf '%s\n' "$out"
  else
    why=''
    [ -z "$err" ] || why=$(tail -n 3 "$err" | tr '\n' ' ')
    sqlite3 -batch :memory: "SELECT json_object('hookSpecificOutput', json_object('hookEventName', 'SessionStart', 'additionalContext',
      $(gm_q "gm front desk: the guild's start-up did not finish (exit $rc${why:+: $why}). Tell the patron so in one line, with that error, and that a restart of claude in this folder tries again. Until then you can answer only from what gm says when run.")));" 2>/dev/null || true
  fi
  [ -z "$err" ] || rm -f "$err"
  return 0
}

# The clone's PreToolUse guard, at the patron's front desk only (the check at the top of this file): the rules the
# front desk's settings held before it moved to the clone's root, where settings would bind contributors too. The
# Guildmaster changes no file, so Edit, Write and NotebookEdit are denied; a plain call of this gm runs without a
# prompt. Everything else is left to Claude Code's own permissions. It never touches the register.
gm_hook_front_desk_guard() {
  local input tool
  input=$(cat)
  tool=$(gm_guard_field "$input" tool_name)
  case $tool in
    Edit | Write | NotebookEdit | MultiEdit)
      gm_guard_json deny "The Guildmaster changes no file: that is a Party Leader's work, in its camp. Offer to open a focus for it instead." ;;
    Bash)
      if gm_guard_plain_gm "$(gm_guard_field "$input" tool_input.command)" "$(gm_guard_field "$input" cwd)"; then
        gm_guard_json allow "gm is the Guildmaster's own tool."
      fi ;;
  esac
  return 0
}

# gm_guard_field <hook input> <path>: one field of the hook's JSON, read through stdin so no size limit applies.
gm_guard_field() {
  sqlite3 -batch :memory: 2>/dev/null <<SQL || true
SELECT json_extract($(gm_q "$1"), $(gm_q "\$.$2"));
SQL
}

gm_guard_json() {
  sqlite3 -batch :memory: "SELECT json_object('hookSpecificOutput', json_object('hookEventName', 'PreToolUse',
    'permissionDecision', $(gm_q "$1"), 'permissionDecisionReason', $(gm_q "$2")));"
}

# gm_guard_plain_gm <command> <cwd>: 0 when the command is this gm and its arguments, and nothing a shell would treat
# specially: no second command, pipe, redirection, substitution or variable. gm is this gm only when it resolves
# here; bin/gm only in the clone's own folder.
gm_guard_plain_gm() {
  local cmd=$1 cwd=$2 prog bash='' nl=$'\n' cr=$'\r'
  case $cmd in
    '' | *[\;\&\|\<\>\`\$\(\)\{\}\\]* | *"$nl"* | *"$cr"*) return 1 ;;
  esac
  read -r prog cmd <<<"$cmd"
  if [ "$prog" = bash ]; then
    bash=1
    read -r prog cmd <<<"$cmd"
  fi
  case $prog in
    "$GM_SELF" | "$GM_ROOT/bin/gm") return 0 ;;
    gm) [ -z "$bash" ] && [ "$(gm_gm_command)" = gm ] ;;
    bin/gm | ./bin/gm) [ -n "$cwd" ] && [ "$(cd "$cwd" 2>/dev/null && pwd -P)" = "$GM_ROOT" ] ;;
    *) return 1 ;;
  esac
}

# The Guildmaster's SessionStart hook, at the patron's front desk only (gm_hook_clone): it links gm into ~/.local/bin,
# offers to install a missing herdr, runs the first-run check without questions, keeps autostart on (unless the patron
# turned it off) and runs the muster. The Guildmaster always lives in herdr, in the guild workspace's guildmaster tab:
# a session there (gm_front_desk_claim) gets its charter and a short summary, the setup, the roster, and only what
# needs the patron (a required piece missing, a held Party Leader, the collector offer at most once a day). Any other
# session, a terminal outside herdr or another tab, gets the Guildmaster started in herdr if it is not running, and is
# told to answer the patron only with where it is, so there is never a second Guildmaster.
# It prints only the hook's JSON, so nothing reaches the patron's screen.
gm_hook_front_desk() {
  local problems text gmc collector auto up line routine='' tell='' offer='' setup roster claimf here=''
  local link onpath='' herdr_offer='' how charter s pane st
  cat >/dev/null
  gmc=$(gm_gm_command)
  link=$(gm_link_ensure)
  case ":$PATH:" in *":$HOME/.local/bin:"*) onpath=1 ;; esac
  [ "$gmc" = gm ] || gmc='bin/gm'
  problems=$(gm_required_problems herdr)
  if [ -z "$problems" ] && ! command -v "$GM_HERDR" >/dev/null 2>&1; then
    if command -v "${GM_BREW:-brew}" >/dev/null 2>&1; then
      how='with Homebrew (brew install herdr)'
    else
      how="with herdr's official installer (curl -fsSL https://herdr.dev/install.sh | sh)"
    fi
    herdr_offer="gm front desk: herdr is not installed. It is the terminal workspace manager the Guildmaster and each Party Leader live in, the Guildmaster in a tab and each Party Leader in a workspace of its own, and nothing can start without it.
Offer to install it, in one line, in your first answer, for example: \"I need herdr, where the Guildmaster and the Party Leaders live. Shall I install it now $how?\"
Only on the patron's yes, run $gmc install herdr and say the line it ends with; it finishes the setup and starts the Guildmaster in herdr. On a no, say in one line that nothing can start until herdr is installed, and drop it.
Run nothing else until then."
  else
    problems=$(gm_required_problems)
  fi
  if [ -n "$problems" ]; then
    text="gm front desk: gm cannot run yet, because these required pieces are missing:
$problems
Tell the patron plainly, in a sentence or two, what to install. Once it is installed, they start claude again in this folder and the rest happens by itself. Run nothing else until then."
    gm_hook_json SessionStart "$text"
    return
  fi
  if [ -n "$herdr_offer" ]; then
    gm_hook_json SessionStart "$herdr_offer"
    return
  fi
  gm_db_ensure
  [ -n "$(gm_conf_get initialized)" ] || gm_conf_set initialized "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  gm_front_desk_files
  auto=$(gm_autostart_ensure)
  case $auto in
    installed | on) auto="on (launchd runs the muster at login and every $(gm_autostart_every) minutes)" ;;
    off) auto='off: the patron turned it off with gm autostart off; leave it off unless they ask' ;;
    unsupported) auto='not available here (launchd is macOS'"'"'s); the Guildmaster and Party Leaders come back whenever gm runs' ;;
    failed:*) tell="${tell}- autostart could not be turned on: ${auto#failed: }
"; auto='could not be turned on' ;;
  esac
  # Whether this session is the Guildmaster is decided under the herdr lock, with the muster that starts it in herdr
  # when it is not.
  claimf=$(gm_tmp)
  up=$( (gm_telemetry_refuse && gm_herdr_lock 30 && gm_front_desk_claim >"$claimf" && gm_reconcile changes) 2>&1) || true
  [ "$(cat "$claimf" 2>/dev/null)" != here ] || here=1
  rm -f "$claimf"
  case $link in
    linked) routine="- linked gm into ~/.local/bin, for later shells and the launchd agent
" ;;
  esac
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case $line in
      *': held: '* | *': could not start '* | 'gm: '*) tell="${tell}- $line
" ;;
      *) routine="${routine}- $line
" ;;
    esac
  done <<<"$up"
  if [ -z "$here" ]; then
    IFS=$'\t' read -r s _ _ pane _ _ <<<"$(gm_endpoint front-desk)"
    IFS=$'\t' read -r st _ <<<"$(gm_endpoint_state front-desk 2>/dev/null)"
    case $st in
      alive | starting)
        text="gm front desk, $(date -u +%Y-%m-%dT%H:%MZ). You are not the Guildmaster. The Guildmaster always lives in herdr, in tab $GM_FRONT_DESK of workspace $GM_HERDR_WORKSPACE (pane $pane), and this session, started $(gm_front_desk_elsewhere), does not act for the guild.
Whatever the patron says, answer only, in one line: \"The Guildmaster is in herdr tab $GM_FRONT_DESK; $(gm_front_desk_way "$s")\". Run no gm command, open no focus and change nothing." ;;
      *)
        text="gm front desk, $(date -u +%Y-%m-%dT%H:%MZ). You are not the Guildmaster. The Guildmaster always lives in herdr, in tab $GM_FRONT_DESK of workspace $GM_HERDR_WORKSPACE, but it could not be started there${st:+ (it is $st)}, and this session, started $(gm_front_desk_elsewhere), does not act for the guild.
Tell the patron so, in one line, with what gm said below, and that starting claude in this folder again tries again. Run no gm command, open no focus and change nothing." ;;
    esac
    [ -z "$tell" ] || text="$text
What gm said:
${tell%
}"
    gm_hook_json SessionStart "$text"
    return
  fi
  if [ "${GM_COLLECTOR:-}" = on ] && [ -n "$(gm_otelcol)" ]; then
    collector="on: gm keeps it running in herdr tab $GM_COLLECTOR_TAB (routine; say nothing about it unless asked)"
  elif [ "${GM_COLLECTOR:-}" = off ]; then
    collector="off: the patron chose to go without it (do not offer it; $gmc config set collector on, only if they ask)"
  elif [ -n "$(gm_otelcol)" ]; then
    collector="installed, not kept running ($gmc config set collector on keeps it running, if the patron asks)"
  else
    collector='not installed, and the patron has not decided'
    [ "${GM_COLLECTOR:-}" != on ] || collector='on, but not installed'
    local last
    last=$(gm_conf_get collector-offered)
    if [ -z "$last" ] || [ "$(sqlite3 -batch :memory: "SELECT julianday('now')-julianday($(gm_q "$last"))>=1;" 2>/dev/null)" = 1 ]; then
      gm_conf_set collector-offered "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      offer="Offer the tracing collector once, in one line, after your first answer to the patron, for example: \"Optional: I can install the OpenTelemetry Collector so tracing also shows each model call's tokens and cost (official release, checksum-checked, no sudo). Install, skip, or later?\" Record the answer with $gmc init --yes (install), $gmc init --no (skip) or $gmc init --later (later), and say the one line it ends with. Do not raise it again this session."
    fi
  fi
  setup="first-run check passed; autostart $auto; tracing collector $collector. The settings are in $GM_CONF: $gmc config shows them; when the patron asks to change one in plain words, run $gmc config set <key> <value> (never edit the file yourself) and say the line it ends with."
  case $link in
    linked | ok) [ -n "$onpath" ] || setup="$setup gm is linked at ~/.local/bin/gm, but ~/.local/bin is not on the patron's PATH (mention it only if they ask how to run gm in a terminal)." ;;
    foreign:*) setup="$setup A different gm is at ~/.local/bin/gm (${link#foreign: }), left as it is; you run this one as $gmc." ;;
    failed:*) setup="$setup gm could not be linked into ~/.local/bin (${link#failed: }); you run it as $gmc." ;;
  esac
  roster=$(gm_cmd_roster 2>&1 || true)
  charter=$(gm_front_desk_dir)/CLAUDE.md
  text="gm front desk, $(date -u +%Y-%m-%dT%H:%MZ). You are the Guildmaster, at the front desk: this Claude Code session, in herdr's $GM_FRONT_DESK tab of workspace $GM_HERDR_WORKSPACE. Run gm as: $gmc
Your charter, the patron's own copy at $charter, binds you:
<charter>
$(cat "$charter")
</charter>
Setup: $setup"
  [ -z "$routine" ] || text="$text
Done just now by gm (routine; do not mention it unless asked):
${routine%
}"
  [ -z "$tell" ] || text="$text
Tell the patron, once, one line each:
${tell%
}"
  [ -z "$offer" ] || text="$text
$offer"
  text="$text
Roster:
${roster:-(no Party Leaders yet)}"
  gm_hook_json SessionStart "$text" "" "$GM_FRONT_DESK"
}

# Whether this Claude Code session is the Guildmaster: it runs inside herdr (herdr gives every pane HERDR_ENV=1, and
# its session, workspace, tab and pane ids), in the guild's session, and in the front desk's recorded pane, or in a
# pane of the guild's workspace while no other Guildmaster is alive or unreadable; that pane then becomes the front
# desk, its tab renamed guildmaster. Prints here or elsewhere. Run under the herdr lock.
gm_front_desk_claim() {
  local s=$GM_HERDR_SESSION row rs pane st
  if [ "${HERDR_ENV:-}" != 1 ] || [ -z "${HERDR_PANE_ID:-}" ] || [ "${HERDR_SESSION:-default}" != "$s" ]; then
    printf 'elsewhere'
    return 0
  fi
  row=$(gm_endpoint front-desk)
  IFS=$'\t' read -r rs _ _ pane _ _ <<<"$row"
  if [ -n "$row" ] && [ "$rs" = "$s" ] && [ "$pane" = "$HERDR_PANE_ID" ]; then
    printf 'here'
    return 0
  fi
  if [ -n "$row" ]; then
    IFS=$'\t' read -r st _ <<<"$(gm_endpoint_state front-desk)"
    case $st in alive | starting | unknown) printf 'elsewhere'; return 0 ;; esac
  fi
  if [ -z "${HERDR_TAB_ID:-}" ] ||
    [ "$(gm_hj "$(gm_herdr "$s" workspace get "${HERDR_WORKSPACE_ID:-}")" '$.result.workspace.label')" != "$GM_HERDR_WORKSPACE" ]; then
    printf 'elsewhere'
    return 0
  fi
  gm_herdr "$s" tab rename "$HERDR_TAB_ID" "$GM_FRONT_DESK" >/dev/null
  gm_endpoint_record front-desk front-desk '' "$s" "$HERDR_WORKSPACE_ID" "$HERDR_TAB_ID" "$HERDR_PANE_ID" "$GM_FRONT_DESK"
  gm_sql "BEGIN IMMEDIATE; UPDATE endpoint SET start_attempts=0, held_at=NULL, held_told=0 WHERE key='front-desk'; COMMIT;"
  printf 'here'
}

# Where a session that is not the Guildmaster was started, for its one line.
gm_front_desk_elsewhere() {
  if [ "${HERDR_ENV:-}" != 1 ]; then
    printf 'outside herdr'
  elif [ "${HERDR_SESSION:-default}" != "$GM_HERDR_SESSION" ]; then
    printf "in another herdr session (%s)" "${HERDR_SESSION:-default}"
  else
    printf 'in another herdr tab'
  fi
}

# How the patron gets to the Guildmaster's tab from where they are: gm_front_desk_way <herdr session>.
gm_front_desk_way() {
  local s=${1:-$GM_HERDR_SESSION}
  if [ "${HERDR_ENV:-}" = 1 ] && [ "${HERDR_SESSION:-default}" = "$s" ]; then
    printf 'switch to it in herdr'
  elif [ "$s" = default ]; then
    printf 'open it with: herdr'
  else
    printf 'open it with: herdr --session %s' "$s"
  fi
}

gm_new_posting_sql() {
  # $1 focus name, $2 slug base, $3 SQL expression for the words, $4 actor, $5 session, $6 message id SQL or NULL
  local f
  f=$(gm_q "$1")
  cat <<SQL
INSERT INTO posting(focus_id, num, slug, words, state, message_id, created_at, updated_at, trace_id, span_id, span_start_ms)
  SELECT f.id, n.n,
         CASE WHEN EXISTS (SELECT 1 FROM posting WHERE focus_id=f.id AND slug=$(gm_q "$2")) THEN $(gm_q "$2")||'-'||n.n ELSE $(gm_q "$2") END,
         $3, 'received', $6, $GM_NOW, $GM_NOW, lower(hex(randomblob(16))), lower(hex(randomblob(8))), $GM_NOW_MS
  FROM focus f, (SELECT COALESCE(MAX(p.num),0)+1 AS n FROM posting p JOIN focus g ON g.id=p.focus_id WHERE g.name=$f) n
  WHERE f.name=$f;
INSERT INTO v VALUES ('posting', last_insert_rowid());
INSERT INTO event(at, actor, kind, focus_id, posting_id, session_id, verb, line)
  SELECT $GM_NOW, $(gm_q "$4"), 'notice', p.focus_id, p.id, $(gm_qn "$5"), 'received',
         f.name||'#'||p.num||' '||p.slug||' received ("'||$(gm_summary_sql p.words)||'")'
  FROM posting p JOIN focus f ON f.id=p.focus_id WHERE p.id=(SELECT id FROM v WHERE k='posting');
SQL
}

gm_cmd_post() {
  local slug='' from='' words='' focus follows='' t0
  t0=$(gm_now_ms)
  while [ $# -gt 0 ]; do
    case $1 in
      --slug) slug=${2:?--slug needs a value}; shift 2 ;;
      --from) from=${2:?--from needs a reference}; shift 2 ;;
      --follows) follows=${2:?--follows needs a reference}; shift 2 ;;
      -) words=$(cat); shift ;;
      -*) gm_die "post: unknown option $1" ;;
      *) words=${words:+$words }$1; shift ;;
    esac
  done
  [ -n "$words" ] || gm_die "post: give the posting's words"
  gm_db_ensure
  focus=$(gm_require_focus)
  if [ -n "$slug" ]; then
    gm_valid_slug "$slug" || gm_die "post: a slug is up to 40 lowercase letters, digits and dashes"
  else
    slug=$(gm_slugify "$words")
  fi
  local from_sql='' from_id='' msg_sql=NULL
  if [ -n "$from" ]; then
    from_id=$(gm_resolve_posting "$from")
    msg_sql="(SELECT message_id FROM posting WHERE id=$from_id)"
    from_sql="INSERT INTO event(at, actor, kind, focus_id, posting_id, detail, line)
      SELECT $GM_NOW, 'party-leader', 'posting.split', p.focus_id, p.id, 'from posting '||$from_id,
             f.name||'#'||p.num||' '||p.slug||' split from '||(SELECT g.name||'#'||o.num FROM posting o JOIN focus g ON g.id=o.focus_id WHERE o.id=$from_id)
      FROM posting p JOIN focus f ON f.id=p.focus_id WHERE p.id=(SELECT id FROM v WHERE k='posting');"
  fi
  local follows_sql='' fid out pid
  if [ -n "$follows" ]; then
    fid=$(gm_resolve_posting "$follows")
    follows_sql=$(gm_follows_sql "(SELECT id FROM v WHERE k='posting')" "$fid")
  fi
  out=$(gm_sql <<SQL
CREATE TEMP TABLE v(k TEXT PRIMARY KEY, id INTEGER);
BEGIN IMMEDIATE;
$(gm_new_posting_sql "$focus" "$slug" "$(gm_q "$words")" party-leader "" "$msg_sql")
$from_sql
$follows_sql
SELECT id FROM v WHERE k='posting';
SELECT line FROM event WHERE posting_id=(SELECT id FROM v WHERE k='posting') AND verb='received';
COMMIT;
SQL
) || exit 1
  pid=${out%%$'\n'*}
  printf '%s\n' "${out#*$'\n'}"
  (gm_trace_notice "$pid" received '' received '' "$t0" post) >/dev/null 2>&1 || gm_span_dropped "guild.notice received"
}

# SQL making posting $1 (an SQL expression) follow posting id $2, with its ledger line.
gm_follows_sql() {
  cat <<SQL
UPDATE posting SET follows_id=$2 WHERE id=$1;
INSERT INTO event(at, actor, kind, focus_id, posting_id, detail, line)
  SELECT $GM_NOW, 'party-leader', 'posting.follows', p.focus_id, p.id, 'follows posting '||$2,
         f.name||'#'||p.num||' '||p.slug||' follows '||(SELECT g.name||'#'||o.num||' '||o.slug FROM posting o JOIN focus g ON g.id=o.focus_id WHERE o.id=$2)
  FROM posting p JOIN focus f ON f.id=p.focus_id WHERE p.id=$1;
SQL
}

# Refuses a follow-up link that would point a posting at itself or close a loop.
gm_follows_check() {
  local pid=$1 fid=$2 loop
  [ "$pid" != "$fid" ] || gm_die "notice: a posting cannot follow itself"
  loop=$(gm_sql "WITH RECURSIVE up(id) AS (SELECT $fid UNION SELECT p.follows_id FROM posting p JOIN up ON p.id=up.id WHERE p.follows_id IS NOT NULL) SELECT count(*) FROM up WHERE id=$pid;")
  [ "$loop" = 0 ] || gm_die "notice: that posting already follows this one; a topic cannot loop"
}

gm_verb_state() {
  case $1 in
    queued) printf queued ;;
    started | resumed) printf active ;;
    needs-you) printf needs-you ;;
    done) printf 'done' ;;
    failed) printf failed ;;
    closed) printf closed ;;
    parked) printf parked ;;
    update) printf '' ;;
    *) return 1 ;;
  esac
}

gm_record_notice() {
  # $1 posting id, $2 verb, $3 detail, $4 new state or '', $5 slug or '', $6 park why, $7 park until, $8 actor, $9 extra SQL
  local pid=$1 verb=$2 detail=$3 state=$4 slug=$5 why=$6 until=$7 actor=$8 extra=${9:-} t0 before
  t0=$(gm_now_ms)
  before=$(gm_sql "SELECT state FROM posting WHERE id=$pid;")
  local state_sql slug_sql park_sql shown
  shown=$verb
  [ "$verb" = needs-you ] && shown='needs you'
  if [ -n "$state" ]; then state_sql="state=$(gm_q "$state"),"; else state_sql=''; fi
  if [ -n "$slug" ]; then slug_sql="slug=$(gm_q "$slug"),"; else slug_sql=''; fi
  if [ "$state" = parked ]; then
    park_sql="park_why=$(gm_q "$why"), park_until=$(gm_qn "$until"),"
  elif [ -n "$state" ]; then
    park_sql="park_why=NULL, park_until=NULL,"
  else
    park_sql=''
  fi
  local tail
  tail="CASE WHEN $(gm_q "$detail")<>'' THEN ': '||$(gm_q "$detail") ELSE '' END"
  if [ "$state" = parked ] && [ -n "$until" ]; then
    tail="$tail||' (until '||$(gm_q "$until")||')'"
  fi
  gm_sql <<SQL
BEGIN IMMEDIATE;
UPDATE posting SET $state_sql $slug_sql $park_sql updated_at=$GM_NOW WHERE id=$pid;
UPDATE message SET sorted_at=$GM_NOW WHERE posting_id=$pid AND sorted_at IS NULL;
$extra
INSERT INTO event(at, actor, kind, focus_id, posting_id, session_id, verb, detail, line)
  SELECT $GM_NOW, $(gm_q "$actor"), 'notice', p.focus_id, p.id, NULL, $(gm_q "$verb"), $(gm_qn "$detail"),
         f.name||'#'||p.num||' '||p.slug||' '||$(gm_q "$shown")||$tail||' ("'||$(gm_summary_sql p.words)||'")'
  FROM posting p JOIN focus f ON f.id=p.focus_id WHERE p.id=$pid;
SELECT line FROM event WHERE id=last_insert_rowid();
COMMIT;
SQL
  local word=notice
  [ "$verb" != parked ] || word=park
  (gm_trace_notice "$pid" "$verb" "$before" "$state" "$detail" "$t0" "$word") >/dev/null 2>&1 || gm_span_dropped "guild.notice $verb"
}

gm_cmd_notice() {
  local ref='' verb='' detail='' slug='' state pid cur follows='' extra=''
  while [ $# -gt 0 ]; do
    case $1 in
      --slug) slug=${2:?--slug needs a value}; shift 2 ;;
      --follows) follows=${2:?--follows needs a reference}; shift 2 ;;
      *)
        if [ -z "$ref" ]; then ref=$1
        elif [ -z "$verb" ]; then verb=$1
        else detail=${detail:+$detail }$1
        fi
        shift ;;
    esac
  done
  [ -n "$ref" ] && [ -n "$verb" ] || gm_die "notice: gm notice <ref> <verb> [detail]"
  verb=$(printf '%s' "$verb" | tr '[:upper:]_' '[:lower:]-')
  [ "$verb" = needs ] && verb=needs-you
  [ "$verb" != parked ] || gm_die "notice: use gm park <ref> --why ... to park a posting"
  state=$(gm_verb_state "$verb") || gm_die "notice: unknown verb '$verb' (queued started resumed needs-you done failed closed update)"
  if [ "$verb" = needs-you ] || [ "$verb" = failed ]; then
    [ -n "$detail" ] || gm_die "notice: '$verb' needs a detail saying what the patron must decide or what failed"
  fi
  pid=$(gm_resolve_posting "$ref")
  if [ -n "$slug" ]; then
    gm_valid_slug "$slug" || gm_die "notice: a slug is up to 40 lowercase letters, digits and dashes"
    cur=$(gm_sql "SELECT state FROM posting WHERE id=$pid;")
    [ "$cur" = received ] || gm_die "notice: a posting's slug can only be set while it is received"
  fi
  if [ -n "$follows" ]; then
    local fid
    fid=$(gm_resolve_posting "$follows")
    gm_follows_check "$pid" "$fid"
    extra=$(gm_follows_sql "$pid" "$fid")
  fi
  gm_record_notice "$pid" "$verb" "$detail" "$state" "$slug" "" "" party-leader "$extra"
}

gm_cmd_park() {
  local ref='' why='' until=''
  while [ $# -gt 0 ]; do
    case $1 in
      --why) why=${2:?--why needs a reason}; shift 2 ;;
      --until) until=${2:?--until needs a time or event}; shift 2 ;;
      -*) gm_die "park: unknown option $1" ;;
      *) [ -z "$ref" ] || gm_die "park: one posting at a time"; ref=$1; shift ;;
    esac
  done
  [ -n "$ref" ] || gm_die "park: gm park <ref> --why TEXT [--until TIME-OR-EVENT]"
  [ -n "$why" ] || gm_die "park: a parked posting needs --why"
  local pid
  pid=$(gm_resolve_posting "$ref")
  gm_record_notice "$pid" parked "$why" parked "" "$why" "$until" party-leader
}

gm_set_phase() {
  local focus=$1 phase=$2 actor=$3 kind playbook pos t0
  t0=$(gm_now_ms)
  kind=$(gm_focus_field "$focus" kind)
  playbook=$(gm_playbook_path "$kind")
  if [ -n "$(gm_phases "$playbook")" ] && ! gm_phases "$playbook" | grep -qx "$phase"; then
    gm_die "phase: '$phase' is not a phase of $playbook (phases: $(gm_phases "$playbook" | tr '\n' ' '))"
  fi
  pos=$(gm_phase_position "$phase" "$playbook")
  gm_sql <<SQL
BEGIN IMMEDIATE;
UPDATE focus SET phase=$(gm_q "$phase") WHERE name=$(gm_q "$focus");
INSERT INTO event(at, actor, kind, focus_id, verb, detail, line)
  SELECT $GM_NOW, $(gm_q "$actor"), 'phase', id, 'phase', $(gm_q "$phase"), name||' phase: '||$(gm_q "$phase")||$(gm_q "${pos:+ ($pos)}") FROM focus WHERE name=$(gm_q "$focus");
SELECT line FROM event WHERE id=last_insert_rowid();
COMMIT;
SQL
  (gm_trace_phase "$focus" "$phase" "$t0") >/dev/null 2>&1 || gm_span_dropped "guild.notice phase"
}

gm_cmd_phase() {
  local focus='' phase=''
  gm_db_ensure
  case $# in
    0) focus=$(gm_require_focus) ;;
    1)
      if [ -n "$(gm_context_focus)" ]; then
        focus=$(gm_require_focus)
        phase=$1
      else
        focus=$(gm_require_focus "$1")
      fi ;;
    2) focus=$(gm_require_focus "$1"); phase=$2 ;;
    *) gm_die "phase: gm phase [focus] [phase]" ;;
  esac
  if [ -z "$phase" ]; then
    local cur playbook pos=''
    cur=$(gm_focus_field "$focus" phase)
    playbook=$(gm_playbook_path "$(gm_focus_field "$focus" kind)")
    [ -z "$cur" ] || pos=$(gm_phase_position "$cur" "$playbook")
    printf '%s phase: %s%s\n' "$focus" "${cur:-unset}" "${pos:+ ($pos)}"
    printf 'phases: %s\n' "$(gm_phases "$playbook" | tr '\n' ' ' | sed 's/ $//')"
    return
  fi
  gm_set_phase "$focus" "$phase" party-leader
}

gm_cmd_resolve() {
  [ $# -eq 1 ] || gm_die "resolve: gm resolve <ref>"
  local out
  out=$(gm_resolve "$1") || exit 1
  printf '%s\n' "$out" | cut -f3
}

gm_cmd_list() {
  local all=0 state='' focus='' where
  while [ $# -gt 0 ]; do
    case $1 in
      --all) all=1; shift ;;
      --state) state=${2:?--state needs a state}; shift 2 ;;
      -*) gm_die "list: unknown option $1" ;;
      *) focus=$1; shift ;;
    esac
  done
  gm_db_ensure
  [ -n "$focus" ] || focus=$(gm_context_focus)
  [ -z "$focus" ] || focus=$(gm_require_focus "$focus")
  where="1"
  [ -z "$focus" ] || where="f.name=$(gm_q "$focus")"
  if [ -n "$state" ]; then
    where="$where AND p.state=$(gm_q "$state")"
  elif [ "$all" = 0 ]; then
    where="$where AND p.state NOT IN ('done','closed')"
  fi
  gm_sql <<SQL
SELECT printf('%-36s %-10s %s  "%s"%s',
              f.name||'#'||p.num||' '||p.slug, p.state, substr(p.updated_at,1,16),
              $(gm_summary_sql p.words),
              CASE WHEN p.state='parked' THEN '  why: '||p.park_why||COALESCE(', until '||p.park_until,'') ELSE '' END)
FROM posting p JOIN focus f ON f.id=p.focus_id
WHERE $where
ORDER BY f.name, CASE p.state WHEN 'active' THEN 0 WHEN 'needs-you' THEN 1 WHEN 'received' THEN 2 WHEN 'queued' THEN 3 WHEN 'parked' THEN 4 ELSE 5 END, p.num;
SQL
}

gm_cmd_show() {
  [ $# -eq 1 ] || gm_die "show: gm show <ref>"
  local kind id canon out
  out=$(gm_resolve "$1") || exit 1
  IFS=$'\t' read -r kind id canon <<<"$out"
  if [ "$kind" = focus ]; then
    gm_where "$canon"
    return
  fi
  gm_sql <<SQL
SELECT f.name||'#'||p.num||' '||p.slug||'  ['||p.state||']'
       ||CASE WHEN p.state='parked' THEN char(10)||'parked: '||p.park_why||COALESCE(' (until '||p.park_until||')','') ELSE '' END
       ||char(10)||'focus '||f.name||' · branch '||f.branch||' · phase '||COALESCE(f.phase,'unset')
       ||char(10)||char(10)||'The patron''s words, '||p.created_at||':'||char(10)||p.words
FROM posting p JOIN focus f ON f.id=p.focus_id WHERE p.id=$id;
SELECT char(10)||'Addition, '||m.at||':'||char(10)||m.words
FROM message m WHERE m.posting_id=$id AND m.disposition='addition' ORDER BY m.id;
SELECT char(10)||'History:';
SELECT '  '||e.at||'  '||COALESCE(e.line, e.kind) FROM event e WHERE e.posting_id=$id ORDER BY e.id;
SQL
}

gm_where() {
  local focus=$1 fid kind camp playbook rules repo pos phase
  fid=$(gm_focus_id "$focus")
  kind=$(gm_focus_field "$focus" kind)
  camp=$(gm_focus_field "$focus" camp)
  repo=$(gm_focus_field "$focus" repo)
  phase=$(gm_focus_field "$focus" phase)
  playbook=$(gm_playbook_path "$kind")
  rules=$(gm_rules_path "$repo")
  pos=''
  [ -z "$phase" ] || pos=$(gm_phase_position "$phase" "$playbook")
  gm_sql <<SQL
SELECT 'Resume summary for focus '||f.name||' ('||f.kind||COALESCE('; tickets '||(SELECT group_concat(key, ', ') FROM ticket WHERE focus_id=f.id),'')||'), built by gm from the register at '||$GM_NOW||'.'
  ||char(10)||'This session is the Party Leader of '||f.name||'. Camp: '||f.camp||' on branch '||f.branch||' (repository '||f.repo||').'
  ||char(10)||'Phase: '||COALESCE(f.phase,'unset')||$(gm_q "${pos:+ ($pos of the playbook)}")||'.'
  ||char(10)||'Files: charter '||$(gm_q "$(gm_charter_path)")||', playbook '||$(gm_q "$playbook")||', rules '||$(gm_q "$rules")||'.'
  ||char(10)||'The gm command here is: '||$(gm_q "$(gm_gm_command)")
FROM focus f WHERE f.id=$fid;
SELECT 'Postings: '||count(*)||' in all'||COALESCE(' — '||(
  SELECT group_concat(n||' '||state, ', ') FROM (SELECT state, count(*) n FROM posting WHERE focus_id=$fid GROUP BY state
    ORDER BY CASE state WHEN 'active' THEN 0 WHEN 'needs-you' THEN 1 WHEN 'received' THEN 2 WHEN 'queued' THEN 3 WHEN 'parked' THEN 4 WHEN 'failed' THEN 5 WHEN 'done' THEN 6 ELSE 7 END)),'')||'.'
FROM posting WHERE focus_id=$fid;
SELECT char(10)||'Active (claimed, in progress):' WHERE EXISTS (SELECT 1 FROM posting WHERE focus_id=$fid AND state='active');
SELECT '- #'||num||' '||slug||', the patron''s words ('||created_at||'): "'||substr(words,1,800)||CASE WHEN length(words)>800 THEN '…' ELSE '' END||'"'
  ||COALESCE((SELECT group_concat(char(10)||'  the patron''s addition ('||at||'): "'||substr(words,1,400)||CASE WHEN length(words)>400 THEN '…' ELSE '' END||'"', '')
               FROM (SELECT at, words FROM message WHERE posting_id=p.id AND disposition='addition' ORDER BY id)),'')
  ||COALESCE(char(10)||'  last notice: '||(SELECT line FROM event WHERE posting_id=p.id AND kind='notice' ORDER BY id DESC LIMIT 1),'')
FROM posting p WHERE focus_id=$fid AND state='active' ORDER BY num;
SELECT char(10)||'Needs the patron:' WHERE EXISTS (SELECT 1 FROM posting WHERE focus_id=$fid AND state='needs-you');
SELECT '- #'||num||' '||slug||': '||COALESCE((SELECT detail FROM event WHERE posting_id=p.id AND verb='needs-you' ORDER BY id DESC LIMIT 1),'')
  ||char(10)||'  the patron''s words ('||created_at||'): "'||substr(words,1,500)||CASE WHEN length(words)>500 THEN '…' ELSE '' END||'"'
  ||COALESCE((SELECT group_concat(char(10)||'  the patron''s addition ('||at||'): "'||substr(words,1,400)||CASE WHEN length(words)>400 THEN '…' ELSE '' END||'"', '')
               FROM (SELECT at, words FROM message WHERE posting_id=p.id AND disposition='addition' ORDER BY id)),'')
FROM posting p WHERE focus_id=$fid AND state='needs-you' ORDER BY num;
SELECT char(10)||'Received, not yet sorted (each needs a recorded state):' WHERE EXISTS (SELECT 1 FROM posting WHERE focus_id=$fid AND state='received');
SELECT '- #'||num||' '||slug||' ('||created_at||'): "'||substr(words,1,500)||CASE WHEN length(words)>500 THEN '…' ELSE '' END||'"'
FROM posting p WHERE focus_id=$fid AND state='received' ORDER BY num LIMIT 15;
SELECT char(10)||'Additions not yet acknowledged:' WHERE EXISTS (SELECT 1 FROM message WHERE focus_id=$fid AND disposition='addition' AND sorted_at IS NULL);
SELECT '- to #'||p.num||' '||p.slug||' ('||m.at||'): "'||substr(m.words,1,400)||CASE WHEN length(m.words)>400 THEN '…' ELSE '' END||'"'
FROM message m JOIN posting p ON p.id=m.posting_id WHERE m.focus_id=$fid AND m.disposition='addition' AND m.sorted_at IS NULL ORDER BY m.id LIMIT 10;
SELECT char(10)||'Queued, in order:' WHERE EXISTS (SELECT 1 FROM posting WHERE focus_id=$fid AND state='queued');
SELECT '- #'||num||' '||slug||': "'||$(gm_summary_sql words)||'"'
  ||COALESCE(' (+'||NULLIF((SELECT count(*) FROM message WHERE posting_id=p.id AND disposition='addition'),0)||' addition, gm show '||num||')','')
FROM posting p WHERE focus_id=$fid AND state='queued' ORDER BY num LIMIT 20;
SELECT '  … and '||(count(*)-20)||' more (gm list)' FROM posting WHERE focus_id=$fid AND state='queued' HAVING count(*)>20;
SELECT char(10)||'Parked:' WHERE EXISTS (SELECT 1 FROM posting WHERE focus_id=$fid AND state='parked');
SELECT '- #'||num||' '||slug||': '||park_why||COALESCE(' (until '||park_until||')','')
  ||CASE WHEN park_until GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*' AND park_until<=$GM_NOW THEN ' — its time has come' ELSE '' END
FROM posting WHERE focus_id=$fid AND state='parked' ORDER BY num LIMIT 15;
SELECT char(10)||'Failed:' WHERE EXISTS (SELECT 1 FROM posting WHERE focus_id=$fid AND state='failed');
SELECT '- #'||num||' '||slug||': '||COALESCE((SELECT detail FROM event WHERE posting_id=p.id AND verb='failed' ORDER BY id DESC LIMIT 1),'')
FROM posting p WHERE focus_id=$fid AND state='failed' ORDER BY num LIMIT 10;
SELECT char(10)||'Last notices:' WHERE EXISTS (SELECT 1 FROM event WHERE focus_id=$fid AND line IS NOT NULL);
SELECT '- '||substr(at,12,5)||' '||line FROM (SELECT at, line, id FROM event WHERE focus_id=$fid AND line IS NOT NULL ORDER BY id DESC LIMIT 8) ORDER BY id;
SELECT char(10)||'Last patron messages, verbatim:' WHERE EXISTS (SELECT 1 FROM message WHERE focus_id=$fid);
SELECT '- '||at||COALESCE(' → #'||(SELECT num FROM posting WHERE id=m.posting_id),'')||': "'||substr(words,1,300)||CASE WHEN length(words)>300 THEN '…' ELSE '' END||'"'
FROM (SELECT * FROM message WHERE focus_id=$fid ORDER BY id DESC LIMIT 5) m ORDER BY id;
SELECT char(10)||'Next on the board: '||CASE
  WHEN EXISTS (SELECT 1 FROM posting WHERE focus_id=$fid AND state='received') THEN 'the received postings need a state; then '
  ELSE '' END
  ||COALESCE((SELECT '#'||num||' '||slug||' is active and unfinished.' FROM posting WHERE focus_id=$fid AND state='active' ORDER BY num LIMIT 1),
             (SELECT '#'||num||' '||slug||' is first in the queue.' FROM posting WHERE focus_id=$fid AND state='queued' ORDER BY num LIMIT 1),
             'nothing is queued.');
SQL
  if [ -d "$camp" ]; then
    printf '\nCamp git state (from git, now):\n'
    git -C "$camp" log -1 --format='HEAD %h %s' 2>/dev/null || true
    git -C "$camp" status --short --branch 2>/dev/null | head -n 20 || true
  else
    printf '\nThe camp %s is missing; gm open %s makes it again.\n' "$camp" "$focus"
  fi
}

gm_cmd_where() {
  local focus
  gm_db_ensure
  focus=$(gm_require_focus "${1:-}")
  gm_where "$focus"
}

gm_cmd_statusline() {
  local input focus fid kind playbook phase pos ctx='' model='' cwd=''
  input=$(cat || true)
  [ -n "$input" ] || input='{}'
  [ -s "$GM_DB" ] || { printf 'gm · no register yet\n'; return 0; }
  local us sid pid mid effort cost
  us=$(printf '\037')
  IFS=$us read -r ctx model cwd sid pid mid effort cost <<<"$(sqlite3 -batch -separator "$us" :memory: "SELECT CAST(round(json_extract(j,'\$.context_window.used_percentage')) AS INTEGER), json_extract(j,'\$.model.display_name'), json_extract(j,'\$.workspace.current_dir'), json_extract(j,'\$.session_id'), json_extract(j,'\$.prompt_id'), json_extract(j,'\$.model.id'), json_extract(j,'\$.effort.level'), json_extract(j,'\$.cost.total_cost_usd') FROM (SELECT $(gm_q "$input") AS j);" 2>/dev/null || true)"
  # Model, effort and running cost per prompt_id, recorded only when one of them changes (tracing-design.md).
  if [ -n "$sid" ] && { [ -n "$mid" ] || [ -n "$effort" ] || [ -n "$cost" ]; }; then
    local num='^[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$' c=NULL
    [[ $cost =~ $num ]] && c=$cost
    sqlite3 -batch -cmd '.timeout 1000' "$GM_DB" "INSERT INTO model_sample(at_ms, session_id, prompt_id, model, effort, cost_usd)
      SELECT $GM_NOW_MS, $(gm_q "$sid"), $(gm_qn "$pid"), $(gm_qn "$mid"), $(gm_qn "$effort"), $c
      WHERE NOT EXISTS (SELECT 1 FROM (SELECT prompt_id, model, effort, cost_usd FROM model_sample WHERE session_id=$(gm_q "$sid") ORDER BY id DESC LIMIT 1) l
                        WHERE l.prompt_id IS $(gm_qn "$pid") AND l.model IS $(gm_qn "$mid") AND l.effort IS $(gm_qn "$effort") AND l.cost_usd IS $c);" >/dev/null 2>&1 || true
  fi
  focus=${GM_FOCUS:-}
  if [ -z "$focus" ] && [ -n "$cwd" ]; then
    focus=$(cd "$cwd" 2>/dev/null && gm_context_focus || true)
  fi
  if [ -z "$focus" ] || [ -z "$(gm_focus_id "$focus")" ]; then
    printf 'gm · no focus here\n'
    return 0
  fi
  fid=$(gm_focus_id "$focus")
  kind=$(gm_focus_field "$focus" kind)
  phase=$(gm_focus_field "$focus" phase)
  playbook=$(gm_playbook_path "$kind")
  pos=''
  [ -z "$phase" ] || pos=$(gm_phase_position "$phase" "$playbook")
  gm_sql <<SQL
SELECT '▸ '||f.name||' · '||f.kind||COALESCE(' · '||(SELECT group_concat(key, ',') FROM ticket WHERE focus_id=f.id),'')
  ||' · phase '||$(gm_q "${pos:+$pos }")||COALESCE(f.phase,'unset')||' · '||f.branch
FROM focus f WHERE f.id=$fid;
SELECT 'postings '||COALESCE((
  SELECT group_concat(n||' '||CASE state WHEN 'needs-you' THEN 'need you' ELSE state END, ' · ') FROM (
    SELECT state, count(*) n FROM posting WHERE focus_id=$fid AND state NOT IN ('done','closed') GROUP BY state
    ORDER BY CASE state WHEN 'active' THEN 0 WHEN 'needs-you' THEN 1 WHEN 'received' THEN 2 WHEN 'queued' THEN 3 WHEN 'parked' THEN 4 ELSE 5 END)),'none open')
  ||' · '||(SELECT count(*) FROM posting WHERE focus_id=$fid AND state IN ('done','closed'))||' done'
  ||COALESCE(' · next #'||(SELECT num||' '||slug FROM posting WHERE focus_id=$fid AND state='queued' ORDER BY num LIMIT 1),'');
SELECT 'guild '||(SELECT count(*) FROM focus)||' focus'||CASE WHEN (SELECT count(*) FROM focus)=1 THEN '' ELSE 'es' END
  ||COALESCE(' · need you elsewhere: '||(SELECT group_concat(name||' '||n, ', ') FROM (
      SELECT f.name, count(*) n FROM posting p JOIN focus f ON f.id=p.focus_id WHERE f.id<>$fid AND p.state='needs-you' GROUP BY f.name)),'')
  ||$(gm_q "${ctx:+ · ctx $ctx%}${model:+ · $model}");
SQL
}

# ---- Tracing: build slice 1 of vision/tracing-design.md ----
# A posting is a trace. Spans are rows in the register, each written once, complete, when it ends;
# a hook-bracketed span waits in open_span until its closing hook writes it.
# Tracing never stops work: every span write is its own transaction after the work it describes,
# and a write that fails is dropped and counted in spans-dropped.log.

# The time now in epoch milliseconds, for SQL. Bash 5 reads its own clock; older bash (macOS's 3.2)
# gets an SQL expression instead, which takes the time when the span is written, a moment later.
gm_now_ms() {
  if [ -n "${EPOCHREALTIME:-}" ]; then
    local t=${EPOCHREALTIME//[!0-9]/}
    printf '%s' "${t%???}"
  else
    printf '(%s)' "$GM_NOW_MS"
  fi
}

gm_sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1"
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1"
  else
    openssl dgst -sha256 -r "$1"
  fi 2>/dev/null | sed -n '1s/^\([0-9a-f]\{64\}\).*/\1/p'
}

gm_commit() {
  [ -n "$1" ] && [ -d "$1" ] && git -C "$1" rev-parse HEAD 2>/dev/null || true
}

# SQL reading one attribute: attribute names are flat dotted keys, as OpenTelemetry writes them.
gm_a() { printf "json_extract(%s,'\$.\"%s\"')" "${2:-attrs}" "$1"; }

# SQL for a JSON object of attributes from key / SQL-expression pairs; NULL values are left out.
gm_jobj() {
  local out='' sep=''
  while [ $# -ge 2 ]; do
    out="$out$sep$(gm_q "$1"),$2"
    sep=','
    shift 2
  done
  printf "json_patch('{}',json_object(%s))" "$out"
}

# SQL appending one span event (a JSON object) to the events array of an attrs expression.
gm_event_sql() {
  printf "json_insert(json_set(%s,'\$.events',json(COALESCE(json_extract(%s,'\$.events'),'[]'))),'\$.events[#]',json(%s))" "$1" "$1" "$2"
}

gm_dur_sql() {
  local d="($1)"
  printf "CASE WHEN %s IS NULL THEN '?' WHEN %s<10000 THEN printf('%%.1fs',%s/1000.0) WHEN %s<60000 THEN printf('%%ds',%s/1000) WHEN %s<3600000 THEN printf('%%dm%%02ds',%s/60000,(%s/1000)%%60) ELSE printf('%%dh%%02dm',%s/3600000,(%s/60000)%%60) END" \
    "$d" "$d" "$d" "$d" "$d" "$d" "$d" "$d" "$d" "$d"
}

gm_span_dropped() {
  { printf '%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >>"$GM_HALL/spans-dropped.log"; } 2>/dev/null || true
}

# Runs span SQL in one transaction of its own; never fails, and counts what it could not write.
gm_trace() {
  [ -s "$GM_DB" ] || return 0
  if ! sqlite3 -bail -batch -noheader -cmd '.timeout 5000' "$GM_DB" >/dev/null 2>&1 <<SQL
BEGIN IMMEDIATE;
$2
COMMIT;
SQL
  then
    gm_span_dropped "$1"
  fi
  return 0
}

# Prints the focus's camp, then each JSON path of a hook payload, on one line separated by \037.
# The payload is a file, or with gm_payload_json the JSON text itself.
gm_payload() {
  local f=$1
  shift
  gm_payload_from "CAST(readfile($(gm_q "$f")) AS TEXT)" "$@"
}

gm_payload_json() {
  local j=$1
  shift
  gm_payload_from "$(gm_q "$j")" "$@"
}

gm_payload_from() {
  local src=$1 sel p
  shift
  sel="(SELECT camp FROM focus WHERE name=$(gm_q "${GM_FOCUS:-}"))"
  for p in "$@"; do
    sel="$sel, $(gm_payload_field "$p")"
  done
  # A register that cannot be read still leaves the payload readable, so its span is counted as dropped.
  sqlite3 -batch -noheader -separator "$(printf '\037')" -cmd '.timeout 5000' "$GM_DB" "SELECT $sel FROM (SELECT $src AS j);" 2>/dev/null ||
    sqlite3 -batch -noheader -separator "$(printf '\037')" :memory: "SELECT ''${sel#"(SELECT camp FROM focus WHERE name=$(gm_q "${GM_FOCUS:-}"))"} FROM (SELECT $src AS j);" 2>/dev/null || true
}

# One payload field on one line. A path starting with % keeps its text whole, escaped with
# backslashes for printf %b (the sqlite3 shell prints other control characters as ^X).
gm_payload_field() {
  local path=${1#%} x
  x="COALESCE(json_extract(j,$(gm_q "\$.${1#%}")),'')"
  if [ "$path" != "$1" ]; then
    printf '%s' "replace(replace(replace(replace($x,'\','\\\\'),char(10),'\n'),char(9),'\t'),char(13),'\r')"
  else
    printf '%s' "replace(replace(replace($x,char(10),' '),char(9),' '),char(13),' ')"
  fi
}

# Masks secrets in text on stdin before it is stored (tracing-design.md, Retention and redaction).
# Best effort: tests/redaction-cases.tsv holds the known cases it must catch.
# With "json", stdin is texts each ended by \036, and it prints them masked as a JSON array of strings.
gm_redact() {
  LC_ALL=C awk -v mode="${1:-}" '
function rep(c, n,   s) { s = ""; while (n-- > 0) s = s c; return s }
function red(re, pre, kind, keep,   out, rest, s0, l0, m, p, t) {
  out = ""
  rest = buf
  while (match(tolower(rest), re)) {
    s0 = RSTART
    l0 = RLENGTH
    if (l0 < 1) break
    m = substr(rest, s0, l0)
    p = ""
    if (pre != "" && match(tolower(m), "^(" pre ")")) p = substr(m, 1, RLENGTH)
    t = (keep != "" && substr(m, l0) == keep) ? keep : ""
    out = out substr(rest, 1, s0 - 1) p "\001" kind "\002" t
    rest = substr(rest, s0 + l0)
  }
  buf = out rest
}
function jstr(s,   i) {
  gsub(/\\/, "\\\\", s)
  gsub(/"/, "\\\"", s)
  gsub(/\n/, "\\n", s)
  gsub(/\r/, "\\r", s)
  gsub(/\t/, "\\t", s)
  for (i = 1; i < 32; i++) gsub(sprintf("%c", i), sprintf("\\u%04x", i), s)
  return "\"" s "\""
}
{ all = (NR == 1) ? $0 : all "\n" $0 }
END {
  if (mode != "json") { printf "%s", redact(all); exit }
  n = split(all, parts, /\036/)
  printf "["
  for (i = 1; i < n; i++) printf "%s%s", (i > 1 ? "," : ""), jstr(redact(parts[i]))
  printf "]"
}
function redact(text) {
  buf = text
  q = "\047"
  buf = " " buf
  v = "[^[:space:]\"" q "&;|`)<>\001\002]"
  v1 = "[^-[:space:]\"" q "&;|`)<>\001\002]"
  b = "[^a-z0-9_]"
  red("-----begin [a-z ]*private key-----([^-]|-[^-])*(-----end [a-z ]*private key-----)?", "", "private-key", "")
  red("(proxy-)?authorization[[:space:]]*:[[:space:]]*[^\n\"" q "\001\002]+", "(proxy-)?authorization[[:space:]]*:[[:space:]]*", "authorization", "")
  red("bearer[[:space:]]+" v "+", "bearer[[:space:]]+", "bearer", "")
  red("[a-z][a-z0-9+.-]*://[^/[:space:]:@\"" q "]+:[^/[:space:]@\"" q "\001\002]+@", "[a-z][a-z0-9+.-]*://[^/[:space:]:@\"" q "]+:", "url-password", "@")
  f = "[[:space:]]--?[a-z0-9_-]*(token|password|passwd|secret|api[-_]?key)[a-z0-9_-]*(=|[[:space:]]+)[\"" q "]?"
  red(f v1 v "*", f, "argument", "")
  a = "[^a-z0-9_-][a-z0-9_]*(token|secret|password|passwd|key|credential)[a-z0-9_]*=[\"" q "]?"
  red(a v "+", a, "assignment", "")
  red(b "github_pat_[a-z0-9_]+", b, "github-token", "")
  red(b "gh[pousr]_" rep("[a-z0-9]", 20) "[a-z0-9]*", b, "github-token", "")
  red(b "glpat-" rep("[a-z0-9_-]", 20) "[a-z0-9_-]*", b, "gitlab-token", "")
  red(b "xox[abposr]-" rep("[a-z0-9-]", 10) "[a-z0-9-]*", b, "slack-token", "")
  red(b "sk-" rep("[a-z0-9_-]", 20) "[a-z0-9_-]*", b, "api-key", "")
  red(b "[rs]k_(live|test)_" rep("[a-z0-9]", 10) "[a-z0-9]*", b, "stripe-key", "")
  red(b "(akia|asia)" rep("[a-z0-9]", 16), b, "aws-access-key", "")
  red(b "aiza" rep("[a-z0-9_-]", 35), b, "google-api-key", "")
  red(b "npm_" rep("[a-z0-9]", 36), b, "npm-token", "")
  buf = substr(buf, 2)
  gsub(/\001/, "<REDACTED:", buf)
  gsub(/\002/, ">", buf)
  return buf
}'
}

# SQL: open the session's guild.session span unless one is open; a session first seen mid-way starts now.
gm_session_open_sql() {
  cat <<SQL
INSERT OR IGNORE INTO open_span(key, session_id, trace_id, span_id, parent_id, name, start_ms, attrs)
  VALUES ($(gm_q "session:$1"), $(gm_q "$1"), lower(hex(randomblob(16))), lower(hex(randomblob(8))), NULL, 'guild.session', $2,
          $(gm_jobj session.id "$(gm_q "$1")" guild.focus "$(gm_qn "${GM_FOCUS:-}")" guild.role "'party-leader'"));
SQL
}

# SQL: write the open spans matching the condition $1 as finished spans, and remove them.
# $2 end time in ms (an SQL expression that may use open_span's columns), $3 status, $4 attributes to add,
# $5 optional start time (default: when it was opened).
gm_close_sql() {
  local start=${5:-start_ms}
  cat <<SQL
INSERT OR IGNORE INTO span(trace_id, span_id, parent_id, name, start_ms, end_ms, status, attrs)
  SELECT trace_id, span_id, parent_id, name, $start, MAX($start, $2), $3, json_patch(attrs, $4) FROM open_span WHERE $1;
DELETE FROM open_span WHERE $1;
SQL
}

# The last time an open span was seen alive: the end of its latest child, or its start.
GM_LAST_SEEN="COALESCE((SELECT MAX(s.end_ms) FROM span s WHERE s.trace_id=open_span.trace_id AND s.parent_id=open_span.span_id), open_span.start_ms)"

# SQL: the open Bash tool call of this Claude Code session most likely to have run this gm command.
gm_calling_tool_sql() {
  local sid=${CLAUDE_CODE_SESSION_ID:-}
  if [ -z "$sid" ]; then
    printf "SELECT NULL AS trace_id, NULL AS span_id, '{}' AS attrs WHERE 0"
    return
  fi
  printf "SELECT trace_id, span_id, attrs FROM open_span WHERE session_id=%s AND name='execute_tool Bash' ORDER BY instr(COALESCE(%s,''),%s)>0 DESC, start_ms DESC LIMIT 1" \
    "$(gm_q "$sid")" "$(gm_a guild.tool.command)" "$(gm_q "$1")"
}

# Records a prompt template's rendered text once per hash; prints the hash.
gm_prompt_sql() {
  # $1 template name, $2 file holding the rendered text, $3 its sha256
  printf "INSERT OR IGNORE INTO prompt_version(name, sha256, first_seen, text) VALUES (%s, %s, %s, CAST(readfile(%s) AS TEXT));\n" \
    "$(gm_q "$1")" "$(gm_q "$3")" "$GM_NOW" "$(gm_q "$2")"
}

# Spans for gm's own commands: a guild.notice span in the posting's trace, written when the command is done.
gm_trace_notice() {
  # $1 posting id, $2 verb, $3 state before, $4 state after ('' when unchanged), $5 detail, $6 start ms, $7 tool word
  local pid=$1 verb=$2 before=$3 after=$4 detail=$5 t0=$6 word=${7:-notice} commit reopen='' close=''
  commit=$(gm_commit "$(gm_sql "SELECT f.camp FROM posting p JOIN focus f ON f.id=p.focus_id WHERE p.id=$pid;" 2>/dev/null || true)")
  case $before in done | failed | closed) case $after in '' | done | failed | closed) ;; *) reopen=1 ;; esac ;; esac
  case $after in done | failed | closed) case $before in done | failed | closed) ;; *) close=1 ;; esac ;; esac
  local sql
  sql="CREATE TEMP TABLE c AS
  SELECT p.id, p.trace_id AS tid, p.span_id AS old_span, f.name AS focus, f.name||'#'||p.num AS ref, p.slug, p.state,
         (SELECT g.name||'#'||o.num FROM posting o JOIN focus g ON g.id=o.focus_id WHERE o.id=p.follows_id) AS follows
  FROM posting p JOIN focus f ON f.id=p.focus_id WHERE p.id=$pid AND p.trace_id IS NOT NULL;
CREATE TEMP TABLE tool AS $(gm_calling_tool_sql "$word");
CREATE TEMP TABLE n AS SELECT lower(hex(randomblob(8))) AS span_id;"
  if [ -n "$reopen" ]; then
    sql="$sql
UPDATE posting SET span_id=lower(hex(randomblob(8))), span_start_ms=$t0 WHERE id=$pid AND trace_id IS NOT NULL;
INSERT INTO span_link(trace_id, span_id, linked_trace_id, linked_span_id, attrs)
  SELECT p.trace_id, p.span_id, c.tid, c.old_span, json_object('guild.link','reopens') FROM posting p JOIN c ON c.id=p.id;"
  fi
  sql="$sql
INSERT INTO span(trace_id, span_id, parent_id, name, start_ms, end_ms, status, attrs)
  SELECT c.tid, n.span_id, CASE WHEN tool.trace_id=c.tid THEN tool.span_id ELSE p.span_id END, 'guild.notice', $t0, $GM_NOW_MS, 'ok',
         $(gm_jobj guild.notice.verb "$(gm_q "$verb")" guild.notice.detail "$(gm_qn "$detail")" guild.state c.state \
           guild.focus c.focus guild.posting c.ref guild.posting.slug c.slug guild.follows c.follows guild.role "'party-leader'" \
           session.id "$(gm_qn "${CLAUDE_CODE_SESSION_ID:-}")" guild.camp.commit "$(gm_qn "$commit")")
  FROM c JOIN posting p ON p.id=c.id JOIN n LEFT JOIN tool ON 1;
INSERT INTO span_link(trace_id, span_id, linked_trace_id, linked_span_id, attrs)
  SELECT c.tid, n.span_id, tool.trace_id, tool.span_id, json_object('guild.link','ran in') FROM c, n, tool WHERE tool.trace_id<>c.tid;"
  if [ -n "$close" ]; then
    sql="$sql
INSERT OR IGNORE INTO span(trace_id, span_id, parent_id, name, start_ms, end_ms, status, attrs)
  SELECT p.trace_id, p.span_id, NULL, 'guild.posting', COALESCE(p.span_start_ms, $t0), $GM_NOW_MS, CASE p.state WHEN 'failed' THEN 'error' ELSE 'ok' END,
         json_patch($(gm_jobj guild.focus c.focus guild.posting c.ref guild.posting.slug c.slug guild.state c.state guild.follows c.follows \
           error.type "CASE p.state WHEN 'failed' THEN 'failed' END" guild.camp.commit "$(gm_qn "$commit")" \
           gen_ai.request.model "(SELECT $(gm_a gen_ai.request.model) FROM span WHERE trace_id=p.trace_id AND name='invoke_agent party-leader' ORDER BY start_ms LIMIT 1)" \
           gen_ai.request.reasoning.level "(SELECT $(gm_a gen_ai.request.reasoning.level) FROM span WHERE trace_id=p.trace_id AND name='invoke_agent party-leader' ORDER BY start_ms LIMIT 1)"),
           (SELECT json_group_object(j.key, j.value)
            FROM (SELECT attrs FROM (SELECT attrs, start_ms FROM span WHERE trace_id=p.trace_id AND name='guild.exchange'
                                     UNION ALL SELECT attrs, start_ms FROM open_span WHERE trace_id=p.trace_id AND name='guild.exchange')
                  ORDER BY start_ms LIMIT 1) e, json_each(e.attrs) j
            WHERE j.key LIKE 'guild.prompt.%'))
  FROM posting p JOIN c ON c.id=p.id;"
  fi
  gm_trace "guild.notice $verb" "$sql"
}

# A phase change belongs to the focus: it hangs under the Bash call that ran it, or is a span of its own.
gm_trace_phase() {
  local focus=$1 phase=$2 t0=$3 commit
  commit=$(gm_commit "$(gm_focus_field "$focus" camp 2>/dev/null || true)")
  gm_trace "guild.notice phase" "CREATE TEMP TABLE tool AS $(gm_calling_tool_sql phase);
INSERT INTO span(trace_id, span_id, parent_id, name, start_ms, end_ms, status, attrs)
  SELECT COALESCE(tool.trace_id, lower(hex(randomblob(16)))), lower(hex(randomblob(8))), tool.span_id, 'guild.notice', $t0, $GM_NOW_MS, 'ok',
         $(gm_jobj guild.notice.verb "'phase'" guild.phase "$(gm_q "$phase")" guild.focus "$(gm_q "$focus")" \
           guild.posting "$(gm_a guild.posting tool.attrs)" guild.role "'party-leader'" \
           session.id "$(gm_qn "${CLAUDE_CODE_SESSION_ID:-}")" guild.camp.commit "$(gm_qn "$commit")")
  FROM (SELECT 1) LEFT JOIN tool ON 1;"
}

# ---- Hook handlers that only record (tracing-design.md, Spans) ----
# Each reads its payload, writes or opens spans, prints nothing and exits 0: they never block.

gm_record_hook() {
  local which=${1//-/_} json=''
  IFS= read -r -d '' json || true
  [ -s "$GM_DB" ] || return 0
  ("gm_record_$which" "$json") >/dev/null 2>&1 || gm_span_dropped "hook $which"
  return 0
}

# SQL: the span a tool call or subagent hangs under: the subagent it runs in, the turn, or the session.
gm_parent_sql() {
  # $1 session id, $2 prompt id, $3 agent id
  cat <<SQL
SELECT trace_id, span_id, attrs FROM (
  SELECT trace_id, span_id, attrs, 1 AS pri FROM open_span WHERE key=$(gm_q "agent:$3") AND $(gm_q "$3")<>''
  UNION ALL SELECT trace_id, span_id, attrs, 2 FROM open_span WHERE key=$(gm_q "turn:$1:$2")
  UNION ALL SELECT trace_id, span_id, attrs, 3 FROM open_span WHERE key=$(gm_q "session:$1")
  ORDER BY pri LIMIT 1)
SQL
}

# The fields of a tool hook's payload; the last three, the command or file path, escaped for printf %b.
gm_tool_fields() {
  gm_payload_json "$1" session_id prompt_id agent_id tool_name tool_use_id mcp_server.name tool_input.subagent_type \
    tool_input.run_in_background duration_ms is_interrupt error tool_response.status tool_response.resolvedModel \
    tool_response.totalToolUseCount tool_response.agentId effort.level %tool_input.command %tool_input.file_path %tool_input.notebook_path
}

# The full command of a Bash call, or a file tool's path, with secrets masked; empty for other tools.
gm_tool_command() {
  # $1 tool name, $2 the command or path as gm_tool_fields printed it
  case $1 in
    Bash | PowerShell | Read | Write | Edit | MultiEdit | NotebookEdit)
      [ -z "$2" ] || printf '%b' "$2" | gm_redact ;;
  esac
}

# SQL opening a tool call's span (PreToolUse, or a PostToolUse whose PreToolUse was not seen).
gm_tool_open_sql() {
  # $1 masked command, $2 session, $3 prompt, $4 agent, $5 tool name, $6 tool_use_id, $7 mcp server, $8 subagent type, $9 background, $10 start ms
  local cmd=$1 sid=$2 pid=$3 aid=$4 tool=$5 tuid=$6 mcp=$7 subtype=$8 bg=$9 t0=${10} server='' bgsql=NULL mcpsql=NULL
  [ "$bg" != 1 ] || bgsql="json('true')"
  case $tool in
    mcp__*)
      server=$mcp
      if [ -z "$server" ]; then server=${tool#mcp__}; server=${server%%__*}; fi ;;
  esac
  [ -z "$server" ] || mcpsql="'tools/call'"
  cat <<SQL
$(gm_session_open_sql "$sid" "$t0")
INSERT OR IGNORE INTO open_span(key, session_id, trace_id, span_id, parent_id, name, start_ms, attrs)
  SELECT $(gm_q "tool:$tuid"), $(gm_q "$sid"), par.trace_id, lower(hex(randomblob(8))), par.span_id, $(gm_q "execute_tool $tool"), $t0,
         $(gm_jobj gen_ai.operation.name "'execute_tool'" gen_ai.tool.name "$(gm_q "$tool")" gen_ai.tool.call.id "$(gm_qn "$tuid")" \
           mcp.method.name "$mcpsql" guild.mcp.server "$(gm_qn "$server")" \
           guild.tool.command "$(gm_qn "$cmd")" guild.subagent.type "$(gm_qn "$subtype")" \
           guild.background "$bgsql" \
           session.id "$(gm_qn "$sid")" prompt.id "$(gm_qn "$pid")" agent_id "$(gm_qn "$aid")" \
           guild.focus "$(gm_a guild.focus par.attrs)" guild.posting "$(gm_a guild.posting par.attrs)")
  FROM ($(gm_parent_sql "$sid" "$pid" "$aid")) par;
SQL
}

gm_record_pre_tool() {
  local t0 camp sid pid aid tool tuid mcp subtype bg dur intr err rstatus rmodel ruses rid effort c1 c2 c3
  t0=$(gm_now_ms)
  IFS=$'\037' read -r camp sid pid aid tool tuid mcp subtype bg dur intr err rstatus rmodel ruses rid effort c1 c2 c3 <<<"$(gm_tool_fields "$1")"
  [ -n "$tuid" ] || return 0
  gm_trace "execute_tool $tool" "$(gm_tool_open_sql "$(gm_tool_command "$tool" "${c1:-${c2:-$c3}}")" "$sid" "$pid" "$aid" "$tool" "$tuid" "$mcp" "$subtype" "$bg" "$t0")"
}

gm_record_tool_end() {
  # $1 payload file, $2 ok or error
  local t1 camp sid pid aid tool tuid mcp subtype bg dur intr err rstatus rmodel ruses rid effort c1 c2 c3 commit start
  t1=$(gm_now_ms)
  IFS=$'\037' read -r camp sid pid aid tool tuid mcp subtype bg dur intr err rstatus rmodel ruses rid effort c1 c2 c3 <<<"$(gm_tool_fields "$1")"
  [ -n "$tuid" ] || return 0
  commit=$(gm_commit "$camp")
  start=start_ms
  if gm_is_int "$dur"; then start="MAX(start_ms, $t1-$dur)"; fi
  [ "$rstatus" != async_launched ] || bg=1
  local errtype=NULL status="'ok'" code=NULL uses=NULL bgsql=NULL
  gm_is_int "$ruses" && uses=$ruses
  [ "$bg" != 1 ] || bgsql="json('true')"
  if [ "$2" = error ]; then
    status="'error'"
    if [ "$intr" = 1 ]; then errtype="'interrupt'"; else errtype="'tool_error'"; fi
    case $err in
      "Exit code "[0-9]*)
        code=${err#Exit code }
        code=${code%%[!0-9]*}
        gm_is_int "$code" || code=NULL ;;
    esac
  fi
  local t0=$t1
  if gm_is_int "$dur"; then t0="($t1-$dur)"; fi
  gm_trace "execute_tool $tool" "$(gm_tool_open_sql "$(gm_tool_command "$tool" "${c1:-${c2:-$c3}}")" "$sid" "$pid" "$aid" "$tool" "$tuid" "$mcp" "$subtype" "$bg" "$t0")
$(gm_close_sql "key=$(gm_q "tool:$tuid")" "$t1" "$status" "$(gm_jobj error.type "$errtype" guild.exit_code "$code" \
  gen_ai.request.model "$(gm_qn "$rmodel")" guild.subagent.tool_uses "$uses" guild.subagent.id "$(gm_qn "$rid")" guild.background "$bgsql" guild.camp.commit "$(gm_qn "$commit")")" "$start")"
}

gm_is_int() {
  case $1 in '' | *[!0-9]*) return 1 ;; *) return 0 ;; esac
}

gm_record_post_tool() { gm_record_tool_end "$1" ok; }
gm_record_post_tool_failure() { gm_record_tool_end "$1" error; }

gm_record_subagent_start() {
  local t0 camp sid pid aid atype rest
  t0=$(gm_now_ms)
  IFS=$'\037' read -r camp sid pid aid atype rest <<<"$(gm_payload_json "$1" session_id prompt_id agent_id agent_type)"
  [ -n "$aid" ] || return 0
  gm_trace "invoke_agent $atype" "$(gm_session_open_sql "$sid" "$t0")
CREATE TEMP TABLE par AS
  SELECT trace_id, span_id, attrs FROM span WHERE name='execute_tool Agent' AND $(gm_a guild.subagent.id)=$(gm_q "$aid") LIMIT 1;
INSERT INTO par
  SELECT trace_id, span_id, attrs FROM open_span t
  WHERE NOT EXISTS (SELECT 1 FROM par)
    AND t.session_id=$(gm_q "$sid") AND t.name='execute_tool Agent' AND COALESCE($(gm_a guild.subagent.type t.attrs),'')=$(gm_q "$atype")
    AND NOT EXISTS (SELECT 1 FROM open_span o WHERE o.parent_id=t.span_id AND o.name LIKE 'invoke_agent %')
    AND NOT EXISTS (SELECT 1 FROM span s WHERE s.trace_id=t.trace_id AND s.parent_id=t.span_id AND s.name LIKE 'invoke_agent %')
  ORDER BY t.start_ms LIMIT 1;
INSERT INTO par SELECT * FROM ($(gm_parent_sql "$sid" "$pid" "")) WHERE NOT EXISTS (SELECT 1 FROM par);
INSERT OR IGNORE INTO open_span(key, session_id, trace_id, span_id, parent_id, name, start_ms, attrs)
  SELECT $(gm_q "agent:$aid"), $(gm_q "$sid"), par.trace_id, lower(hex(randomblob(8))), par.span_id, $(gm_q "invoke_agent ${atype:-subagent}"), $t0,
         $(gm_jobj gen_ai.operation.name "'invoke_agent'" gen_ai.agent.name "$(gm_qn "$atype")" agent_id "$(gm_q "$aid")" \
           session.id "$(gm_qn "$sid")" prompt.id "$(gm_qn "$pid")" guild.background "CASE WHEN $(gm_a guild.background par.attrs) THEN json('true') END" \
           guild.focus "$(gm_a guild.focus par.attrs)" guild.posting "$(gm_a guild.posting par.attrs)")
  FROM par LIMIT 1;"
}

gm_record_subagent_stop() {
  local t1 camp sid aid effort rest commit
  t1=$(gm_now_ms)
  IFS=$'\037' read -r camp sid aid effort rest <<<"$(gm_payload_json "$1" session_id agent_id effort.level)"
  [ -n "$aid" ] || return 0
  commit=$(gm_commit "$camp")
  gm_trace "invoke_agent" "$(gm_close_sql "key=$(gm_q "agent:$aid")" "$t1" "'ok'" "$(gm_jobj gen_ai.request.reasoning.level "$(gm_qn "$effort")" guild.camp.commit "$(gm_qn "$commit")")")"
}

# The turn's model, effort and cost: from Claude Code's status line samples (gm statusline) and the hook's effort.
gm_turn_attrs_sql() {
  # $1 session, $2 effort from the hook, $3 end ms, $4 commit
  local s
  s=$(gm_q "$1")
  gm_jobj gen_ai.request.model "(SELECT model FROM model_sample WHERE session_id=$s AND model IS NOT NULL AND at_ms<=$3 ORDER BY id DESC LIMIT 1)" \
    gen_ai.request.reasoning.level "COALESCE($(gm_qn "$2"), (SELECT effort FROM model_sample WHERE session_id=$s AND at_ms<=$3 ORDER BY id DESC LIMIT 1))" \
    guild.cost.usd "(SELECT ROUND(e.cost_usd-COALESCE((SELECT cost_usd FROM model_sample WHERE session_id=$s AND cost_usd IS NOT NULL AND at_ms<=open_span.start_ms ORDER BY id DESC LIMIT 1),0),6)
                     FROM model_sample e WHERE e.session_id=$s AND e.cost_usd IS NOT NULL AND e.at_ms>open_span.start_ms AND e.at_ms<=$3 ORDER BY e.id DESC LIMIT 1)" \
    guild.camp.commit "$(gm_qn "$4")"
}

# SQL ending the turn of prompt $2 and its exchange, and turns of earlier prompts left open (interrupted).
gm_turn_end_sql() {
  # $1 session, $2 prompt, $3 end ms, $4 status SQL, $5 error type, $6 effort, $7 commit, $8 extra turn attrs SQL
  local s ex
  s=$(gm_q "$1")
  ex="(key=$(gm_q "exchange:$1:$2") OR substr(key,1,length($(gm_q "exchange:$1:$2:")))=$(gm_q "exchange:$1:$2:"))"
  cat <<SQL
INSERT OR IGNORE INTO span_link(trace_id, span_id, linked_trace_id, linked_span_id, attrs)
  SELECT e.trace_id, e.span_id, s.trace_id, s.span_id, json_object('guild.link','served by session')
  FROM open_span e, open_span s WHERE e.key IN (SELECT key FROM open_span WHERE $ex) AND s.key=$(gm_q "session:$1");
$(gm_close_sql "key=$(gm_q "turn:$1:$2")" "$3" "$4" "json_patch($(gm_turn_attrs_sql "$1" "$6" "$3" "$7"), json_patch($(gm_jobj error.type "$(gm_qn "$5")"), $8))")
$(gm_close_sql "$ex" "$3" "$4" "$(gm_jobj error.type "$(gm_qn "$5")" guild.camp.commit "$(gm_qn "$7")")")
$(gm_close_sql "session_id=$s AND (name='guild.exchange' OR name='invoke_agent party-leader') AND start_ms<$3" "$GM_LAST_SEEN" "'unset'" "$(gm_jobj guild.closed_by "'interrupted'")")
SQL
}

gm_record_stop_failure() {
  local t1 camp sid pid err effort rest commit
  t1=$(gm_now_ms)
  IFS=$'\037' read -r camp sid pid err effort rest <<<"$(gm_payload_json "$1" session_id prompt_id error effort.level)"
  commit=$(gm_commit "$camp")
  gm_trace "stop failure" "$(gm_turn_end_sql "$sid" "$pid" "$t1" "'error'" "${err:-unknown}" "$effort" "$commit" \
    "$(gm_event_sql "'{}'" "json_object('name','stop_failure','time_ms',$t1,'error',$(gm_qn "$err"))")")"
}

gm_record_session_end() {
  local t1 camp sid reason rest commit
  t1=$(gm_now_ms)
  IFS=$'\037' read -r camp sid reason rest <<<"$(gm_payload_json "$1" session_id reason)"
  [ -n "$sid" ] || return 0
  commit=$(gm_commit "$camp")
  gm_trace "guild.session" "$(gm_session_open_sql "$sid" "$t1")
$(gm_close_sql "session_id=$(gm_q "$sid") AND key<>$(gm_q "session:$sid")" "$GM_LAST_SEEN" "'unset'" "$(gm_jobj guild.closed_by "'session-end'")")
$(gm_close_sql "key=$(gm_q "session:$sid")" "$t1" "'ok'" "$(gm_jobj guild.session.end_reason "$(gm_qn "$reason")" guild.camp.commit "$(gm_qn "$commit")")")"
}

# ---- Spans of the hooks that decide or inject: guild.hook, written when the handler returns ----

# SQL inserting one guild.hook span under the span keyed $3 (falling back to the session's).
gm_hook_span_sql() {
  # $1 event, $2 handler, $3 parent key, $4 session, $5 prompt, $6 start ms, $7 decision, $8 extra attrs SQL, $9 commit
  cat <<SQL
INSERT INTO span(trace_id, span_id, parent_id, name, start_ms, end_ms, status, attrs)
  SELECT par.trace_id, lower(hex(randomblob(8))), par.span_id, 'guild.hook', $6, $GM_NOW_MS, 'ok',
         json_patch($(gm_jobj guild.hook.event "$(gm_q "$1")" guild.hook.handler "$(gm_q "$2")" guild.hook.decision "$(gm_q "$7")" \
           session.id "$(gm_qn "$4")" prompt.id "$(gm_qn "$5")" guild.focus "$(gm_a guild.focus par.attrs)" guild.posting "$(gm_a guild.posting par.attrs)" \
           guild.camp.commit "$(gm_qn "$9")"), $8)
  FROM (SELECT trace_id, span_id, attrs, 1 AS pri FROM open_span WHERE key=$(gm_q "$3")
        UNION ALL SELECT trace_id, span_id, attrs, 2 FROM open_span WHERE key=$(gm_q "session:$4")
        ORDER BY pri LIMIT 1) par;
SQL
}

gm_trace_prompt() {
  # $1 payload file, $2 message id, $3 start ms
  local f=$1 mid=$2 t0=$3 camp sid pid rest commit
  IFS=$'\037' read -r camp sid pid rest <<<"$(gm_payload "$f" session_id prompt_id)"
  commit=$(gm_commit "$camp")
  local ex turn exkey=exchange:$sid:$pid
  # A message typed during a running turn is captured when Claude Code takes it up, with that turn's
  # prompt_id (tracing-design.md, As built in slice 2): it gets an exchange of its own, answered by that turn.
  [ -z "$(gm_sql "SELECT 1 FROM open_span WHERE key=$(gm_q "$exkey");" 2>/dev/null || true)" ] || exkey=$exkey:$mid
  ex=$(gm_q "$exkey")
  turn=$(gm_q "turn:$sid:$pid")
  gm_trace "guild.exchange" "$(gm_session_open_sql "$sid" "$t0")
CREATE TEMP TABLE c AS
  SELECT m.id AS mid, m.disposition AS kind, p.trace_id AS tid, p.span_id AS psid, f.name AS focus, f.name||'#'||p.num AS ref, p.slug,
         (SELECT count(*) FROM message x WHERE x.posting_id=m.posting_id AND x.id<=m.id) AS n
  FROM message m LEFT JOIN posting p ON p.id=m.posting_id LEFT JOIN focus f ON f.id=m.focus_id WHERE m.id=$mid;
INSERT OR IGNORE INTO open_span(key, session_id, trace_id, span_id, parent_id, name, start_ms, attrs)
  SELECT $ex, $(gm_q "$sid"), c.tid, lower(hex(randomblob(8))), c.psid, 'guild.exchange', $t0,
         json_patch($(gm_jobj guild.focus c.focus guild.posting c.ref guild.posting.slug c.slug guild.message.id c.mid guild.message.kind c.kind \
           guild.exchange.n c.n guild.role "'patron'" session.id "$(gm_qn "$sid")" prompt.id "$(gm_qn "$pid")"),
           (SELECT json_group_object(j.key, j.value) FROM open_span s, json_each(s.attrs) j WHERE s.key=$(gm_q "session:$sid") AND j.key LIKE 'guild.prompt.%'))
  FROM c WHERE c.tid IS NOT NULL;
INSERT OR IGNORE INTO open_span(key, session_id, trace_id, span_id, parent_id, name, start_ms, attrs)
  SELECT $turn, $(gm_q "$sid"), par.trace_id, lower(hex(randomblob(8))), par.span_id, 'invoke_agent party-leader', $t0,
         $(gm_jobj gen_ai.operation.name "'invoke_agent'" gen_ai.agent.name "'party-leader'" gen_ai.conversation.id "$(gm_qn "$sid")" \
           guild.role "'party-leader'" session.id "$(gm_qn "$sid")" prompt.id "$(gm_qn "$pid")" \
           guild.focus "COALESCE($(gm_a guild.focus par.attrs),$(gm_qn "${GM_FOCUS:-}"))" guild.posting "$(gm_a guild.posting par.attrs)")
  FROM (SELECT trace_id, span_id, attrs, 1 AS pri FROM open_span WHERE key=$ex
        UNION ALL SELECT trace_id, span_id, attrs, 2 FROM open_span WHERE key=$(gm_q "session:$sid")
        ORDER BY pri LIMIT 1) par;
INSERT OR IGNORE INTO span_link(trace_id, span_id, linked_trace_id, linked_span_id, attrs)
  SELECT e.trace_id, e.span_id, t.trace_id, t.span_id, json_object('guild.link','answered by turn')
  FROM open_span e, open_span t WHERE e.key=$ex AND t.key=$turn AND t.parent_id<>e.span_id;
$(gm_hook_span_sql UserPromptSubmit capture "$exkey" "$sid" "$pid" "$t0" none \
  "(SELECT $(gm_jobj guild.message.id c.mid guild.message.kind c.kind) FROM c)" "$commit")"
}

gm_trace_stop() {
  # $1 payload file, $2 start ms, $3 decision (block, allow), $4 blocks, $5 gave up (1 or ''), $6 block reason file
  local f=$1 t0=$2 decision=$3 blocks=$4 gaveup=$5 reasonf=${6:-} camp sid pid effort rest commit extra psql='' sha=''
  IFS=$'\037' read -r camp sid pid effort rest <<<"$(gm_payload "$f" session_id prompt_id effort.level)"
  commit=$(gm_commit "$camp")
  extra=$(gm_jobj guild.hook.blocks "${blocks:-0}")
  if [ -n "$reasonf" ] && [ -s "$reasonf" ]; then
    sha=$(gm_sha256_file "$reasonf")
    if [ -n "$sha" ]; then
      psql=$(gm_prompt_sql stop-guard "$reasonf" "$sha")
      extra="json_patch($extra, $(gm_jobj guild.prompt.stop-guard.sha256 "$(gm_q "$sha")"))"
    fi
  fi
  [ -z "$gaveup" ] || extra=$(gm_event_sql "$extra" "json_object('name','guard.gave-up','time_ms',$t0)")
  local sql
  sql="$(gm_session_open_sql "$sid" "$t0")
$psql
$(gm_hook_span_sql Stop guard "exchange:$sid:$pid" "$sid" "$pid" "$t0" "$decision" "$extra" "$commit")"
  if [ "$decision" != block ]; then
    sql="$sql
$(gm_turn_end_sql "$sid" "$pid" "$t0" "'ok'" "" "$effort" "$commit" "'{}'")"
  fi
  gm_trace "guild.hook Stop" "$sql"
}

gm_trace_session_start() {
  # $1 payload file, $2 start ms, $3 file holding the injected resume text
  local f=$1 t0=$2 textf=$3 camp sid source model rest commit sha key psql=''
  IFS=$'\037' read -r camp sid source model rest <<<"$(gm_payload "$f" session_id source model)"
  commit=$(gm_commit "$camp")
  sha=$(gm_sha256_file "$textf")
  [ -z "$sha" ] || psql=$(gm_prompt_sql resume "$textf" "$sha")
  key=$(gm_q "session:$sid")
  local sql
  if [ "$source" = compact ]; then
    sql="$(gm_session_open_sql "$sid" "$t0")
UPDATE open_span SET attrs=$(gm_event_sql attrs "json_object('name','session.resumed-after-compaction','time_ms',$t0)") WHERE key=$key;"
  else
    sql="$(gm_close_sql "key=$key AND $(gm_a guild.session.source) IS NOT NULL" "$GM_LAST_SEEN" "'unset'" "$(gm_jobj guild.closed_by "'session-start'")")
$(gm_session_open_sql "$sid" "$t0")
UPDATE open_span SET attrs=json_patch(attrs, $(gm_jobj guild.session.source "$(gm_qn "$source")" gen_ai.request.model "$(gm_qn "$model")")) WHERE key=$key;"
  fi
  [ -z "$model" ] || sql="$sql
INSERT INTO model_sample(at_ms, session_id, model) VALUES ($t0, $(gm_q "$sid"), $(gm_q "$model"));"
  [ -z "$sha" ] || sql="$sql
$psql
UPDATE open_span SET attrs=json_patch(attrs, $(gm_jobj guild.prompt.resume.sha256 "$(gm_q "$sha")")) WHERE key=$key;"
  gm_trace "guild.hook SessionStart" "$sql
$(gm_hook_span_sql SessionStart resume "session:$sid" "$sid" "" "$t0" none \
  "$(gm_jobj guild.session.source "$(gm_qn "$source")" guild.prompt.resume.sha256 "$(gm_qn "$sha")")" "$commit")"
}

gm_trace_charter() {
  # $1 payload file, $2 start ms, then template name / file pairs
  local f=$1 t0=$2 camp sid rest commit name file sha sql='' attrs=''
  shift 2
  IFS=$'\037' read -r camp sid rest <<<"$(gm_payload "$f" session_id)"
  commit=$(gm_commit "$camp")
  while [ $# -ge 2 ]; do
    name=$1 file=$2
    shift 2
    [ -f "$file" ] || continue
    sha=$(gm_sha256_file "$file")
    [ -n "$sha" ] || continue
    sql="$sql$(gm_prompt_sql "$name" "$file" "$sha")"
    attrs="$attrs guild.prompt.$name.sha256 $sha"
  done
  local obj
  # shellcheck disable=SC2086
  obj=$(set -f; gm_jobj_strings $attrs)
  gm_trace "guild.hook SessionStart" "$(gm_session_open_sql "$sid" "$t0")
$sql
UPDATE open_span SET attrs=json_patch(attrs, $obj) WHERE key=$(gm_q "session:$sid");
$(gm_hook_span_sql SessionStart charter "session:$sid" "$sid" "" "$t0" none "$obj" "$commit")"
}

# gm_jobj for string values only.
gm_jobj_strings() {
  local args=()
  while [ $# -ge 2 ]; do
    args+=("$1" "$(gm_q "$2")")
    shift 2
  done
  if [ ${#args[@]} -eq 0 ]; then printf "'{}'"; else gm_jobj "${args[@]}"; fi
}

gm_trace_precompact() {
  # $1 payload file, $2 start ms
  local f=$1 t0=$2 camp sid trigger rest commit
  IFS=$'\037' read -r camp sid trigger rest <<<"$(gm_payload "$f" session_id trigger)"
  commit=$(gm_commit "$camp")
  gm_trace "guild.hook PreCompact" "$(gm_session_open_sql "$sid" "$t0")
UPDATE open_span SET attrs=$(gm_event_sql attrs "json_object('name','compaction','time_ms',$t0,'trigger',$(gm_qn "$trigger"))") WHERE key=$(gm_q "session:$sid");
$(gm_hook_span_sql PreCompact snapshot "session:$sid" "$sid" "" "$t0" none "$(gm_jobj guild.compaction.trigger "$(gm_qn "$trigger")")" "$commit")"
}

# ---- Claude Code's telemetry through the local collector: build slice 2 of vision/tracing-design.md ----
# gm open points the Party Leader's exporter at 127.0.0.1 only; the collector in templates/otelcol.yaml drops
# identity, masks secrets and writes rotating files under the Guildhall; gm trace import folds those files
# into the register under the GenAI names, keyed by session.id, prompt.id, tool_use_id and agent_id.

# Attributes never stored, whatever sent them: who the patron is, and the raw text Claude Code captures,
# which is stored only as gm's own masked copy (guild.prompt.text, guild.response.text, guild.tool.command).
GM_OTEL_IDENTITY="'\$.\"user.email\"','\$.\"user.id\"','\$.\"user.account_uuid\"','\$.\"user.account_id\"','\$.\"organization.id\"'"
GM_OTEL_CONTENT="'\$.\"user_prompt\"','\$.\"prompt\"','\$.\"prompt_text\"','\$.\"response\"','\$.\"tool_parameters\"','\$.\"tool_input\"','\$.\"full_command\"'"

gm_otel_endpoint() {
  local ep=${GM_OTEL_ENDPOINT:-http://127.0.0.1:${GM_OTEL_PORT:-4318}}
  printf '%s' "${ep%/}"
}

# Only 127.0.0.1, localhost or ::1, with an optional port and path, and nothing that could name another host.
gm_is_loopback() {
  local re='^https?://(127\.0\.0\.1|localhost|\[::1\])(:[0-9]{1,5})?(/[^@[:space:]]*)?$'
  [[ $1 =~ $re ]]
}

# Each export destination a Claude Code settings file's env sets to somewhere other than loopback, as
# "file: NAME=value". Settings env reaches the session whatever gm puts in its environment.
gm_settings_offenders() {
  local f k v
  for f in "$HOME/.claude/settings.json" "/Library/Application Support/ClaudeCode/managed-settings.json" /etc/claude-code/managed-settings.json; do
    [ -f "$f" ] || continue
    while IFS=$'\t' read -r k v; do
      [ -n "$k" ] || continue
      gm_is_loopback "$v" || printf '%s: %s=%s\n' "$f" "$k" "$v"
    done <<<"$(sqlite3 -batch -separator "$(printf '\t')" :memory: "SELECT key, value FROM json_each(json_extract(CAST(readfile($(gm_q "$f")) AS TEXT),'\$.env'))
      WHERE key IN ('OTEL_EXPORTER_OTLP_ENDPOINT','OTEL_EXPORTER_OTLP_TRACES_ENDPOINT','OTEL_EXPORTER_OTLP_LOGS_ENDPOINT','OTEL_EXPORTER_OTLP_METRICS_ENDPOINT','BETA_TRACING_ENDPOINT');" 2>/dev/null || true)"
  done
}

# Refuses, before anything is made or started, a session whose telemetry could leave the machine.
gm_telemetry_refuse() {
  [ "${GM_TELEMETRY:-on}" != off ] || return 0
  local ep bad
  ep=$(gm_otel_endpoint)
  gm_is_loopback "$ep" || gm_die "open: telemetry goes only to 127.0.0.1, localhost or ::1, not $ep (GM_OTEL_ENDPOINT); GM_TELEMETRY=off starts the session without it"
  bad=$(gm_settings_offenders)
  [ -z "$bad" ] || gm_die "open: Claude Code's settings would send this session's telemetry off the machine:
$bad
Point them at 127.0.0.1 or remove them; gm starts no session whose telemetry goes elsewhere."
}

# The arguments for env(1) that gm open gives the Party Leader, one per line: the exporter pointed at the
# loopback collector only, every inherited destination and header replaced or cleared, prompts, responses
# and tool details captured, tool output and raw API bodies not (tracing-design.md, Retention and redaction).
gm_telemetry_env() {
  [ "${GM_TELEMETRY:-on}" != off ] || return 0
  local focus=$1 ep s
  ep=$(gm_otel_endpoint)
  printf '%s\n' -u OTEL_EXPORTER_OTLP_HEADERS -u OTEL_LOG_TOOL_CONTENT -u OTEL_LOG_RAW_API_BODIES -u ENABLE_BETA_TRACING_DETAILED -u BETA_TRACING_ENDPOINT
  for s in TRACES LOGS METRICS; do printf '%s\n' -u "OTEL_EXPORTER_OTLP_${s}_HEADERS"; done
  printf '%s\n' CLAUDE_CODE_ENABLE_TELEMETRY=1 CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1 \
    OTEL_TRACES_EXPORTER=otlp OTEL_LOGS_EXPORTER=otlp OTEL_METRICS_EXPORTER=otlp OTEL_EXPORTER_OTLP_PROTOCOL=http/json \
    "OTEL_EXPORTER_OTLP_ENDPOINT=$ep"
  for s in TRACES:traces LOGS:logs METRICS:metrics; do
    printf '%s\n' "OTEL_EXPORTER_OTLP_${s%%:*}_PROTOCOL=http/json" "OTEL_EXPORTER_OTLP_${s%%:*}_ENDPOINT=$ep/v1/${s#*:}"
  done
  printf '%s\n' "OTEL_RESOURCE_ATTRIBUTES=guild.focus=$focus,guild.role=party-leader" \
    OTEL_LOG_USER_PROMPTS=1 OTEL_LOG_ASSISTANT_RESPONSES=1 OTEL_LOG_TOOL_DETAILS=1
}

# The HTTP status an OTLP/HTTP receiver at a loopback endpoint gives an empty logs export, through bash's
# own /dev/tcp; empty when nothing answers.
gm_otlp_status() {
  local ep=$1 host port body='{"resourceLogs":[]}'
  local re='^http://(127\.0\.0\.1|localhost|\[::1\])(:([0-9]{1,5}))?'
  [[ $ep =~ $re ]] || return 0
  host=${BASH_REMATCH[1]}
  port=${BASH_REMATCH[3]:-80}
  [ "$host" != '[::1]' ] || host=::1
  (
    exec 3<>"/dev/tcp/$host/$port" || exit 0
    printf 'POST /v1/logs HTTP/1.1\r\nHost: %s:%s\r\nContent-Type: application/json\r\nContent-Length: %s\r\nConnection: close\r\n\r\n%s' \
      "$host" "$port" "${#body}" "$body" >&3
    IFS=' ' read -r -t 3 _ code _ <&3 || exit 0
    printf '%s' "$code"
  ) 2>/dev/null || true
}

gm_otelcol() {
  if [ -n "${GM_OTELCOL:-}" ]; then
    [ ! -x "$GM_OTELCOL" ] || printf '%s' "$GM_OTELCOL"
  else
    local p
    p=$(command -v otelcol-contrib 2>/dev/null || true)
    if [ -z "$p" ]; then
      # A collector that gm init installed need not be on the PATH; the Guildhall recorded where it put it.
      p=$(gm_conf_get collector-path)
      [ -x "$p" ] || p=''
    fi
    printf '%s' "$p"
  fi
}

gm_collector_config() { printf '%s' "${GM_COLLECTOR_CONFIG:-$GM_TEMPLATES/otelcol.yaml}"; }

gm_cmd_collector() {
  [ $# -eq 0 ] || gm_die "collector: gm collector takes no arguments (collector-port in guild.conf, or GM_OTEL_PORT, sets the port)"
  gm_collector_exec
}

# Runs the collector in the foreground, by hand (gm collector) or in its herdr pane (gm start collector); never as a
# second copy beside one that already answers on the port.
gm_collector_exec() {
  local bin port=${GM_OTEL_PORT:-4318}
  gm_is_int "$port" || gm_die "collector: GM_OTEL_PORT must be a port number"
  bin=$(gm_otelcol)
  [ -n "$bin" ] || gm_die "collector: no OpenTelemetry Collector found; install otelcol-contrib (README.md) or set GM_OTELCOL"
  [ "$(gm_otlp_status "http://127.0.0.1:$port")" != 200 ] ||
    gm_die "collector: a collector already answers on 127.0.0.1:$port, so gm starts no second one$([ "${GM_COLLECTOR:-}" = on ] && printf ' (while guild.conf says collector: on, gm keeps one running in herdr tab %s)' "$GM_COLLECTOR_TAB")"
  mkdir -p "$GM_HALL/telemetry"
  export GM_HALL GM_OTEL_PORT=$port
  printf 'gm: the collector takes telemetry on 127.0.0.1:%s and writes it under %s/telemetry; Ctrl-C stops it\n' "$port" "$GM_HALL" >&2
  exec "$bin" --config "$(gm_collector_config)"
}

# Static checks that a collector configuration can send nothing anywhere: every endpoint it listens on is
# loopback, every exporter writes a file, and it serves no telemetry of its own. Prints one problem a line.
gm_collector_config_problems() {
  local cfg=$1
  awk '
    /^[^[:space:]#][^:]*:/ { top = $1; sub(/:.*/, "", top) }
    /^[[:space:]]*endpoint:/ {
      v = $0; sub(/^[[:space:]]*endpoint:[[:space:]]*/, "", v); gsub(/["\047]/, "", v)
      if (v !~ /^(127\.0\.0\.1|localhost|\[::1\])(:|$)/) print "listens on " v ", not loopback"
    }
    top == "exporters" && /^  [^[:space:]#][^:]*:/ {
      k = $1; sub(/:.*/, "", k)
      if (k !~ /^file(\/|$)/) print "exporter " k " is not a file exporter"
    }
    top == "extensions" && /^  [^[:space:]#][^:]*:/ { k = $1; sub(/:.*/, "", k); print "extension " k " (extensions can listen or send)" }
    /^[[:space:]]+level:[[:space:]]*/ && prev ~ /^[[:space:]]+metrics:/ { if ($2 != "none") print "the collector serves its own metrics (service.telemetry.metrics.level " $2 ")" }
    { prev = $0 }
  ' "$cfg"
  grep -q '^[[:space:]]*level:[[:space:]]*none' "$cfg" || printf '%s\n' "service.telemetry.metrics.level is not none: the collector would serve its own metrics"
}

# ---- First run: gm init -------------------------------------------------------------------------------------
# The patron's answers live in guild.conf in the Guildhall, beside the settings, one "key: value" a line:
#   initialized: when a first run was completed (a choice made, or nothing optional missing)
#   collector: on | off | later, the patron's answer about the OpenTelemetry Collector, which is also the setting
#     that keeps it running (setup.conf, before, said installed or skipped)
#   collector-path / -version / -sha256 / -installed-at: what gm init installed, and where
# Everything gm init says goes to stderr, so it never mixes with the output of the command that triggered it.

gm_conf_get() { gm_setting "$(gm_conf_file)" "$1"; }

# The documentation guild.conf starts with, from GM_CONF_TABLE.
gm_conf_header() {
  local key env def kind desc vals
  printf '%s\n' "# Guildmaster configuration: one \"key: value\" a line; a line starting with # is a comment." \
    "# Ask the Guildmaster to change a setting, or run gm config set <key> <value>; gm config shows each setting, its" \
    "# value and where it came from. A variable named below, set in the environment, overrides its setting." \
    "#"
  while IFS=$'\t' read -r key env def kind desc; do
    case $kind in
      onoff) vals='on | off' ;;
      collector) vals='on | off | later' ;;
      chat) vals='off | banners' ;;
      text) vals='<folder> <folder> ...' ;;
      count) vals='<number>' ;;
      *) vals="<$kind>" ;;
    esac
    printf '# %s: %s' "$key" "$vals"
    [ "$def" = - ] || printf ', default %s' "$def"
    [ "$env" = - ] || printf '; %s overrides it' "$env"
    printf '\n#   %s\n' "$desc"
  done <<<"$GM_CONF_TABLE"
  printf '%s\n' "#" \
    "# gm also records here what it did: initialized (the first run), and the collector- lines (what gm init installed," \
    "# and when the Guildmaster last offered it)."
}

# One writer at a time, so two never lose each other's line. Gives up after 10 seconds and writes anyway; a lock
# left by a gm that is gone is broken.
gm_conf_lock() {
  local dir=$GM_HALL/conf.lock pid i=0
  mkdir -p "$GM_HALL"
  while ! mkdir "$dir" 2>/dev/null; do
    pid=$(cat "$dir/pid" 2>/dev/null || true)
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$dir/pid"
      rmdir "$dir" 2>/dev/null || true
      continue
    fi
    [ "$i" -lt 100 ] || return 1
    sleep 0.1
    i=$((i + 1))
  done
  printf '%s' "$$" >"$dir/pid"
}

gm_conf_unlock() {
  rm -f "$GM_HALL/conf.lock/pid"
  rmdir "$GM_HALL/conf.lock" 2>/dev/null || true
}

# gm_conf_set <key> [value]: replaces the key's line, or adds one at the end; a new file starts with the
# documentation. Without a value, the key's line goes, and the setting is back to its default.
gm_conf_set() {
  local key=$1 val=${2:-} tmp locked=''
  mkdir -p "$GM_HALL"
  ! gm_conf_lock || locked=1
  gm_conf_migrate_locked
  tmp=$GM_CONF.$$
  if [ -f "$GM_CONF" ]; then
    K=$key V=$val awk 'index($0, ENVIRON["K"] ":") == 1 { if (!d && ENVIRON["V"] != "") print ENVIRON["K"] ": " ENVIRON["V"]; d = 1; next }
      { print } END { if (!d && ENVIRON["V"] != "") print ENVIRON["K"] ": " ENVIRON["V"] }' "$GM_CONF" >"$tmp"
  else
    {
      gm_conf_header
      printf '\n'
      [ -z "$val" ] || printf '%s: %s\n' "$key" "$val"
    } >"$tmp"
  fi
  mv -f "$tmp" "$GM_CONF"
  [ -z "$locked" ] || gm_conf_unlock
  # The rest of this command sees the new value too, unless the environment overrides it.
  local k env def kind desc
  while IFS=$'\t' read -r k env def kind desc; do
    [ "$k" = "$key" ] && [ "$env" != - ] || continue
    case $GM_CONF_ENV in *" $env "*) continue ;; esac
    if [ -n "$val" ] && gm_conf_norm "$kind" "$val"; then
      printf -v "$env" '%s' "$GM_CONF_VAL"
    elif [ "$kind" = collector ]; then
      printf -v "$env" '%s' ''
    else
      printf -v "$env" '%s' "$def"
    fi
  done <<<"$GM_CONF_TABLE"
}

# Before guild.conf, the first-run answers and the few settings there were lived in setup.conf. The first gm command
# that needs the file moves them: every line is kept (the collector's installed and skipped become on and off) below
# the documentation, and setup.conf becomes setup.conf.old. Should both be there, guild.conf keeps its own lines and
# takes only the keys it lacks.
gm_conf_migrate() {
  [ -f "$GM_CONF_OLD" ] || return 0
  local locked=''
  ! gm_conf_lock || locked=1
  gm_conf_migrate_locked
  [ -z "$locked" ] || gm_conf_unlock
}

gm_conf_migrate_locked() {
  [ -f "$GM_CONF_OLD" ] || return 0
  local tmp=$GM_CONF.$$ k v
  if [ ! -f "$GM_CONF" ]; then
    {
      gm_conf_header
      printf '\n'
      awk '/^[[:space:]]*#/ || !NF { next }
        /^collector:[[:space:]]*installed[[:space:]]*$/ { print "collector: on"; next }
        /^collector:[[:space:]]*skipped[[:space:]]*$/ { print "collector: off"; next } { print }' "$GM_CONF_OLD"
    } >"$tmp"
    mv -f "$tmp" "$GM_CONF"
  else
    while IFS=$'\t' read -r k v; do
      [ -n "$k" ] && [ -z "$(gm_setting "$GM_CONF" "$k")" ] || continue
      case $k/$v in collector/installed) v=on ;; collector/skipped) v=off ;; esac
      printf '%s: %s\n' "$k" "$v" >>"$GM_CONF"
    done <<<"$(gm_conf_lines "$GM_CONF_OLD")"
  fi
  mv -f "$GM_CONF_OLD" "$GM_CONF_OLD.old" 2>/dev/null || true
}

gm_say() { printf '%s\n' "$*" >&2; }

# True when gm may ask the patron a question: both stdin and stderr are a terminal, or GM_INTERACTIVE=1
# (tests, which answer on stdin); GM_INTERACTIVE=0 forbids it.
gm_init_interactive() {
  case ${GM_INTERACTIVE:-} in
    1) return 0 ;;
    0) return 1 ;;
  esac
  [ -t 0 ] && [ -t 2 ]
}

# gm_ver_ge 3.51.0 3.38: whether the first dotted version is at least the second.
gm_ver_ge() {
  local a='' b='' x='' y=''
  IFS=. read -r a b _ <<<"$(printf '%s' "$1" | sed 's/[^0-9.].*//')"
  IFS=. read -r x y _ <<<"$2"
  [ "${a:-0}" -gt "${x:-0}" ] || { [ "${a:-0}" -eq "${x:-0}" ] && [ "${b:-0}" -ge "${y:-0}" ]; }
}

# What gm uses and whether it is there: one row a line, "id<TAB>required|optional<TAB>ok|missing|old<TAB>detail".
gm_init_probe() {
  local v p t missing='' claude=${GM_CLAUDE:-claude} herdr=${GM_HERDR:-herdr}
  printf 'bash\trequired\tok\tbash %s\n' "$BASH_VERSION"
  if v=$(sqlite3 --version 2>/dev/null | awk '{ print $1; exit }') && [ -n "$v" ]; then
    if gm_ver_ge "$v" 3.38 && [ "$(sqlite3 -batch :memory: "SELECT '{\"a\":1}'->>'a';" 2>/dev/null || true)" = 1 ]; then
      printf 'sqlite3\trequired\tok\tsqlite3 %s (JSON functions work)\n' "$v"
    else
      printf 'sqlite3\trequired\told\tsqlite3 %s: too old or without the JSON functions (needs 3.38 or later)\n' "$v"
    fi
  else
    printf 'sqlite3\trequired\tmissing\tsqlite3: not found\n'
  fi
  if v=$(git --version 2>/dev/null); then
    printf 'git\trequired\tok\t%s\n' "$v"
  else
    printf 'git\trequired\tmissing\tgit: not found\n'
  fi
  p=$(command -v "$claude" 2>/dev/null || true)
  if [ -n "$p" ]; then
    v=$("$claude" --version 2>/dev/null | head -n 1 || true)
    printf 'claude\trequired\tok\tClaude Code %s at %s\n' "${v:-(version not reported)}" "$p"
  else
    printf 'claude\trequired\tmissing\tClaude Code: %s not found on PATH\n' "$claude"
  fi
  p=$(command -v "$herdr" 2>/dev/null || true)
  if [ -n "$p" ]; then
    v=$("$herdr" --version 2>/dev/null | head -n 1 || true)
    printf 'herdr\trequired\tok\t%s at %s\n' "${v:-herdr (version not reported)}" "$p"
  else
    printf 'herdr\trequired\tmissing\therdr: %s not found on PATH\n' "$herdr"
  fi
  for t in sed awk tr head tail cut grep wc mktemp od find basename dirname readlink date env; do
    command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
  done
  if [ -z "$missing" ]; then
    printf 'tools\trequired\tok\tstandard tools (sed awk tr grep mktemp and the rest)\n'
  else
    printf 'tools\trequired\tmissing\tstandard tools missing:%s\n' "$missing"
  fi
  if command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 || command -v openssl >/dev/null 2>&1; then
    printf 'sha256\trequired\tok\ta SHA-256 tool\n'
  else
    printf 'sha256\trequired\tmissing\tno SHA-256 tool (sha256sum, shasum or openssl)\n'
  fi
  p=$(gm_otelcol)
  if [ -n "$p" ]; then
    v=$("$p" --version 2>/dev/null | head -n 1 || true)
    printf 'collector\toptional\tok\tOpenTelemetry Collector%s at %s\n' "${v:+ ($v)}" "$p"
  else
    printf 'collector\toptional\tmissing\totelcol-contrib (the OpenTelemetry Collector): not found\n'
  fi
}

# What a missing or old piece means, and what to do about it.
gm_init_meaning() {
  case $1 in
    bash) printf 'gm is a bash script; install bash 3.2 or later.' ;;
    sqlite3) printf 'the register is a sqlite3 file. Install sqlite3 3.38 or later (macOS: brew install sqlite; Debian or Ubuntu: apt install sqlite3).' ;;
    git) printf 'camps are git worktrees. Install git from your package manager.' ;;
    claude) printf 'gm open starts a Party Leader as a Claude Code session. Install Claude Code (https://docs.claude.com/en/docs/claude-code/overview) and put claude on your PATH, or set GM_CLAUDE.' ;;
    herdr) printf 'herdr, the terminal workspace manager, houses the Party Leaders and Adventurers. Install it from its official docs (https://herdr.dev/docs/install/): curl -fsSL https://herdr.dev/install.sh | sh, or brew install herdr, or mise use -g herdr; then check that herdr is on your PATH (or set GM_HERDR).' ;;
    tools) printf 'gm uses them in every command; install them from your package manager.' ;;
    sha256) printf 'gm fingerprints prompts and checks downloads with it; install coreutils, or openssl.' ;;
    collector) printf "tracing will record gm's own spans but not Claude Code's per-call model, tokens and cost; gm trace and gm stats still work, and cost is the status line's estimate." ;;
  esac
}

# "os arch" in the words of the OpenTelemetry Collector's release files; fails for a platform it has none for.
gm_otelcol_target() {
  local s=${GM_PLATFORM_OS:-$(uname -s)} m=${GM_PLATFORM_ARCH:-$(uname -m)} os arch
  case $s in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    *) return 1 ;;
  esac
  case $m in
    arm64 | aarch64) arch=arm64 ;;
    x86_64 | amd64) arch=amd64 ;;
    *) return 1 ;;
  esac
  printf '%s %s' "$os" "$arch"
}

# Installs the pinned collector into $1, with no sudo and nothing left behind on failure: the release file and its
# published SHA-256 are fetched into a temporary directory, checked, unpacked there, and only then copied next to
# its destination and renamed into place. Prints the installed path on stdout, and says what it did on stderr.
gm_init_install_collector() {
  local dir=$1 ver=$GM_OTELCOL_PINNED target os arch file base proto=https dest
  target=$(gm_otelcol_target) || {
    gm_say "  cannot install: the collector has no official build for $(uname -s) $(uname -m) that gm fetches; see README.md"
    return 1
  }
  read -r os arch <<<"$target"
  file=otelcol-contrib_${ver}_${os}_${arch}.tar.gz
  base=${GM_OTELCOL_BASE_URL:-https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v$ver}
  base=${base%/}
  case $base in file://*) proto='file' ;; esac
  dest=$dir/otelcol-contrib
  command -v curl >/dev/null 2>&1 || { gm_say "  cannot install: curl is not installed"; return 1; }
  command -v tar >/dev/null 2>&1 || { gm_say "  cannot install: tar is not installed"; return 1; }
  if [ -e "$dest" ]; then
    [ -x "$dest" ] || { gm_say "  cannot install: $dest exists and is not executable; move it away or choose another directory"; return 1; }
    gm_say "  $dest is already there; using it, downloading nothing"
    printf '%s' "$dest"
    return 0
  fi
  (
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/gm-otelcol.XXXXXX") || { gm_say "  cannot install: no temporary directory"; exit 1; }
    staged='' made='' placed=''
    # shellcheck disable=SC2329  # run by the EXIT trap
    cleanup() {
      [ -z "$staged" ] || rm -f -- "$staged"
      if [ -z "$placed" ] && [ -n "$made" ]; then
        d=$dir
        while [ "$d" != "$(dirname "$made")" ] && rmdir "$d" 2>/dev/null; do d=$(dirname "$d"); done
      fi
      case $tmp in */gm-otelcol.*) rm -rf -- "$tmp" ;; esac
    }
    trap cleanup EXIT
    trap 'exit 130' INT TERM HUP
    bad() { gm_say "  $1"; gm_say "  nothing was installed."; exit 1; }
    gm_say "  downloading $base/$file"
    curl -fsSL --proto "=$proto" --max-time 300 -o "$tmp/$file" "$base/$file" || bad "could not download $base/$file"
    curl -fsSL --proto "=$proto" --max-time 60 -o "$tmp/$file.sha256" "$base/$file.sha256" || bad "could not download the published checksum $base/$file.sha256"
    want=$(awk 'NR == 1 { print tolower($1) }' "$tmp/$file.sha256")
    [[ $want =~ ^[0-9a-f]{64}$ ]] || bad "the published checksum file is not a SHA-256: refusing to continue"
    got=$(gm_sha256_file "$tmp/$file")
    [ "$got" = "$want" ] || bad "REFUSED: the SHA-256 of $file is $got but the published checksum is $want"
    gm_say "  SHA-256 matches the published checksum: $got"
    tar -xzf "$tmp/$file" -C "$tmp" otelcol-contrib 2>/dev/null && [ -f "$tmp/otelcol-contrib" ] || bad "the release file does not contain otelcol-contrib"
    if [ ! -d "$dir" ]; then
      first=$dir
      while [ ! -d "$(dirname "$first")" ]; do first=$(dirname "$first"); done
      made=$first
      mkdir -p "$dir" || bad "could not make $dir (gm never uses sudo; choose a directory you own with --bin-dir)"
    fi
    staged=$dir/.otelcol-contrib.gm-$$
    cp "$tmp/otelcol-contrib" "$staged" 2>/dev/null || bad "could not write into $dir (gm never uses sudo; choose a directory you own with --bin-dir)"
    [ -x "$staged" ] || chmod u+x "$staged" || bad "could not make $staged executable"
    mv -f "$staged" "$dest" || bad "could not move the collector into place at $dest"
    staged=''
    placed=1
    gm_say "  installed $dest ($("$dest" --version 2>/dev/null | head -n 1 || true))"
    printf '%s\t%s' "$dest" "$got"
  )
}

# Reads one answer from stdin; prints the first letter it recognises among $2 (lower case), "l" at end of input,
# and after three unrecognised answers.
gm_init_ask() {
  local prompt=$1 valid=$2 ans n=0 c
  while [ "$n" -lt 3 ]; do
    printf '%s' "$prompt" >&2
    IFS= read -r ans || { printf 'l'; return 0; }
    [ -t 0 ] || printf '\n' >&2
    c=$(printf '%s' "${ans:-l}" | head -c 1 | tr '[:upper:]' '[:lower:]')
    case $c in y) c=i ;; n) c=s ;; esac
    case $valid in *"$c"*) printf '%s' "$c"; return 0 ;; esac
    gm_say "  please answer with one of: $valid"
    n=$((n + 1))
  done
  printf 'l'
}

# The collector question and its consequences. $1 mode (ask, yes, no, later), $2 1 to ask again about a skip, $3 a
# bin dir.
# Returns 0 when settled, 1 when an install failed (recorded as "later"), 2 when left undecided (no way to ask).
gm_init_collector() {
  local mode=$1 again=$2 dir=${3:-${GM_BIN_DIR:-$HOME/.local/bin}} cur choice='' out
  cur=${GM_COLLECTOR:-}
  gm_say ""
  gm_say "otelcol-contrib (the OpenTelemetry Collector, tracing slice 2, v$GM_OTELCOL_PINNED) is not installed."
  gm_say "  Without it, $(gm_init_meaning collector)"
  case $mode in
    yes) choice=i ;;
    no) choice=s ;;
    later) choice=l ;;
    *)
      if [ "$cur" = off ] && [ "$again" != 1 ]; then
        gm_say "  You chose to go without it on $(gm_conf_get initialized); not asking again (gm init --again changes that)."
        return 0
      fi
      if ! gm_init_interactive; then
        gm_say "  Not asking: this is not a terminal. gm init --yes installs it, gm init --no goes without it."
        return 2
      fi
      if gm_otelcol_target >/dev/null; then
        gm_say "  i  install it now: the official GitHub release, SHA-256 checked, into a directory you own, no sudo"
        gm_say "  s  skip it, I am fine without it"
        gm_say "  l  ask me again later (gm init asks again)"
        choice=$(gm_init_ask "Install, skip, or later? [i/s/l] " isl)
      else
        gm_say "  gm has no build of it for $(uname -s) $(uname -m); install it by hand (README.md) or skip it."
        gm_say "  s  skip it, I am fine without it"
        gm_say "  l  ask me again later"
        choice=$(gm_init_ask "Skip or later? [s/l] " sl)
      fi ;;
  esac
  case $choice in
    s)
      gm_conf_set collector off
      gm_say "  Skipped: collector: off, recorded in $GM_CONF; gm will not ask again, and gm doctor keeps saying so."
      return 0 ;;
    l)
      gm_conf_set collector later
      gm_say "  Later. gm init asks again, and so does the Guildmaster another day; nothing else changes."
      return 0 ;;
  esac
  if [ "$mode" = ask ] && [ -z "$3" ]; then
    local tilde='~' shown typed
    shown=${dir/#$HOME/$tilde}
    typed=$(gm_init_ask_dir "Install into [$shown]: ")
    if [ -n "$typed" ]; then
      case $typed in \~) typed=$HOME ;; \~/*) typed=$HOME/${typed#\~/} ;; esac
      case $typed in /*) dir=$typed ;; *) dir=$PWD/$typed ;; esac
    fi
  fi
  case $dir in /*) ;; *) dir=$PWD/$dir ;; esac
  gm_say "  Installing into $dir:"
  if out=$(gm_init_install_collector "$dir"); then
    local path=${out%%$'\t'*} sum=${out#*$'\t'}
    gm_conf_set collector on
    gm_conf_set collector-path "$path"
    gm_conf_set collector-version "$GM_OTELCOL_PINNED"
    [ "$sum" = "$out" ] || gm_conf_set collector-sha256 "$sum"
    gm_conf_set collector-installed-at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    case ":$PATH:" in
      *":$(dirname "$path"):"*) ;;
      *) gm_say "  $(dirname "$path") is not on your PATH. gm finds the collector through $GM_CONF; add the directory to PATH to run it yourself." ;;
    esac
    gm_say "  Done: $path. collector: on, recorded in $GM_CONF: gm keeps it running in herdr tab collector."
    return 0
  fi
  gm_conf_set collector later
  gm_say "  The install did not happen; gm init will offer it again."
  return 1
}

gm_init_ask_dir() {
  local ans=''
  printf '%s' "$1" >&2
  IFS= read -r ans || true
  [ -t 0 ] || printf '\n' >&2
  printf '%s' "$ans"
}

# The first-run check and the choices it asks for. $1 mode (ask, yes, no), $2 again, $3 bin dir, $4 auto.
gm_init_run() {
  local mode=$1 again=$2 dir=$3 auto=${4:-} id level state detail tag problems='' rc=0
  if [ -n "$auto" ]; then
    gm_say "gm: first run. Checking what gm needs; this happens once. gm init runs it again, gm doctor shows the state."
  else
    gm_say "gm: checking what gm needs."
  fi
  while IFS=$'\t' read -r id level state detail; do
    [ -n "$id" ] || continue
    case $state in
      ok) tag=ok ;;
      *) if [ "$level" = required ]; then tag=MISSING; else tag=missing; fi ;;
    esac
    gm_say "$(printf '  %-8s %s' "$tag" "$detail")"
    if [ "$state" != ok ] && [ "$level" = required ]; then
      problems="${problems}  $detail: $(gm_init_meaning "$id")
"
    fi
  done <<<"$(gm_init_probe)"
  if [ -n "$problems" ]; then
    gm_die "init: gm cannot run without what is missing above; nothing was changed. Fix these, then run gm init again:
${problems%
}"
  fi
  if [ -z "$(gm_otelcol)" ]; then
    gm_init_collector "$mode" "$again" "$dir" || rc=$?
  fi
  if [ "$rc" = 2 ]; then
    gm_say ""
    gm_say "Nothing was recorded; gm asks on the first run in a terminal."
    return 0
  fi
  if [ -z "$(gm_conf_get initialized)" ] || [ "$mode" != ask ]; then
    gm_conf_set initialized "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  fi
  gm_say ""
  gm_say "Setup recorded in $GM_CONF. gm will not ask again unprompted; gm doctor reports the state, gm init changes it."
  return "$rc"
}

gm_cmd_init() {
  local mode=ask again=0 dir=''
  while [ $# -gt 0 ]; do
    case $1 in
      --yes | -y) mode=yes; shift ;;
      --no | -n) mode=no; shift ;;
      --later) mode=later; shift ;;
      --again) again=1; shift ;;
      --bin-dir) dir=${2:?--bin-dir needs a directory}; shift 2 ;;
      *) gm_die "init: unknown argument $1 (gm init [--yes | --no | --later] [--again] [--bin-dir DIR])" ;;
    esac
  done
  local rc=0
  gm_init_run "$mode" "$again" "$dir" || rc=$?
  gm_init_muster
  return "$rc"
}

# The first run, started by the first interactive gm command that needs the Guildhall. It never runs without a
# terminal to answer it, and never in a hook, so nothing blocks.
gm_init_auto() {
  [ -z "$(gm_conf_get initialized)" ] || return 0
  gm_init_interactive || return 0
  gm_init_run ask 0 '' auto || true
}

# ---- gm config: the settings in guild.conf ----

# Every setting as gm uses it: key<TAB>value<TAB>source, the source being environment (VAR), the file's name,
# default, or "ignored: ..." when the file gives a value gm cannot take (the default is used then). No value is -.
gm_conf_effective_all() {
  local lines key env def kind desc k v val src file
  file=$(basename "$(gm_conf_file)")
  lines=$(gm_conf_lines)
  while IFS=$'\t' read -r key env def kind desc; do
    if [ "$env" != - ] && case $GM_CONF_ENV in *" $env "*) true ;; *) false ;; esac; then
      printf '%s\t%s\tenvironment (%s)\n' "$key" "${!env}" "$env"
      continue
    fi
    val=''
    while IFS=$'\t' read -r k v; do
      [ "$k" != "$key" ] || { val=$v; break; }
    done <<<"$lines"
    [ "$def" != - ] || def=''
    if [ -z "$val" ]; then
      src=default
      val=$def
    elif gm_conf_norm "$kind" "$val"; then
      src=$file
      val=$GM_CONF_VAL
    else
      src="ignored: $file says '$val', which a $key setting cannot take"
      val=$def
    fi
    printf '%s\t%s\t%s\n' "$key" "${val:--}" "$src"
  done <<<"$GM_CONF_TABLE"
}

# gm_conf_row <key>: env<TAB>default<TAB>kind<TAB>description of one setting; nothing for an unknown key.
gm_conf_row() {
  local key env def kind desc
  while IFS=$'\t' read -r key env def kind desc; do
    [ "$key" != "$1" ] || { printf '%s\t%s\t%s\t%s' "$env" "$def" "$kind" "$desc"; return 0; }
  done <<<"$GM_CONF_TABLE"
}

gm_conf_keys() { printf '%s\n' "$GM_CONF_TABLE" | cut -f 1 | tr '\n' ' ' | sed 's/ $//'; }

# gm config shows every setting, its value and where it came from; gm config get prints one value; gm config set
# changes one in guild.conf, as the Guildmaster does when the patron asks in plain words, and acts on it at once
# (autostart and the collector); gm config unset puts one back to its default.
gm_cmd_config() {
  local action=${1:-show} key val src env def kind desc row file
  [ $# -eq 0 ] || shift
  gm_conf_migrate
  file=$(gm_conf_file)
  case $action in
    show | list)
      [ $# -eq 0 ] || gm_die "config: gm config takes no arguments (gm config get|set|unset <key>)"
      printf 'Settings, from %s (gm config set <key> <value> changes one):\n' "$file"
      while IFS=$'\t' read -r key val src; do
        [ "$key/$val" != repo-roots/- ] || val='(the usual source folders)'
        [ "$key/$src" != collector/default ] || src='default (not decided yet)'
        printf '  %-23s %-9s %s\n' "$key" "$val" "$src"
      done <<<"$(gm_conf_effective_all)"
      ;;
    get)
      [ $# -eq 1 ] || gm_die "config: gm config get <key>"
      [ -n "$(gm_conf_row "$1")" ] || gm_die "config: no setting named '$1'; the settings are: $(gm_conf_keys)"
      while IFS=$'\t' read -r key val src; do
        [ "$key" = "$1" ] || continue
        [ "$val" = - ] || printf '%s\n' "$val"
      done <<<"$(gm_conf_effective_all)"
      ;;
    set | unset)
      key=${1:-}
      [ -n "$key" ] || gm_die "config: gm config set <key> <value>, or gm config unset <key>"
      shift
      row=$(gm_conf_row "$key")
      [ -n "$row" ] || gm_die "config: no setting named '$key'; the settings are: $(gm_conf_keys)"
      IFS=$'\t' read -r env def kind desc <<<"$row"
      val=''
      if [ "$action" = set ]; then
        [ $# -ge 1 ] || gm_die "config: gm config set $key <value>"
        val="$*"
        [ "$kind" = text ] || [ $# -eq 1 ] || gm_die "config: $key takes one value"
        gm_conf_norm "$kind" "$val" || gm_die "config: $key cannot be '$val' ($(gm_conf_header | sed -n "s/^# $key: \\([^,;]*\\).*/\\1/p"))"
        val=$GM_CONF_VAL
      else
        [ $# -eq 0 ] || gm_die "config: gm config unset <key>"
      fi
      gm_conf_apply "$key" "$val"
      if [ "$env" != - ] && case $GM_CONF_ENV in *" $env "*) true ;; *) false ;; esac; then
        printf 'Note: %s=%s is set in this environment, and overrides it for the commands run there.\n' "$env" "${!env}"
      fi
      ;;
    *) gm_die "config: gm config [get <key> | set <key> <value> | unset <key>]" ;;
  esac
}

# gm_conf_apply <key> [value]: records the setting, acts on it, and says so in one line. Autostart is turned on or
# off; the collector is started or stopped at once; a new port restarts it; the rest takes effect at the next muster,
# or the next session gm starts.
gm_conf_apply() {
  local key=$1 val=${2:-} shown
  shown=${val:-its default}
  case $key in
    autostart)
      if [ "$(uname -s)" = Darwin ]; then
        gm_cmd_autostart "${val:-on}"
        [ -n "$val" ] || gm_conf_set autostart
        return
      fi
      gm_conf_set autostart "$val"
      printf 'autostart is %s in guild.conf; launchd is macOS'"'"'s, so here Party Leaders come back whenever gm runs.\n' "${val:-on}"
      return ;;
    autostart-every)
      gm_conf_set "$key" "$val"
      if [ "$(uname -s)" = Darwin ] && [ "$(gm_conf_get autostart)" != off ] && command -v "$GM_HERDR" >/dev/null 2>&1; then
        gm_autostart_install "$(gm_autostart_every)" >/dev/null || gm_die "config: recorded, but launchd would not take the new interval"
      fi
      printf 'autostart-every is %s: the launchd agent runs the muster every %s minutes.\n' "$shown" "$(gm_autostart_every)"
      return ;;
  esac
  gm_conf_set "$key" "$val"
  case $key in
    collector | collector-port)
      gm_collector_apply "$key"
      return ;;
    telemetry) printf 'telemetry is %s: Party Leaders started from now on %s; running ones keep what they started with.\n' "$shown" \
      "$([ "${GM_TELEMETRY:-on}" = off ] && printf 'send no telemetry' || printf 'send telemetry to the collector')" ;;
    chat) printf 'chat is %s: the Guildmaster and Party Leaders started from now on %s; running ones keep what they started with.\n' "$shown" \
      "$([ "${GM_CHAT:-banners}" = off ] && printf "draw Claude Code's own chat" || printf 'draw their chat under heraldic banners')" ;;
    repo-roots) printf 'repo-roots is %s: gm repos looks for clones %s.\n' "$shown" "$([ -n "$val" ] && printf 'there' || printf 'in the usual source folders')" ;;
    *) printf '%s is %s; it takes effect at the next muster.\n' "$key" "$shown" ;;
  esac
}

gm_cmd_doctor() {
  [ $# -eq 0 ] || gm_die "doctor: gm doctor takes no arguments"
  local fails=0 ep code bin cfg line pending=0 f n
  gm_doc() {
    printf '%-5s %s\n' "$1" "$2"
    [ "$1" != FAIL ] || fails=$((fails + 1))
  }
  local skipped=0 id level state detail
  [ "${GM_COLLECTOR:-}" != off ] || skipped=1
  gm_doc ok "register schema $(gm_sql 'PRAGMA user_version;') at $GM_DB"
  if [ -n "$(gm_conf_get initialized)" ]; then
    gm_doc ok "first-run setup done $(gm_conf_get initialized) ($GM_CONF)"
  else
    gm_doc warn "first-run setup not done: run gm init"
  fi
  while IFS=$'\t' read -r id level state detail; do
    case $state in ignored*) gm_doc warn "guild.conf: $id: ${state#ignored: }; using $level" ;; esac
  done <<<"$(gm_conf_effective_all)"
  case ${GM_COLLECTOR:-} in
    on)
      IFS=$'\t' read -r state detail <<<"$(gm_endpoint_state collector 2>/dev/null)"
      if [ "$state" = alive ]; then gm_doc ok "collector: on, kept running by the muster in herdr tab collector"
      else gm_doc warn "collector: on, but the collector gm keeps running is ${state:-not started} (${detail:-gm up starts it})"; fi ;;
    *) gm_doc ok "collector: ${GM_COLLECTOR:-not decided}: gm keeps no collector running (gm config set collector on)" ;;
  esac
  while IFS=$'\t' read -r id level state detail; do
    [ "$id" != collector ] || continue
    if [ "$state" = ok ]; then gm_doc ok "$detail"; else gm_doc FAIL "$detail: $(gm_init_meaning "$id")"; fi
  done <<<"$(gm_init_probe)"
  ep=$(gm_otel_endpoint)
  if [ "${GM_TELEMETRY:-on}" = off ]; then
    gm_doc warn "GM_TELEMETRY=off: gm open starts sessions without telemetry"
  fi
  if gm_is_loopback "$ep"; then gm_doc ok "telemetry endpoint $ep is loopback"; else gm_doc FAIL "telemetry endpoint $ep is not loopback (GM_OTEL_ENDPOINT); gm open refuses it"; fi
  while IFS= read -r line; do
    [ -z "$line" ] || gm_doc FAIL "Claude Code settings send telemetry elsewhere: $line"
  done <<<"$(gm_settings_offenders)"
  for n in OTEL_EXPORTER_OTLP_ENDPOINT OTEL_EXPORTER_OTLP_TRACES_ENDPOINT OTEL_EXPORTER_OTLP_LOGS_ENDPOINT OTEL_EXPORTER_OTLP_METRICS_ENDPOINT; do
    eval "line=\${$n:-}"
    [ -z "$line" ] || gm_is_loopback "$line" || gm_doc warn "this shell sets $n=$line; gm open replaces it for the sessions it starts, other Claude Code sessions still use it"
  done
  cfg=$(gm_collector_config)
  if [ ! -f "$cfg" ]; then
    gm_doc FAIL "no collector configuration at $cfg"
  else
    local problems
    problems=$(gm_collector_config_problems "$cfg")
    if [ -z "$problems" ]; then
      gm_doc ok "collector configuration $cfg: listens on loopback only, exports to files only"
    else
      while IFS= read -r line; do gm_doc FAIL "collector configuration $cfg: $line"; done <<<"$problems"
    fi
  fi
  bin=$(gm_otelcol)
  if [ -z "$bin" ]; then
    if [ "$skipped" = 1 ]; then
      gm_doc warn "no OpenTelemetry Collector: you chose to go without it; $(gm_init_meaning collector) gm init --again changes that"
    else
      gm_doc FAIL "no OpenTelemetry Collector found: install otelcol-contrib (gm init, or README.md) or set GM_OTELCOL"
    fi
  else
    gm_doc ok "collector $bin ($("$bin" --version 2>/dev/null | head -n 1))"
    if [ -f "$cfg" ]; then
      if line=$(GM_HALL=$GM_HALL "$bin" validate --config "$cfg" 2>&1); then gm_doc ok "the collector accepts its configuration"; else gm_doc FAIL "the collector rejects $cfg: $(printf '%s' "$line" | tail -n 1)"; fi
    fi
  fi
  if gm_is_loopback "$ep"; then
    code=$(gm_otlp_status "$ep")
    if [ "$code" = 200 ]; then gm_doc ok "a collector answers at $ep"
    elif [ "$skipped" = 1 ] && [ -z "$bin" ]; then gm_doc warn "no collector answers at $ep (skipped, see above)"
    else gm_doc FAIL "no collector answers at $ep${code:+ (HTTP $code)}: start it with gm collector"; fi
  fi
  if [ -d "$GM_HALL/telemetry" ]; then
    for f in "$GM_HALL"/telemetry/*.jsonl; do
      [ -f "$f" ] || continue
      n=$(awk -F '\t' -v p="$f" '$3 == p { o = $2 } END { print o + 0 }' "$GM_HALL/telemetry/imported/offsets" 2>/dev/null || echo 0)
      case $f in */metrics*) ;; *) pending=$((pending + $(wc -c <"$f") - n)) ;; esac
    done
    gm_doc ok "telemetry files under $GM_HALL/telemetry; $pending bytes not imported yet (gm trace import)"
  else
    gm_doc warn "no telemetry under $GM_HALL/telemetry yet"
  fi
  n=0
  [ ! -f "$GM_HALL/spans-dropped.log" ] || n=$(grep -c . "$GM_HALL/spans-dropped.log" || true)
  [ "$n" = 0 ] || gm_doc warn "$n spans could not be written (see $GM_HALL/spans-dropped.log)"
  [ "$fails" = 0 ] || exit 1
}

# SQL: the JSON object of an OTLP attribute list (an array of {key, value}), as flat dotted keys.
gm_otlp_attrs() {
  printf "(SELECT json_group_object(a.value->>'key', CASE WHEN a.value->'value'->>'stringValue' IS NOT NULL THEN a.value->'value'->>'stringValue' WHEN a.value->'value'->>'intValue' IS NOT NULL THEN CAST(a.value->'value'->>'intValue' AS INTEGER) WHEN a.value->'value'->>'doubleValue' IS NOT NULL THEN a.value->'value'->>'doubleValue' WHEN a.value->'value'->'boolValue' IS NOT NULL THEN a.value->'value'->'boolValue' ELSE a.value->'value' END) FROM json_each(%s) a)" "$1"
}

# SQL: a model name without Anthropic's date suffix, so an event's claude-haiku-4-5-20251001 and a span's
# claude-haiku-4-5 are one model.
gm_model_sql() {
  printf "CASE WHEN %s GLOB '*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]' THEN substr(%s,1,length(%s)-9) ELSE %s END" "$1" "$1" "$1" "$1"
}

# Appends the complete lines of telemetry file $1, from byte $2, to the JSON array being built in $3;
# prints the offset after the last complete line. A line the collector is still writing waits for next time.
gm_jsonl_take() {
  local f=$1 off=$2 out=$3 size n complete
  size=$(wc -c <"$f" | tr -d ' ')
  if ! gm_is_int "$off" || [ "$off" -gt "$size" ]; then off=0; fi
  if [ "$off" -ge "$size" ]; then
    printf '%s' "$off"
    return 0
  fi
  tail -c +"$((off + 1))" "$f" | head -c "$((size - off))" >"$out.chunk"
  n=$(wc -c <"$out.chunk" | tr -d ' ')
  complete=$n
  if [ "$(tail -c 1 "$out.chunk" | od -An -c | tr -d ' ')" != '\n' ]; then
    complete=$((n - $(tail -n 1 "$out.chunk" | wc -c)))
  fi
  head -c "$complete" "$out.chunk" | sed -e '/^[[:space:]]*$/d' -e 's/$/,/' >>"$out"
  rm -f "$out.chunk"
  printf '%s' "$((off + complete))"
}

# gm trace import: folds the telemetry files not yet read into the register. Each file is read from where
# the last import stopped (by inode, so a rotated file is found again); a rotated file read to its end
# moves to telemetry/imported/, and files there are deleted 14 days after import.
gm_telemetry_import() {
  local quiet=${1:-} dir=$GM_HALL/telemetry
  if [ ! -d "$dir" ]; then
    [ -n "$quiet" ] || printf 'No telemetry under %s yet: run gm collector, then start a session with gm open.\n' "$dir"
    return 0
  fi
  mkdir -p "$dir/imported" "$GM_HALL/tmp"
  local lock=$dir/imported/.lock rc=0
  if ! mkdir "$lock" 2>/dev/null; then
    # A lock older than ten minutes was left by an import that died.
    if [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ] && rmdir "$lock" 2>/dev/null && mkdir "$lock" 2>/dev/null; then :; else
      [ -n "$quiet" ] || printf 'Another gm trace import is running.\n'
      return 0
    fi
  fi
  local work
  work=$(mktemp -d "$GM_HALL/tmp/import.XXXXXX") || { rmdir "$lock"; return 1; }
  (gm_telemetry_import_locked "$quiet" "$work") || rc=$?
  rm -rf -- "${work:?}"
  rmdir "$lock" 2>/dev/null || true
  return "$rc"
}

gm_telemetry_import_locked() {
  local quiet=$1 work=$2 dir=$GM_HALL/telemetry sig f ino off new size moved='' out
  local offsets=$dir/imported/offsets
  : >"$work/offsets"
  for sig in traces logs; do
    printf '[' >"$work/$sig.json"
    for f in "$dir/$sig"-*.jsonl "$dir/$sig.jsonl"; do
      [ -f "$f" ] || continue
      # shellcheck disable=SC2012 # ls -i is the portable way to read an inode; the name is quoted
      ino=$(ls -i "$f" | awk '{print $1}')
      off=$(awk -F '\t' -v i="$ino" '$1 == i { o = $2 } END { print o }' "$offsets" 2>/dev/null || true)
      new=$(gm_jsonl_take "$f" "$off" "$work/$sig.json") || return 1
      size=$(wc -c <"$f" | tr -d ' ')
      if [ "$f" != "$dir/$sig.jsonl" ] && [ "$new" -ge "$size" ]; then
        moved="$moved$f"$'\n'
      else
        printf '%s\t%s\t%s\n' "$ino" "$new" "$f" >>"$work/offsets"
      fi
    done
    printf 'null]' >>"$work/$sig.json"
  done
  printf '[' >"$work/metrics.json"
  for f in "$dir"/metrics-*.jsonl "$dir/metrics.jsonl"; do
    [ ! -f "$f" ] || gm_jsonl_take "$f" 0 "$work/metrics.json" >/dev/null || return 1
  done
  printf 'null]' >>"$work/metrics.json"
  if ! sqlite3 -bail -batch "$work/stage.db" >/dev/null 2>"$work/err" <<SQL
$(gm_telemetry_stage_sql "$work")
SQL
  then
    printf 'gm: trace import could not read the telemetry files: %s\n' "$(head -n 3 "$work/err")" >&2
    return 1
  fi
  gm_redact json <"$work/texts.bin" >"$work/red.json" || return 1
  if ! out=$(gm_sql 2>"$work/err" <<SQL
$(gm_telemetry_fold_sql "$work")
SQL
  ); then
    printf 'gm: trace import failed, and nothing was imported (the files are read again next time): %s\n' "$(head -n 3 "$work/err")" >&2
    return 1
  fi
  mv "$work/offsets" "$offsets"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    mv "$f" "$dir/imported/" && touch "$dir/imported/$(basename "$f")"
  done <<<"$moved"
  find "$dir/imported" -type f -name '*.jsonl' -mtime +14 -exec rm -f {} + 2>/dev/null || true
  if [ -z "$quiet" ]; then
    printf '%s\n' "$out"
    gm_sql <<SQL || true
$(gm_telemetry_reconcile_sql "$work")
SQL
  fi
}

# Stage SQL, run in a scratch database: the batch's spans (cs) and events (ce), flat, without identity,
# and the texts to mask (texts.bin, each text ended by \036, in key order).
gm_telemetry_stage_sql() {
  local w=$1
  cat <<SQL
CREATE TABLE cs AS
SELECT tid, sid, pid, name, start_ms, end_ms, code, events, json_remove(attrs, $GM_OTEL_IDENTITY) AS attrs, NULL AS prompt FROM (
  SELECT sp.value->>'traceId' AS tid, sp.value->>'spanId' AS sid, NULLIF(sp.value->>'parentSpanId','') AS pid, sp.value->>'name' AS name,
         CAST(sp.value->>'startTimeUnixNano' AS INTEGER)/1000000 AS start_ms, CAST(sp.value->>'endTimeUnixNano' AS INTEGER)/1000000 AS end_ms,
         COALESCE(sp.value->'status'->>'code', 0) AS code, COALESCE(sp.value->'events', '[]') AS events,
         json_patch($(gm_otlp_attrs "rs.value->'resource'->'attributes'"), $(gm_otlp_attrs "sp.value->'attributes'")) AS attrs
  FROM json_each(CAST(readfile($(gm_q "$w/traces.json")) AS TEXT)) b, json_each(b.value->'resourceSpans') rs,
       json_each(rs.value->'scopeSpans') ss, json_each(ss.value->'spans') sp
  WHERE b.type='object');
DELETE FROM cs WHERE rowid NOT IN (SELECT MIN(rowid) FROM cs GROUP BY tid, sid);
CREATE TABLE ce AS
SELECT ROW_NUMBER() OVER (ORDER BY t_ms, seq) AS n, * FROM (
  SELECT t_ms, tid, sid, COALESCE($(gm_a event.name), replace(body,'claude_code.','')) AS name, $(gm_a event.sequence) AS seq, attrs FROM (
    SELECT CAST(lr.value->>'timeUnixNano' AS INTEGER)/1000000 AS t_ms, NULLIF(lr.value->>'traceId','') AS tid, NULLIF(lr.value->>'spanId','') AS sid,
           lr.value->'body'->>'stringValue' AS body,
           json_remove(json_patch($(gm_otlp_attrs "rs.value->'resource'->'attributes'"), $(gm_otlp_attrs "lr.value->'attributes'")), $GM_OTEL_IDENTITY) AS attrs
    FROM json_each(CAST(readfile($(gm_q "$w/logs.json")) AS TEXT)) b, json_each(b.value->'resourceLogs') rs,
         json_each(rs.value->'scopeLogs') ss, json_each(ss.value->'logRecords') lr
    WHERE b.type='object'))
WHERE name IN ('user_prompt','assistant_response','api_request','api_error','api_retries_exhausted','api_refusal','compaction','subagent_completed','tool_result');
DELETE FROM ce WHERE rowid NOT IN (SELECT MIN(rowid) FROM ce GROUP BY name, $(gm_a session.id), seq, t_ms);
-- A span's prompt: its own, an event's that ran inside it, its model call's or tool call's event, or its parent's.
UPDATE cs SET prompt=COALESCE($(gm_a prompt.id cs.attrs),
  (SELECT $(gm_a prompt.id e.attrs) FROM ce e WHERE e.tid=cs.tid AND e.sid=cs.sid AND $(gm_a prompt.id e.attrs) IS NOT NULL ORDER BY e.n LIMIT 1),
  (SELECT $(gm_a prompt.id e.attrs) FROM ce e WHERE e.name='api_request' AND $(gm_a request_id e.attrs)=$(gm_a request_id cs.attrs)),
  (SELECT $(gm_a prompt.id e.attrs) FROM ce e WHERE e.name='tool_result' AND $(gm_a tool_use_id e.attrs)=$(gm_a tool_use_id cs.attrs)));
UPDATE cs SET prompt=(SELECT p.prompt FROM cs p WHERE p.tid=cs.tid AND p.sid=cs.pid) WHERE prompt IS NULL;
UPDATE cs SET prompt=(SELECT p.prompt FROM cs p WHERE p.tid=cs.tid AND p.sid=cs.pid) WHERE prompt IS NULL;
UPDATE cs SET prompt=(SELECT c.prompt FROM cs c WHERE c.tid=cs.tid AND c.pid=cs.sid AND c.prompt IS NOT NULL LIMIT 1) WHERE prompt IS NULL;
UPDATE cs SET prompt=(SELECT p.prompt FROM cs p WHERE p.tid=cs.tid AND p.sid=cs.pid) WHERE prompt IS NULL;
CREATE TABLE texts(k INTEGER PRIMARY KEY, kind TEXT NOT NULL, ref TEXT NOT NULL, body TEXT NOT NULL);
INSERT INTO texts(kind, ref, body)
  SELECT 'command', tid||':'||sid, $(gm_a full_command) FROM cs WHERE name='claude_code.tool' AND $(gm_a full_command) IS NOT NULL
  UNION ALL
  SELECT 'prompt', n, COALESCE($(gm_a prompt), $(gm_a prompt_text)) FROM ce WHERE name='user_prompt' AND COALESCE($(gm_a prompt), $(gm_a prompt_text)) NOT IN ('', '<REDACTED>')
  UNION ALL
  SELECT 'response', n, $(gm_a response) FROM ce WHERE name='assistant_response' AND $(gm_a response) NOT IN ('', '<REDACTED>');
SELECT writefile($(gm_q "$w/texts.bin"), COALESCE((SELECT group_concat(t, '') FROM (SELECT replace(body, char(30), ' ')||char(30) AS t FROM texts ORDER BY k)), ''));
SQL
}

# SQL: the attributes a Claude Code span takes in the register, by the mapping in tracing-design.md:
# its own keys without identity and raw text, plus the GenAI and guild names. Columns of "c": the cs row.
gm_cc_span_attrs() {
  local llm="c.name='claude_code.llm_request'" tool="c.name='claude_code.tool'" ia="c.name='claude_code.interaction'" m
  m=$(gm_model_sql "COALESCE($(gm_a model c.attrs), $(gm_a gen_ai.request.model c.attrs))")
  printf "json_patch(json_remove(c.attrs, %s), %s)" "$GM_OTEL_CONTENT" "$(gm_jobj \
    gen_ai.operation.name "CASE WHEN $ia THEN 'invoke_agent' WHEN $llm THEN 'chat' WHEN $tool THEN 'execute_tool' END" \
    gen_ai.provider.name "CASE WHEN $llm THEN 'anthropic' END" \
    gen_ai.agent.name "CASE WHEN $ia THEN COALESCE($(gm_a guild.role c.attrs),'party-leader') END" \
    gen_ai.conversation.id "CASE WHEN $ia THEN $(gm_a session.id c.attrs) END" \
    gen_ai.request.model "CASE WHEN $llm THEN $m END" \
    gen_ai.response.id "CASE WHEN $llm THEN $(gm_a request_id c.attrs) END" \
    gen_ai.response.finish_reasons "CASE WHEN $llm AND $(gm_a stop_reason c.attrs) IS NOT NULL THEN json_array($(gm_a stop_reason c.attrs)) END" \
    gen_ai.usage.input_tokens "CASE WHEN $llm THEN $(gm_a input_tokens c.attrs)+COALESCE($(gm_a cache_read_tokens c.attrs),0)+COALESCE($(gm_a cache_creation_tokens c.attrs),0) END" \
    gen_ai.usage.output_tokens "CASE WHEN $llm THEN $(gm_a output_tokens c.attrs) END" \
    gen_ai.usage.cache_read.input_tokens "CASE WHEN $llm THEN $(gm_a cache_read_tokens c.attrs) END" \
    gen_ai.usage.cache_write.input_tokens "CASE WHEN $llm THEN $(gm_a cache_creation_tokens c.attrs) END" \
    gen_ai.request.reasoning.level "$(gm_a effort c.attrs)" \
    guild.ttft_ms "$(gm_a ttft_ms c.attrs)" \
    guild.attempt "$(gm_a attempt c.attrs)" \
    error.type "CASE WHEN $(gm_a success c.attrs) IN (0,'false') THEN COALESCE($(gm_a error c.attrs),'error') END" \
    gen_ai.tool.name "CASE WHEN $tool THEN $(gm_a tool_name c.attrs) END" \
    gen_ai.tool.call.id "$(gm_a tool_use_id c.attrs)" \
    mcp.method.name "CASE WHEN $tool AND $(gm_a tool_name c.attrs) LIKE 'mcp\\_\\_%' ESCAPE '\\' THEN 'tools/call' END" \
    guild.mcp.server "CASE WHEN $tool AND $(gm_a tool_name c.attrs) LIKE 'mcp\\_\\_%' ESCAPE '\\' THEN substr($(gm_a tool_name c.attrs),6,instr(substr($(gm_a tool_name c.attrs),6),'__')-1) END" \
    guild.tool.command "(SELECT body FROM red WHERE kind='command' AND ref=c.tid||':'||c.sid)" \
    prompt.id "c.prompt" \
    events "(SELECT NULLIF(json_group_array(json_object('name',e.value->>'name','time_ms',CAST(e.value->>'timeUnixNano' AS INTEGER)/1000000,'attempt',$(gm_otlp_attrs "e.value->'attributes'")->>'attempt')),'[]')
             FROM json_each(c.events) e WHERE CAST($(gm_otlp_attrs "e.value->'attributes'")->>'attempt' AS INTEGER)>1)" \
    guild.source "'claude_code'")"
}

gm_cc_span_name() {
  printf "CASE c.name WHEN 'claude_code.interaction' THEN 'invoke_agent '||COALESCE(%s,'party-leader') WHEN 'claude_code.llm_request' THEN 'chat '||replace(%s,'claude-','') WHEN 'claude_code.tool' THEN 'execute_tool '||COALESCE(%s,'?') ELSE c.name END" \
    "$(gm_a guild.role c.attrs)" "$(gm_model_sql "COALESCE($(gm_a model c.attrs), $(gm_a gen_ai.request.model c.attrs), 'model')")" "$(gm_a tool_name c.attrs)"
}

# SQL: the attributes an api_request event gives its chat span. Columns of "e": the ce row.
gm_cc_call_attrs() {
  gm_jobj gen_ai.operation.name "'chat'" gen_ai.provider.name "'anthropic'" \
    gen_ai.request.model "$(gm_model_sql "$(gm_a model e.attrs)")" \
    gen_ai.response.id "$(gm_a request_id e.attrs)" \
    gen_ai.usage.input_tokens "$(gm_a input_tokens e.attrs)+COALESCE($(gm_a cache_read_tokens e.attrs),0)+COALESCE($(gm_a cache_creation_tokens e.attrs),0)" \
    gen_ai.usage.output_tokens "$(gm_a output_tokens e.attrs)" \
    gen_ai.usage.cache_read.input_tokens "$(gm_a cache_read_tokens e.attrs)" \
    gen_ai.usage.cache_write.input_tokens "$(gm_a cache_creation_tokens e.attrs)" \
    gen_ai.request.reasoning.level "$(gm_a effort e.attrs)" \
    guild.cost.usd "$(gm_a cost_usd e.attrs)" \
    guild.ttft_ms "$(gm_a ttft_ms e.attrs)" \
    guild.query_source "$(gm_a query_source e.attrs)" \
    session.id "$(gm_a session.id e.attrs)" prompt.id "$(gm_a prompt.id e.attrs)" agent_id "$(gm_a agent_id e.attrs)" \
    guild.focus "$(gm_a guild.focus e.attrs)" guild.role "$(gm_a guild.role e.attrs)" \
    guild.source "'claude_code'"
}

# SQL adding the masked text of key $2 to the spans (or open spans, table $1) it belongs to, once.
gm_cc_text_sql() {
  local x
  x="json_extract($1.attrs, '\$.\"$2\"')"
  cat <<SQL
UPDATE $1 SET attrs=json_set($1.attrs, '\$."$2"', CASE WHEN $x IS NULL THEN t.body WHEN instr($x, t.body)>0 THEN $x ELSE $x||char(10)||char(10)||t.body END)
  FROM (SELECT at, body FROM txt1 WHERE k='$2') t WHERE $1.trace_id||' '||$1.span_id=t.at;
SQL
}

# SQL: "trace_id span_id" of the span an event about session $1, prompt $2 (SQL expressions) belongs to:
# the turn, else its exchange, else the session.
gm_cc_fallback_sql() {
  printf "COALESCE((SELECT trace_id||' '||span_id FROM anc WHERE kind='turn' AND k1=%s AND k2=%s), (SELECT trace_id||' '||span_id FROM anc WHERE kind='exchange' AND k1=%s AND k2=%s), (SELECT trace_id||' '||span_id FROM anc WHERE kind='session' AND k1=%s AND k2=''))" \
    "$1" "$2" "$1" "$2" "$1"
}

# The resolution of one Claude Code span, given its parent's place in the register (SQL for the
# parent's trace and span id; NULL when it has none). See gm_telemetry_fold_sql.
gm_cc_act() {
  printf "CASE WHEN c.m_sid IS NOT NULL THEN 'merge' WHEN c.name IN ('claude_code.tool.execution','claude_code.tool.blocked_on_user') THEN CASE WHEN %s IS NULL THEN 'skip' ELSE 'fold' END ELSE 'insert' END" "$2"
}
gm_cc_att() {
  # $1 parent's trace, $2 parent's span, $3 tid or sid: which of the place to give
  local p=$2
  [ "$3" = sid ] || p=$1
  printf "CASE WHEN c.a_sid IS NOT NULL THEN c.a_%s WHEN %s IS NOT NULL THEN %s WHEN c.f_sid IS NOT NULL THEN c.f_%s END" "$3" "$2" "$p" "$3"
}
gm_cc_res_cols() {
  local act
  act=$(gm_cc_act "$1" "$2")
  printf "%s, CASE %s WHEN 'merge' THEN c.m_tid WHEN 'fold' THEN %s WHEN 'insert' THEN COALESCE(%s, c.tid) END, CASE %s WHEN 'merge' THEN c.m_sid WHEN 'fold' THEN %s WHEN 'insert' THEN c.sid END, CASE WHEN %s='insert' THEN %s END" \
    "$act" "$act" "$1" "$(gm_cc_att "$1" "$2" tid)" "$act" "$2" "$act" "$(gm_cc_att "$1" "$2" sid)"
}

# The fold, in one transaction in the register. Spans first: each Claude Code span is merged into the span
# gm's hooks already wrote for the same thing (the turn by session.id and prompt.id, the tool call by
# tool_use_id), folded into its parent (tool.execution, tool.blocked_on_user), or inserted where it belongs:
# a subagent's model call under its invoke_agent span (agent_id), any other span under its parent's place,
# and a span with no parent under its turn, exchange or session. The original ids are kept as span links.
# Then the events: api_request into its chat span (or a chat span of its own when the span was lost), the
# masked prompt and response text onto the turn and the chat span, and errors and compactions as span events.
gm_telemetry_fold_sql() {
  local w=$1 s
  s="(SELECT k FROM sess)"
  cat <<SQL
ATTACH $(gm_q "$w/stage.db") AS imp;
CREATE TEMP TABLE red AS SELECT t.k, t.kind, t.ref, j.value AS body FROM imp.texts t JOIN json_each(CAST(readfile($(gm_q "$w/red.json")) AS TEXT)) j ON j.key+1=t.k;
CREATE TEMP TABLE sess AS SELECT DISTINCT $(gm_a session.id) AS k FROM imp.cs WHERE $(gm_a session.id) IS NOT NULL
  UNION SELECT $(gm_a session.id) FROM imp.ce WHERE $(gm_a session.id) IS NOT NULL;
BEGIN IMMEDIATE;
CREATE TEMP TABLE anc0 AS
  SELECT 'turn' AS kind, $(gm_a session.id) AS k1, COALESCE($(gm_a prompt.id),'') AS k2, trace_id, span_id, start_ms, 0 AS open FROM span
    WHERE name IN ('invoke_agent party-leader','invoke_agent adventurer') AND $(gm_a session.id) IN $s
  UNION ALL SELECT 'turn', $(gm_a session.id), COALESCE($(gm_a prompt.id),''), trace_id, span_id, start_ms, 1 FROM open_span
    WHERE name IN ('invoke_agent party-leader','invoke_agent adventurer') AND session_id IN $s
  UNION ALL SELECT 'exchange', $(gm_a session.id), COALESCE($(gm_a prompt.id),''), trace_id, span_id, start_ms, 0 FROM span WHERE name='guild.exchange' AND $(gm_a session.id) IN $s
  UNION ALL SELECT 'exchange', $(gm_a session.id), COALESCE($(gm_a prompt.id),''), trace_id, span_id, start_ms, 1 FROM open_span WHERE name='guild.exchange' AND session_id IN $s
  UNION ALL SELECT 'session', $(gm_a session.id), '', trace_id, span_id, start_ms, 0 FROM span WHERE name='guild.session' AND $(gm_a session.id) IN $s
  UNION ALL SELECT 'session', session_id, '', trace_id, span_id, start_ms, 1 FROM open_span WHERE name='guild.session' AND session_id IN $s
  UNION ALL SELECT 'tool', $(gm_a gen_ai.tool.call.id), '', trace_id, span_id, start_ms, 0 FROM span WHERE name LIKE 'execute_tool %' AND $(gm_a session.id) IN $s
  UNION ALL SELECT 'tool', $(gm_a gen_ai.tool.call.id), '', trace_id, span_id, start_ms, 1 FROM open_span WHERE name LIKE 'execute_tool %' AND session_id IN $s
  UNION ALL SELECT 'agent', $(gm_a agent_id), '', trace_id, span_id, start_ms, 0 FROM span
    WHERE name LIKE 'invoke_agent %' AND name NOT IN ('invoke_agent party-leader','invoke_agent adventurer') AND $(gm_a session.id) IN $s
  UNION ALL SELECT 'agent', $(gm_a agent_id), '', trace_id, span_id, start_ms, 1 FROM open_span
    WHERE name LIKE 'invoke_agent %' AND name NOT IN ('invoke_agent party-leader','invoke_agent adventurer') AND session_id IN $s
  UNION ALL SELECT 'chat', $(gm_a gen_ai.response.id), '', trace_id, span_id, start_ms, 0 FROM span WHERE name LIKE 'chat %' AND $(gm_a session.id) IN $s
  UNION ALL SELECT 'cc', span_id, '', trace_id, span_id, start_ms, 0 FROM span WHERE $(gm_a guild.source)='claude_code' AND $(gm_a session.id) IN $s
  UNION ALL SELECT 'cc', linked_span_id, '', trace_id, span_id, 0, 0 FROM span_link WHERE $(gm_a guild.link)='claude_code';
DELETE FROM anc0 WHERE k1 IS NULL;
CREATE TEMP TABLE anc AS SELECT kind, k1, k2, trace_id, span_id FROM (
  SELECT anc0.*, ROW_NUMBER() OVER (PARTITION BY kind, k1, k2 ORDER BY open, start_ms) AS rn FROM anc0) WHERE rn=1;
CREATE UNIQUE INDEX temp.anc_key ON anc(kind, k1, k2);
CREATE TEMP TABLE cn AS
SELECT c.tid, c.sid, c.pid, c.name, c.prompt,
       m.trace_id AS m_tid, m.span_id AS m_sid, ag.trace_id AS a_tid, ag.span_id AS a_sid,
       COALESCE(ft.trace_id, fe.trace_id, fs.trace_id) AS f_tid, COALESCE(ft.span_id, fe.span_id, fs.span_id) AS f_sid,
       pv.trace_id AS p_tid, pv.span_id AS p_sid,
       EXISTS (SELECT 1 FROM imp.cs x WHERE x.tid=c.tid AND x.sid=c.pid) AS here
FROM imp.cs c
LEFT JOIN anc m ON m.kind=CASE c.name WHEN 'claude_code.interaction' THEN 'turn' WHEN 'claude_code.tool' THEN 'tool' WHEN 'claude_code.llm_request' THEN 'chat' END
  AND m.k1=CASE c.name WHEN 'claude_code.interaction' THEN $(gm_a session.id c.attrs) WHEN 'claude_code.tool' THEN $(gm_a tool_use_id c.attrs) ELSE $(gm_a request_id c.attrs) END
  AND m.k2=CASE WHEN c.name='claude_code.interaction' THEN COALESCE(c.prompt,'') ELSE '' END
LEFT JOIN anc ag ON c.name='claude_code.llm_request' AND ag.kind='agent' AND ag.k1=$(gm_a agent_id c.attrs) AND ag.k2=''
LEFT JOIN anc ft ON ft.kind='turn' AND ft.k1=$(gm_a session.id c.attrs) AND ft.k2=c.prompt
LEFT JOIN anc fe ON fe.kind='exchange' AND fe.k1=$(gm_a session.id c.attrs) AND fe.k2=c.prompt
LEFT JOIN anc fs ON fs.kind='session' AND fs.k1=$(gm_a session.id c.attrs) AND fs.k2=''
LEFT JOIN anc pv ON pv.kind='cc' AND pv.k1=c.pid AND pv.k2='';
CREATE TEMP TABLE res AS
WITH RECURSIVE r(tid, sid, act, mt, ms, par) AS (
  SELECT c.tid, c.sid, $(gm_cc_res_cols c.p_tid c.p_sid) FROM cn c WHERE NOT c.here
  UNION ALL
  SELECT c.tid, c.sid, $(gm_cc_res_cols r.mt r.ms) FROM cn c JOIN r ON c.tid=r.tid AND c.pid=r.sid
)
SELECT * FROM r;
CREATE TEMP TABLE newsp AS SELECT mt AS trace_id, ms AS span_id FROM res WHERE act='insert' AND NOT EXISTS (SELECT 1 FROM span WHERE trace_id=res.mt AND span_id=res.ms);
INSERT OR IGNORE INTO span(trace_id, span_id, parent_id, name, start_ms, end_ms, status, attrs)
  SELECT r.mt, r.ms, r.par, $(gm_cc_span_name), c.start_ms, MAX(c.end_ms, c.start_ms),
         CASE WHEN c.code IN (2,'2','STATUS_CODE_ERROR') OR $(gm_a success c.attrs) IN (0,'false') THEN 'error' ELSE 'ok' END, $(gm_cc_span_attrs)
  FROM res r JOIN imp.cs c ON c.tid=r.tid AND c.sid=r.sid WHERE r.act='insert';
UPDATE span SET attrs=json_patch(json_remove($(gm_cc_span_attrs), '\$."guild.source"'), span.attrs)
  FROM (SELECT r.mt, r.ms, cs.* FROM res r JOIN imp.cs cs ON cs.tid=r.tid AND cs.sid=r.sid WHERE r.act='merge') c
  WHERE span.trace_id=c.mt AND span.span_id=c.ms;
UPDATE open_span SET attrs=json_patch(json_remove($(gm_cc_span_attrs), '\$."guild.source"'), open_span.attrs)
  FROM (SELECT r.mt, r.ms, cs.* FROM res r JOIN imp.cs cs ON cs.tid=r.tid AND cs.sid=r.sid WHERE r.act='merge') c
  WHERE open_span.trace_id=c.mt AND open_span.span_id=c.ms;
INSERT OR IGNORE INTO span_link(trace_id, span_id, linked_trace_id, linked_span_id, attrs)
  SELECT r.mt, r.ms, r.tid, r.sid, json_object('guild.link','claude_code','guild.import',r.act,'claude_code.span',c.name)
  FROM res r JOIN imp.cs c ON c.tid=r.tid AND c.sid=r.sid
  WHERE r.act IN ('merge','fold') OR (r.act='insert' AND r.mt<>r.tid);
INSERT OR IGNORE INTO anc SELECT 'cc', sid, '', mt, ms FROM res WHERE act IN ('merge','fold','insert');
INSERT OR IGNORE INTO anc SELECT 'turn', $(gm_a session.id c.attrs), c.prompt, r.mt, r.ms FROM res r JOIN imp.cs c ON c.tid=r.tid AND c.sid=r.sid
  WHERE r.act='insert' AND c.name='claude_code.interaction' AND c.prompt IS NOT NULL;
INSERT OR IGNORE INTO anc SELECT 'chat', $(gm_a gen_ai.response.id), '', trace_id, span_id FROM span
  WHERE (trace_id, span_id) IN (SELECT trace_id, span_id FROM newsp) AND name LIKE 'chat %';
-- Model calls: each api_request event completes its chat span, or is one when Claude Code's span was lost.
CREATE TEMP TABLE ar AS
SELECT e.*, $(gm_a request_id e.attrs) AS rid,
       (SELECT trace_id||' '||span_id FROM anc WHERE kind='chat' AND k1=$(gm_a request_id e.attrs) AND k2='') AS chat,
       COALESCE((SELECT trace_id||' '||span_id FROM span WHERE trace_id=e.tid AND span_id=e.sid),
                (SELECT trace_id||' '||span_id FROM anc WHERE kind='cc' AND k1=e.sid AND k2=''),
                (SELECT trace_id||' '||span_id FROM anc WHERE kind='agent' AND k1=$(gm_a agent_id e.attrs) AND k2=''),
                $(gm_cc_fallback_sql "$(gm_a session.id e.attrs)" "$(gm_a prompt.id e.attrs)")) AS at
FROM imp.ce e WHERE e.name='api_request';
UPDATE span SET attrs=json_patch(span.attrs, $(gm_cc_call_attrs))
  FROM ar e WHERE e.chat IS NOT NULL AND span.trace_id=substr(e.chat,1,instr(e.chat,' ')-1) AND span.span_id=substr(e.chat,instr(e.chat,' ')+1);
INSERT INTO newsp
  SELECT DISTINCT COALESCE(substr(at,1,instr(at,' ')-1), tid, lower(hex(randomblob(16)))), substr(lower(hex(rid)),-16) FROM ar WHERE chat IS NULL AND length(rid)>=8;
INSERT OR IGNORE INTO span(trace_id, span_id, parent_id, name, start_ms, end_ms, status, attrs)
  SELECT n.trace_id, n.span_id, substr(e.at,instr(e.at,' ')+1), 'chat '||replace($(gm_model_sql "COALESCE($(gm_a model e.attrs),'model')"),'claude-',''),
         e.t_ms-COALESCE($(gm_a duration_ms e.attrs),0), e.t_ms, 'ok',
         json_patch(json_remove(e.attrs, $GM_OTEL_CONTENT, '\$."event.name"', '\$."event.timestamp"'),
                    json_patch($(gm_cc_call_attrs), json_object('guild.chat.from','api_request')))
  FROM ar e JOIN newsp n ON n.span_id=substr(lower(hex(e.rid)),-16) WHERE e.chat IS NULL;
INSERT OR IGNORE INTO anc SELECT 'chat', $(gm_a gen_ai.response.id), '', trace_id, span_id FROM span
  WHERE (trace_id, span_id) IN (SELECT trace_id, span_id FROM newsp) AND name LIKE 'chat %';
-- The masked prompt onto its turn, the masked response onto its model call.
CREATE TEMP TABLE txt AS
SELECT CASE e.name WHEN 'user_prompt' THEN 'guild.prompt.text' ELSE 'guild.response.text' END AS k,
       COALESCE(CASE WHEN e.name='assistant_response' THEN (SELECT trace_id||' '||span_id FROM anc WHERE kind='chat' AND k1=$(gm_a request_id e.attrs) AND k2='') END,
                $(gm_cc_fallback_sql "$(gm_a session.id e.attrs)" "$(gm_a prompt.id e.attrs)")) AS at,
       r.body, e.n
FROM imp.ce e JOIN red r ON r.ref=CAST(e.n AS TEXT) AND r.kind=CASE e.name WHEN 'user_prompt' THEN 'prompt' ELSE 'response' END
WHERE e.name IN ('user_prompt','assistant_response');
CREATE TEMP TABLE txt1 AS SELECT k, at, group_concat(body, char(10)||char(10)) AS body FROM (SELECT * FROM txt WHERE at IS NOT NULL ORDER BY n) GROUP BY k, at;
$(gm_cc_text_sql span guild.prompt.text)
$(gm_cc_text_sql span guild.response.text)
$(gm_cc_text_sql open_span guild.prompt.text)
$(gm_cc_text_sql open_span guild.response.text)
-- Errors, refusals, compactions and finished subagents as span events.
CREATE TEMP TABLE ev AS
SELECT CASE WHEN e.name='compaction' THEN (SELECT trace_id||' '||span_id FROM anc WHERE kind='session' AND k1=$(gm_a session.id e.attrs) AND k2='')
            WHEN e.name='subagent_completed' THEN COALESCE((SELECT trace_id||' '||span_id FROM anc WHERE kind='agent' AND k1=$(gm_a agent_id e.attrs) AND k2=''),
                                                           $(gm_cc_fallback_sql "$(gm_a session.id e.attrs)" "$(gm_a prompt.id e.attrs)"))
            ELSE $(gm_cc_fallback_sql "$(gm_a session.id e.attrs)" "$(gm_a prompt.id e.attrs)") END AS at,
       json_patch(json_remove(e.attrs, $GM_OTEL_CONTENT, '\$."event.name"', '\$."event.timestamp"', '\$."session.id"', '\$."prompt.id"', '\$."guild.focus"', '\$."guild.role"',
                              '\$."service.name"', '\$."service.version"', '\$."terminal.type"', '\$."os.type"', '\$."os.version"', '\$."host.arch"'),
                  json_object('name', e.name, 'time_ms', e.t_ms)) AS ev, e.n
FROM imp.ce e WHERE e.name IN ('api_error','api_retries_exhausted','api_refusal','compaction','subagent_completed');
CREATE TEMP TABLE ev1 AS SELECT at, json_group_array(json(ev)) AS evs FROM (
  SELECT * FROM ev WHERE at IS NOT NULL AND NOT EXISTS (
    SELECT 1 FROM (SELECT attrs FROM span WHERE trace_id||' '||span_id=ev.at UNION ALL SELECT attrs FROM open_span WHERE trace_id||' '||span_id=ev.at) s, json_each(s.attrs, '\$.events') x
    WHERE x.value->>'name'=ev.ev->>'name' AND x.value->>'time_ms'=ev.ev->>'time_ms')
  ORDER BY n) GROUP BY at;
UPDATE span SET attrs=json_set(span.attrs, '\$.events', (SELECT json_group_array(json(value)) FROM (
    SELECT value FROM json_each(COALESCE(span.attrs->'events','[]')) UNION ALL SELECT value FROM json_each(t.evs))))
  FROM ev1 t WHERE span.trace_id||' '||span.span_id=t.at;
UPDATE open_span SET attrs=json_set(open_span.attrs, '\$.events', (SELECT json_group_array(json(value)) FROM (
    SELECT value FROM json_each(COALESCE(open_span.attrs->'events','[]')) UNION ALL SELECT value FROM json_each(t.evs))))
  FROM ev1 t WHERE open_span.trace_id||' '||open_span.span_id=t.at;
-- Every new span carries its posting and the camp commit last recorded for its session.
UPDATE span SET attrs=json_patch(span.attrs, json_object('guild.posting', f.name||'#'||p.num, 'guild.posting.slug', p.slug, 'guild.focus', f.name))
  FROM posting p JOIN focus f ON f.id=p.focus_id
  WHERE span.trace_id=p.trace_id AND (span.trace_id, span.span_id) IN (SELECT trace_id, span_id FROM newsp);
CREATE TEMP TABLE cm AS
SELECT s.trace_id, s.span_id, (SELECT c FROM (SELECT $(gm_a guild.camp.commit o.attrs) AS c, o.end_ms<=s.end_ms AS before, abs(s.end_ms-o.end_ms) AS gap FROM span o
         WHERE $(gm_a session.id o.attrs)=$(gm_a session.id s.attrs) AND $(gm_a guild.camp.commit o.attrs) IS NOT NULL)
         ORDER BY before DESC, gap LIMIT 1) AS c
FROM span s JOIN newsp n ON n.trace_id=s.trace_id AND n.span_id=s.span_id WHERE $(gm_a guild.camp.commit s.attrs) IS NULL;
UPDATE span SET attrs=json_patch(span.attrs, json_object('guild.camp.commit', cm.c))
  FROM cm WHERE span.trace_id=cm.trace_id AND span.span_id=cm.span_id AND cm.c IS NOT NULL;
SELECT CASE WHEN NOT EXISTS (SELECT 1 FROM imp.cs) AND NOT EXISTS (SELECT 1 FROM imp.ce) THEN 'Nothing new to import.' ELSE
  'imported '||(SELECT count(*) FROM imp.cs)||' spans ('||(SELECT count(*) FROM res WHERE act='merge')||' merged into gm''s own, '
  ||(SELECT count(*) FROM res WHERE act='fold')||' folded, '||(SELECT count(*) FROM res WHERE act='insert')||' added) and '
  ||(SELECT count(*) FROM imp.ce)||' events: '||(SELECT count(*) FROM ar)||' model calls'
  ||COALESCE(printf(' (\$%.4f est.)', (SELECT SUM($(gm_a cost_usd attrs)) FROM ar)),'')
  ||', '||(SELECT count(*) FROM txt WHERE k='guild.prompt.text' AND at IS NOT NULL)||' prompts, '||(SELECT count(*) FROM txt WHERE k='guild.response.text' AND at IS NOT NULL)||' responses' END;
COMMIT;
SQL
}

# Per session the batch touched: the cost of its model calls in the register beside Claude Code's own
# claude_code.cost.usage metric, which should agree to the cent once the session's metrics have arrived.
gm_telemetry_reconcile_sql() {
  local w=$1
  cat <<SQL
ATTACH $(gm_q "$w/stage.db") AS imp;
WITH dp AS (
  SELECT COALESCE(m.value->'sum'->>'aggregationTemporality', 1) AS temp, d.value AS d
  FROM json_each(CAST(readfile($(gm_q "$w/metrics.json")) AS TEXT)) b, json_each(b.value->'resourceMetrics') rs,
       json_each(rs.value->'scopeMetrics') ss, json_each(ss.value->'metrics') m, json_each(m.value->'sum'->'dataPoints') d
  WHERE b.type='object' AND m.value->>'name'='claude_code.cost.usage'),
pt AS (SELECT $(gm_otlp_attrs "d->'attributes'") AS a, temp, COALESCE(d->>'asDouble', d->>'asInt') AS v FROM dp),
series AS (SELECT $(gm_a session.id a) AS session, CASE WHEN temp IN (2,'2','AGGREGATION_TEMPORALITY_CUMULATIVE') THEN MAX(v) ELSE SUM(v) END AS v FROM pt GROUP BY a, temp),
metric AS (SELECT session, SUM(v) AS usd FROM series GROUP BY session),
s AS (SELECT DISTINCT $(gm_a session.id) AS session FROM imp.ce WHERE name='api_request'),
calls AS (SELECT s.session, count(c.span_id) AS n, SUM($(gm_a guild.cost.usd c.attrs)) AS usd
          FROM s LEFT JOIN span c ON c.name LIKE 'chat %' AND $(gm_a session.id c.attrs)=s.session GROUP BY s.session)
SELECT 'session '||substr(calls.session,1,8)||': '||calls.n||' model calls, '||printf('\$%.4f', COALESCE(calls.usd,0))||' est.; '
  ||CASE WHEN metric.usd IS NULL THEN 'no claude_code.cost.usage for it yet (metrics are sent once a minute and at exit)'
         WHEN printf('%.2f', metric.usd)=printf('%.2f', COALESCE(calls.usd,0)) THEN 'claude_code.cost.usage '||printf('\$%.4f', metric.usd)||', the same to the cent'
         ELSE 'claude_code.cost.usage '||printf('\$%.4f', metric.usd)||', which differs (a session still running sends metrics once a minute; import again after it ends)' END
FROM calls LEFT JOIN metric ON metric.session=calls.session ORDER BY calls.session;
SQL
}

# ---- gm trace and gm stats: every view and measure is a query over span rows, never stored ----

# SQL: what a span row (alias $1, a row of "sp") contributes to cost. A model call carries Claude Code's
# own estimate; a turn carries the status line's only when no model call of its prompt was imported, so
# nothing is counted twice when telemetry is on.
gm_cost_sql() {
  local a=$1
  printf '%s' "CASE WHEN $a.name LIKE 'chat %' THEN $(gm_a guild.cost.usd "$a.attrs") WHEN $a.name IN ('invoke_agent party-leader','invoke_agent adventurer') AND NOT EXISTS (SELECT 1 FROM sp x WHERE x.trace_id=$a.trace_id AND x.name LIKE 'chat %' AND $(gm_a session.id x.attrs) IS $(gm_a session.id "$a.attrs") AND $(gm_a prompt.id x.attrs) IS $(gm_a prompt.id "$a.attrs")) THEN $(gm_a guild.cost.usd "$a.attrs") END"
}

# SQL: a dollar amount, with a third decimal under a cent.
gm_usd_sql() { printf '%s' "CASE WHEN $1>0 AND $1<0.01 THEN printf('\$%.3f',$1) WHEN $1 IS NOT NULL THEN printf('\$%.2f',$1) END"; }

# SQL: a token count as 950, 1.2k or 31k.
gm_k_sql() { printf '%s' "CASE WHEN $1 IS NULL THEN '?' WHEN $1<1000 THEN CAST($1 AS TEXT) WHEN $1<10000 THEN printf('%.1fk',$1/1000.0) ELSE printf('%dk',$1/1000) END"; }

# CTE "sp": the spans matching $1 (a condition on trace_id), with the spans still open drawn to now
# and an open posting's root drawn from its posting row.
gm_sp_cte() {
  local w=${1:-1}
  cat <<SQL
sp AS MATERIALIZED (
  SELECT trace_id, span_id, parent_id, name, start_ms, end_ms, status, attrs, 0 AS open FROM span WHERE $w
  UNION ALL
  SELECT trace_id, span_id, parent_id, name, start_ms, MAX(start_ms, $GM_NOW_MS), 'unset', attrs, 1 FROM open_span WHERE $w
  UNION ALL
  SELECT p.trace_id, p.span_id, NULL, 'guild.posting', COALESCE(p.span_start_ms, $GM_NOW_MS), MAX(COALESCE(p.span_start_ms, 0), $GM_NOW_MS), 'unset',
         json_object('guild.focus', f.name, 'guild.posting', f.name||'#'||p.num, 'guild.posting.slug', p.slug, 'guild.state', p.state), 1
  FROM posting p JOIN focus f ON f.id=p.focus_id
  WHERE p.trace_id IS NOT NULL AND $w AND NOT EXISTS (SELECT 1 FROM span s WHERE s.trace_id=p.trace_id AND s.span_id=p.span_id)
)
SQL
}

# CTE "pm": the measures of every traced posting (tracing-design.md, Derived measures). Needs "sp".
gm_pm_cte() {
  cat <<SQL
pm0 AS (
  SELECT p.id AS posting_id, p.num, f.name AS focus, f.name||'#'||p.num AS ref, p.slug, p.state, p.trace_id, p.follows_id,
    MAX(CASE WHEN s.name='guild.exchange' AND s.open=0 AND $(gm_a guild.exchange.n s.attrs)=1 THEN s.end_ms-s.start_ms END) AS first_reply_ms,
    COALESCE(MAX(s.name='guild.exchange' AND s.open=1 AND $(gm_a guild.exchange.n s.attrs)=1),0) AS reply_waiting,
    COALESCE(SUM(s.name='guild.exchange'),0) AS exchanges,
    COALESCE(SUM(s.name='invoke_agent party-leader'),0) AS turns,
    COALESCE(SUM(s.name LIKE 'execute_tool %'),0) AS tools,
    COALESCE(SUM(s.name LIKE 'execute_tool mcp\_\_%' ESCAPE '\\'),0) AS mcp,
    COALESCE(SUM(s.name LIKE 'execute_tool %' AND s.status='error'),0) AS tool_failures,
    COALESCE(SUM(s.name LIKE 'invoke_agent %' AND s.name NOT IN ('invoke_agent party-leader','invoke_agent adventurer')),0) AS subagents,
    COALESCE(SUM(s.name LIKE 'chat %'),0) AS model_calls,
    COALESCE(SUM(s.name='guild.dispatch'),0) AS adventurer_runs,
    COALESCE(SUM(s.name='guild.check' AND $(gm_a guild.check.result s.attrs)='fail'),0) AS failed_checks,
    COALESCE(SUM(s.name='guild.hook'),0) AS hooks,
    COALESCE(SUM(CASE WHEN s.name='guild.hook' THEN s.end_ms-s.start_ms END),0) AS hook_ms,
    COALESCE(SUM(s.name='guild.hook' AND $(gm_a guild.hook.decision s.attrs)='block'),0) AS blocks,
    SUM($(gm_cost_sql s)) AS cost,
    SUM(CASE WHEN s.name LIKE 'chat %' THEN $(gm_a gen_ai.usage.input_tokens s.attrs) END) AS tok_in,
    SUM(CASE WHEN s.name LIKE 'chat %' THEN $(gm_a gen_ai.usage.output_tokens s.attrs) END) AS tok_out,
    SUM(CASE WHEN s.name LIKE 'chat %' THEN $(gm_a gen_ai.usage.cache_read.input_tokens s.attrs) END) AS tok_read,
    SUM(CASE WHEN s.name LIKE 'chat %' THEN $(gm_a gen_ai.usage.cache_write.input_tokens s.attrs) END) AS tok_write,
    MIN(CASE WHEN s.name='guild.posting' THEN s.start_ms END) AS start_ms,
    MAX(CASE WHEN s.name='guild.posting' THEN s.end_ms END) AS end_ms,
    MAX(CASE WHEN s.name='guild.posting' THEN s.open END) AS open,
    MIN(CASE WHEN s.name='guild.notice' AND $(gm_a guild.notice.verb s.attrs)<>'received' THEN s.start_ms END) AS first_notice_at
  FROM posting p JOIN focus f ON f.id=p.focus_id LEFT JOIN sp s ON s.trace_id=p.trace_id
  WHERE p.trace_id IS NOT NULL
  GROUP BY p.id
),
pm AS (
  SELECT pm0.*, turns+model_calls+tools+subagents+adventurer_runs+failed_checks AS steps,
         (state='done' AND exchanges=1 AND adventurer_runs<=1 AND failed_checks=0) AS rft
  FROM pm0
)
SQL
}

# SQL selecting (g, m): the median of column $2 of table $1 per group $3.
gm_median_sql() {
  printf "SELECT g, AVG(v) AS m FROM (SELECT %s AS g, %s AS v, ROW_NUMBER() OVER (PARTITION BY %s ORDER BY %s) AS rn, COUNT(*) OVER (PARTITION BY %s) AS c FROM %s WHERE %s IS NOT NULL) WHERE rn IN ((c+1)/2, (c+2)/2) GROUP BY g" \
    "$3" "$2" "$3" "$2" "$3" "$1" "$2"
}

gm_dropped_note() {
  local n=0
  [ ! -f "$GM_HALL/spans-dropped.log" ] || n=$(grep -c . "$GM_HALL/spans-dropped.log" || true)
  [ "$n" = 0 ] || printf 'spans dropped: %s (could not be written; see %s)\n' "$n" "$GM_HALL/spans-dropped.log"
}

gm_ra() { gm_a "$1" r.attrs; }

# Prints one trace as a text waterfall.
gm_trace_tree() {
  local tid=$1 d m e
  d=$(gm_dur_sql 'r.end_ms-r.start_ms')
  m="replace(COALESCE($(gm_a gen_ai.request.model r.attrs),$(gm_a gen_ai.request.model pa.attrs)),'claude-','')"
  e=$(gm_a gen_ai.request.reasoning.level r.attrs)
  gm_sql <<SQL
WITH RECURSIVE $(gm_sp_cte "trace_id=$(gm_q "$tid")"),
agg AS (SELECT SUM(a.name='guild.exchange') AS nex, SUM($(gm_cost_sql a)) AS cost FROM sp a),
r AS (SELECT sp.*, CASE WHEN parent_id IN (SELECT span_id FROM sp) THEN parent_id END AS par FROM sp),
l AS (
  SELECT r.span_id, r.par, r.name, r.start_ms, r.end_ms,
    CASE
      WHEN r.name='guild.posting' THEN COALESCE($(gm_ra guild.posting),'?')||' '||COALESCE($(gm_ra guild.posting.slug),'')||'  '||COALESCE($(gm_ra guild.state),'')
        ||'  '||$d||CASE WHEN r.open=1 THEN ' so far' ELSE '' END
        ||'  '||agg.nex||CASE agg.nex WHEN 1 THEN ' exchange' ELSE ' exchanges' END
        ||CASE WHEN agg.cost IS NULL THEN '' ELSE printf('  \$%.2f est.', agg.cost) END
      WHEN r.name='guild.exchange' THEN 'exchange '||COALESCE($(gm_ra guild.exchange.n),'?')
        ||'  "'||COALESCE((SELECT $(gm_summary_sql words) FROM message WHERE id=$(gm_ra guild.message.id)),'')||'"  '
        ||CASE WHEN r.open=1 THEN 'no reply yet ('||$d||')' ELSE 'reply in '||$d END
      WHEN r.name='guild.hook' THEN 'hook '||COALESCE($(gm_ra guild.hook.event),'?')||'  '||COALESCE($(gm_ra guild.hook.handler),'')
        ||CASE WHEN $(gm_ra guild.hook.decision) IN ('block','allow') THEN ' '||$(gm_ra guild.hook.decision) ELSE '' END||'  '||$d
      WHEN r.name='guild.session' THEN 'session '||substr(COALESCE($(gm_ra session.id),'?'),1,8)||COALESCE('  '||$(gm_ra guild.session.source),'')
        ||COALESCE(' → '||$(gm_ra guild.session.end_reason),'')||'  '||$d
      WHEN r.name='guild.notice' THEN 'notice '||COALESCE($(gm_ra guild.notice.verb),'?')||COALESCE(' '||$(gm_ra guild.phase),'')||COALESCE(': '||$(gm_ra guild.notice.detail),'')
      WHEN r.name LIKE 'invoke_agent %' THEN r.name
        ||CASE WHEN $m IS NULL AND $e IS NULL THEN '' ELSE '  '||COALESCE($m,'model ?')||' · '||COALESCE($e,'none') END||'  '||$d
        ||COALESCE('  '||$(gm_usd_sql "COALESCE((SELECT SUM($(gm_a guild.cost.usd x.attrs)) FROM sp x WHERE x.trace_id=r.trace_id AND x.name LIKE 'chat %'
                                                   AND CASE WHEN r.name IN ('invoke_agent party-leader','invoke_agent adventurer')
                                                            THEN $(gm_a session.id x.attrs) IS $(gm_ra session.id) AND $(gm_a prompt.id x.attrs) IS $(gm_ra prompt.id)
                                                            ELSE x.parent_id=r.span_id END), $(gm_ra guild.cost.usd))"),'')
      WHEN r.name LIKE 'chat %' THEN r.name||' · '||COALESCE($e,'none')
        ||'  in '||$(gm_k_sql "$(gm_ra gen_ai.usage.input_tokens)")||' (cached '||$(gm_k_sql "$(gm_ra gen_ai.usage.cache_read.input_tokens)")||') out '||$(gm_k_sql "$(gm_ra gen_ai.usage.output_tokens)")
        ||COALESCE('  '||$(gm_usd_sql "$(gm_ra guild.cost.usd)"),'')||'  '||$d
      WHEN r.name LIKE 'execute_tool %' THEN r.name
        ||COALESCE('  '||substr(replace($(gm_ra guild.tool.command),char(10),' '),1,60)||CASE WHEN length($(gm_ra guild.tool.command))>60 THEN '…' ELSE '' END,
                   '  '||$(gm_ra guild.subagent.type),'')
        ||CASE WHEN $(gm_ra gen_ai.request.model) IS NULL THEN '' ELSE '  '||replace($(gm_ra gen_ai.request.model),'claude-','') END||'  '||$d
      ELSE r.name||'  '||$d
    END
    ||CASE WHEN r.status='error' THEN '  ✗ '||COALESCE($(gm_ra error.type),'error')||COALESCE(' (exit '||$(gm_ra guild.exit_code)||')','') ELSE '' END
    ||CASE WHEN r.open=1 AND r.name NOT IN ('guild.posting','guild.exchange') THEN '  (open)' ELSE '' END
    ||CASE WHEN $(gm_ra guild.closed_by) IS NULL THEN '' ELSE '  (closed: '||$(gm_ra guild.closed_by)||')' END AS label
  FROM r LEFT JOIN sp pa ON pa.span_id=r.parent_id, agg
),
o AS (
  SELECT l.*, ROW_NUMBER() OVER (PARTITION BY par ORDER BY start_ms, CASE name WHEN 'guild.hook' THEN 0 ELSE 1 END, end_ms, span_id) AS rn,
         COUNT(*) OVER (PARTITION BY par) AS cnt
  FROM l
),
t(span_id, sortkey, kid, line) AS (
  SELECT span_id, printf('%06d', rn), '', label FROM o WHERE par IS NULL
  UNION ALL
  SELECT o.span_id, t.sortkey||'.'||printf('%06d', o.rn), t.kid||CASE WHEN o.rn=o.cnt THEN '   ' ELSE '│  ' END,
         t.kid||CASE WHEN o.rn=o.cnt THEN '└─ ' ELSE '├─ ' END||o.label
  FROM o JOIN t ON o.par=t.span_id
)
SELECT line FROM t ORDER BY sortkey;
SQL
}

gm_trace_posting() {
  local pid=$1 tid
  tid=$(gm_sql "SELECT COALESCE(trace_id,'') FROM posting WHERE id=$pid;")
  if [ -z "$tid" ]; then
    gm_sql "SELECT f.name||'#'||p.num||' '||p.slug||'  '||p.state||'  (made before tracing began: a ledger, gm show '||f.name||'#'||p.num||', and no spans)' FROM posting p JOIN focus f ON f.id=p.focus_id WHERE p.id=$pid;"
    return
  fi
  gm_trace_tree "$tid"
}

gm_cmd_trace() {
  [ $# -le 1 ] || gm_die "trace: gm trace <posting|focus>"
  gm_db_ensure
  if [ "${1:-}" = import ]; then
    gm_telemetry_import
    return
  fi
  gm_telemetry_import quiet || true
  local ref=${1:-} kind id canon out
  [ -n "$ref" ] || ref=$(gm_require_focus)
  out=$(gm_resolve "$ref") || exit 1
  IFS=$'\t' read -r kind id canon <<<"$out"
  if [ "$kind" = posting ]; then
    gm_trace_posting "$id"
  else
    local p first=1 legacy t
    for p in $(gm_sql "SELECT id FROM posting WHERE focus_id=$id AND trace_id IS NOT NULL ORDER BY num;"); do
      [ "$first" = 1 ] || printf '\n'
      first=0
      gm_trace_posting "$p"
    done
    legacy=$(gm_sql "SELECT count(*) FROM posting WHERE focus_id=$id AND trace_id IS NULL;")
    [ "$legacy" = 0 ] || printf '\n%s postings of %s were made before tracing began: gm show has their ledgers.\n' "$legacy" "$canon"
    for t in $(gm_sql "SELECT trace_id FROM (SELECT trace_id, start_ms FROM span WHERE name='guild.session' AND $(gm_a guild.focus)=$(gm_q "$canon")
                       UNION SELECT trace_id, start_ms FROM open_span WHERE name='guild.session' AND $(gm_a guild.focus)=$(gm_q "$canon")) ORDER BY start_ms;"); do
      printf '\n'
      gm_trace_tree "$t"
    done
    gm_sql "SELECT char(10)||'focus notices:' WHERE EXISTS (SELECT 1 FROM span WHERE parent_id IS NULL AND name='guild.notice' AND $(gm_a guild.focus)=$(gm_q "$canon"));
SELECT '  '||strftime('%Y-%m-%d %H:%M', start_ms/1000, 'unixepoch')||'  notice '||$(gm_a guild.notice.verb)||COALESCE(' '||$(gm_a guild.phase),'')
FROM span WHERE parent_id IS NULL AND name='guild.notice' AND $(gm_a guild.focus)=$(gm_q "$canon") ORDER BY start_ms;"
  fi
  gm_dropped_note
}

gm_parse_ms() {
  local re='^([0-9]+)(ms|s|m|h)?$'
  [[ $1 =~ $re ]] || gm_die "stats: '$1' is not a duration (try 500ms, 30s, 2m, 1h)"
  case ${BASH_REMATCH[2]} in
    ms) printf '%s' "${BASH_REMATCH[1]}" ;;
    m) printf '%s' "$((BASH_REMATCH[1] * 60000))" ;;
    h) printf '%s' "$((BASH_REMATCH[1] * 3600000))" ;;
    *) printf '%s' "$((BASH_REMATCH[1] * 1000))" ;;
  esac
}

gm_cmd_stats() {
  local by='' compare='' over='' ref=''
  while [ $# -gt 0 ]; do
    case $1 in
      --by-prompt) by=${2:?--by-prompt needs a template name}; shift 2 ;;
      --compare) compare=${2:?--compare needs a selection}; shift 2 ;;
      --over) over=${2:?--over needs a duration}; shift 2 ;;
      -*) gm_die "stats: unknown option $1" ;;
      *) [ -z "$ref" ] || gm_die "stats: one posting or focus at a time"; ref=$1; shift ;;
    esac
  done
  gm_db_ensure
  gm_telemetry_import quiet || true
  if [ -n "$by" ]; then
    gm_stats_by_prompt "$by" "$ref"
  elif [ -n "$compare" ]; then
    gm_stats_compare "$compare" "$over" "$ref"
  else
    [ -z "$over" ] || gm_die "stats: --over goes with --compare"
    local kind id canon out
    [ -n "$ref" ] || ref=$(gm_require_focus)
    out=$(gm_resolve "$ref") || exit 1
    IFS=$'\t' read -r kind id canon <<<"$out"
    if [ "$kind" = posting ]; then gm_stats_posting "$id"; else gm_stats_focus "$canon"; fi
  fi
  gm_dropped_note
}

gm_stats_posting() {
  local pid=$1 tid
  tid=$(gm_sql "SELECT COALESCE(trace_id,'') FROM posting WHERE id=$pid;")
  if [ -z "$tid" ]; then
    gm_trace_posting "$pid"
    return
  fi
  gm_sql <<SQL
WITH RECURSIVE $(gm_sp_cte),
$(gm_pm_cte),
up(id) AS (SELECT $pid UNION SELECT p.follows_id FROM posting p JOIN up ON p.id=up.id WHERE p.follows_id IS NOT NULL),
top AS (SELECT id FROM up u WHERE NOT EXISTS (SELECT 1 FROM posting p WHERE p.id=u.id AND p.follows_id IS NOT NULL) LIMIT 1),
topic(id) AS (SELECT id FROM top UNION SELECT p.id FROM posting p JOIN topic ON p.follows_id=topic.id),
tp AS (SELECT COALESCE(SUM(exchanges),0) AS ex, group_concat(CASE WHEN posting_id<>$pid THEN '#'||num END, ', ') AS others
       FROM (SELECT pm.* FROM topic JOIN pm ON pm.posting_id=topic.id ORDER BY pm.num)),
me AS (SELECT * FROM pm WHERE posting_id=$pid),
ts AS (SELECT * FROM sp WHERE trace_id=$(gm_q "$tid")),
iv AS (SELECT start_ms AS s, end_ms AS e FROM ts WHERE name IN ('invoke_agent party-leader','invoke_agent adventurer')),
iv2 AS (SELECT s, e, MAX(e) OVER (ORDER BY s, e ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS pe FROM iv),
iv3 AS (SELECT s, e, SUM(CASE WHEN pe IS NULL OR s>pe THEN 1 ELSE 0 END) OVER (ORDER BY s, e ROWS UNBOUNDED PRECEDING) AS g FROM iv2),
work AS (SELECT COALESCE(SUM(ge-gs),0) AS ms FROM (SELECT MIN(s) AS gs, MAX(e) AS ge FROM iv3 GROUP BY g)),
nt AS (SELECT start_ms, $(gm_a guild.notice.verb ts.attrs) AS verb FROM ts WHERE name='guild.notice' AND $(gm_a guild.notice.verb ts.attrs)<>'update'),
pk AS (SELECT COALESCE(SUM(COALESCE(nx, (SELECT end_ms FROM me))-start_ms),0) AS ms
       FROM (SELECT start_ms, verb, LEAD(start_ms) OVER (ORDER BY start_ms) AS nx FROM nt) WHERE verb='parked'),
br AS (SELECT model, effort, role, SUM(usd) AS usd, SUM(is_call) AS calls FROM (
         SELECT replace(COALESCE($(gm_a gen_ai.request.model ts.attrs),'model ?'),'claude-','') AS model, COALESCE($(gm_a gen_ai.request.reasoning.level ts.attrs),'none') AS effort,
                COALESCE($(gm_a guild.role ts.attrs),'party-leader') AS role, $(gm_cost_sql ts) AS usd, ts.name LIKE 'chat %' AS is_call
         FROM ts WHERE $(gm_cost_sql ts) IS NOT NULL)
       GROUP BY model, effort, role),
brs AS (SELECT group_concat(t, ' · ') AS t FROM (
         SELECT model||'/'||effort||' '||$(gm_usd_sql usd)||' ('||role||', '||CASE WHEN calls>0 THEN calls||CASE calls WHEN 1 THEN ' call' ELSE ' calls' END ELSE 'status line' END||')' AS t
         FROM br ORDER BY usd DESC, model))
SELECT me.ref||' '||me.slug||'  '||me.state
  ||char(10)||'  first reply '||CASE WHEN me.first_reply_ms IS NOT NULL THEN $(gm_dur_sql me.first_reply_ms) WHEN me.reply_waiting THEN 'not yet' ELSE '—' END
  ||' · first notice '||CASE WHEN me.first_notice_at IS NULL THEN '—' ELSE $(gm_dur_sql 'me.first_notice_at-me.start_ms') END
  ||' · total '||$(gm_dur_sql 'me.end_ms-me.start_ms')||CASE WHEN me.open=1 THEN ' so far' ELSE '' END
  ||' (working '||$(gm_dur_sql work.ms)||', parked '||$(gm_dur_sql pk.ms)||')'
  ||char(10)||'  exchanges '||me.exchanges||CASE WHEN tp.others IS NULL THEN '' ELSE ' (topic '||tp.ex||', with '||tp.others||')' END
  ||' · turns '||me.turns||' · right first time: '||CASE WHEN me.state<>'done' THEN 'not done' WHEN me.rft THEN 'yes' ELSE 'no' END
  ||char(10)||'  steps '||me.steps||': '||me.turns||' turn'||CASE me.turns WHEN 1 THEN '' ELSE 's' END||' · '||me.tools||' tool calls ('||me.mcp||' MCP, '||me.tool_failures||' failed) · '
  ||me.subagents||' subagent'||CASE me.subagents WHEN 1 THEN '' ELSE 's' END||' · '
  ||CASE WHEN me.model_calls=0 THEN 'model calls need telemetry' ELSE me.model_calls||' model calls' END
  ||' · '||me.adventurer_runs||' Adventurer runs · '||me.failed_checks||' failed checks'
  ||char(10)||'  hooks '||me.hooks||' runs in '||$(gm_dur_sql me.hook_ms)||' · '||me.blocks||' Stop-guard block'||CASE me.blocks WHEN 1 THEN '' ELSE 's' END
  ||char(10)||'  cost '||CASE WHEN me.model_calls>0 THEN $(gm_usd_sql me.cost)||' est., from Claude Code''s telemetry: '||COALESCE((SELECT t FROM brs),'')
                             WHEN me.cost IS NULL THEN 'unknown (no status line samples and no telemetry imported; see gm doctor)'
                             ELSE printf('\$%.2f est., from Claude Code''s status line', me.cost) END
  ||CASE WHEN me.model_calls>0 THEN char(10)||'  tokens in '||$(gm_k_sql me.tok_in)||' ('||$(gm_k_sql me.tok_read)||' read from cache, '||$(gm_k_sql me.tok_write)||' written to it) · out '||$(gm_k_sql me.tok_out) ELSE '' END
FROM me, tp, work, pk;
SQL
}

gm_stats_focus() {
  local focus=$1 w
  w="WITH RECURSIVE $(gm_sp_cte),
$(gm_pm_cte),
f AS (SELECT * FROM pm WHERE focus=$(gm_q "$focus")),
mr AS ($(gm_median_sql f first_reply_ms 1)),
mx AS ($(gm_median_sql f exchanges 1))"
  gm_sql <<SQL
$w
SELECT $(gm_q "$focus")||': '||(SELECT count(*) FROM f)||' postings traced · '||(SELECT COALESCE(SUM(state='done'),0) FROM f)||' done · '
  ||(SELECT COALESCE(SUM(rft),0) FROM f)||' right first time · median first reply '||COALESCE((SELECT $(gm_dur_sql 'CAST(m AS INTEGER)') FROM mr),'—')
  ||' · median exchanges '||COALESCE((SELECT printf('%g', m) FROM mx),'—')
  ||COALESCE(' · '||NULLIF((SELECT count(*) FROM posting p JOIN focus g ON g.id=p.focus_id WHERE g.name=$(gm_q "$focus") AND p.trace_id IS NULL),0)||' made before tracing (ledger only)','');
$w
SELECT printf('%-36s %-10s %8s %5s %5s %5s %4s %9s %8s', 'posting', 'state', 'reply', 'exch', 'turns', 'tools', 'rft', 'total', 'cost') WHERE EXISTS (SELECT 1 FROM f);
$w
SELECT printf('%-36s %-10s %8s %5d %5d %5d %4s %9s %8s', ref||' '||slug, state,
              CASE WHEN first_reply_ms IS NULL THEN '—' ELSE $(gm_dur_sql first_reply_ms) END, exchanges, turns, tools,
              CASE WHEN state<>'done' THEN '—' WHEN rft THEN 'yes' ELSE 'no' END, $(gm_dur_sql 'end_ms-start_ms'), COALESCE($(gm_usd_sql cost),'—'))
FROM f ORDER BY num;
SQL
}

gm_stats_by_prompt() {
  local tpl=$1 ref=$2 scope=1 re='^[a-z0-9][a-z0-9-]*$'
  [[ $tpl =~ $re ]] || gm_die "stats: a template name is like charter, playbook, rules, resume or stop-guard"
  [ -z "$ref" ] || scope="pm.focus=$(gm_q "$(gm_require_focus "$ref")")"
  local key
  key=$(gm_a "guild.prompt.$tpl.sha256" s.attrs)
  local w
  w="WITH RECURSIVE $(gm_sp_cte),
$(gm_pm_cte),
ph AS (SELECT DISTINCT $key AS sha, pm.posting_id FROM sp s JOIN pm ON pm.trace_id=s.trace_id WHERE s.name='guild.exchange' AND $key IS NOT NULL AND $scope),
g AS (SELECT ph.sha, pm.* FROM ph JOIN pm ON pm.posting_id=ph.posting_id),
agg AS (SELECT sha, COUNT(*) AS n, SUM(state='done') AS done, SUM(rft) AS rft, SUM(failed_checks) AS fc FROM g GROUP BY sha),
mx AS ($(gm_median_sql g exchanges sha)),
ms AS ($(gm_median_sql g steps sha)),
mc AS ($(gm_median_sql g cost sha)),
mix AS (SELECT g.sha, group_concat(DISTINCT replace(m.model,'claude-','')) AS models, group_concat(DISTINCT g.focus) AS focuses
        FROM g LEFT JOIN (SELECT trace_id, $(gm_a gen_ai.request.model) AS model FROM sp WHERE name='invoke_agent party-leader') m ON m.trace_id=g.trace_id
        GROUP BY g.sha),
ranked AS (SELECT (SELECT MIN(n) FROM agg)>=10 AND (SELECT count(*) FROM agg)>1 AS yes)"
  gm_sql <<SQL
$w
SELECT 'No posting has run under a recorded $tpl prompt yet.' WHERE NOT EXISTS (SELECT 1 FROM agg);
$w
SELECT CASE WHEN yes THEN 'Ranked by share right first time.' ELSE 'In order of first use, not ranked: gm ranks prompt versions only when each has 10 postings or more.' END
FROM ranked WHERE EXISTS (SELECT 1 FROM agg);
$w
SELECT char(10)||$(gm_q "$tpl")||' '||substr(agg.sha,1,12)||COALESCE('  first seen '||substr(v.first_seen,1,16),'')
  ||char(10)||'  postings '||agg.n||' · done '||agg.done||' · right first time '||agg.rft
  ||' · median exchanges '||printf('%g', mx.m)||' · median steps '||printf('%g', ms.m)||' · failed checks '||agg.fc
  ||' · median cost '||CASE WHEN mc.m IS NULL THEN 'unknown' ELSE printf('\$%.2f est.', mc.m) END
  ||char(10)||'  mix: models '||COALESCE(mix.models,'unknown')||' · focuses '||mix.focuses
  ||CASE WHEN agg.n<10 THEN ' · fewer than 10 postings' ELSE '' END
FROM agg JOIN mx ON mx.g=agg.sha JOIN ms ON ms.g=agg.sha LEFT JOIN mc ON mc.g=agg.sha JOIN mix ON mix.sha=agg.sha
  LEFT JOIN prompt_version v ON v.name=$(gm_q "$tpl") AND v.sha256=agg.sha, ranked
ORDER BY CASE WHEN ranked.yes THEN -1.0*agg.rft/agg.n ELSE 0 END, v.first_seen, agg.sha;
SQL
}

# What sets a selection apart from the rest: the BubbleUp of honeycomb/lessons.html, one query over attrs.
gm_stats_compare() {
  local sel=$1 over=$2 ref=$3 thr pop what scope=1 pscope=1 focus
  if [ -n "$ref" ]; then
    focus=$(gm_require_focus "$ref")
    scope="$(gm_a guild.focus)=$(gm_q "$focus")"
    pscope="pm.focus=$(gm_q "$focus")"
  fi
  case $sel in
    slow-tools)
      thr=$(gm_parse_ms "${over:-30s}")
      what="execute_tool spans slower than ${over:-30s}"
      pop="SELECT (end_ms-start_ms)>$thr AS sel, attrs FROM span WHERE name LIKE 'execute_tool %' AND $scope" ;;
    slow-hooks)
      thr=$(gm_parse_ms "${over:-1s}")
      what="guild.hook spans slower than ${over:-1s}"
      pop="SELECT (end_ms-start_ms)>$thr AS sel, attrs FROM span WHERE name='guild.hook' AND $scope" ;;
    slow-calls)
      thr=$(gm_parse_ms "${over:-30s}")
      what="chat spans (model calls) slower than ${over:-30s}"
      pop="SELECT (end_ms-start_ms)>$thr AS sel, attrs FROM span WHERE name LIKE 'chat %' AND $scope" ;;
    slow-replies)
      thr=$(gm_parse_ms "${over:-2m}")
      what="exchanges whose reply took over ${over:-2m}"
      pop="SELECT (end_ms-start_ms)>$thr AS sel, attrs FROM span WHERE name='guild.exchange' AND $scope" ;;
    not-right-first-time)
      [ -z "$over" ] || gm_die "stats: --over does not apply to not-right-first-time"
      what="postings not right first time (of those done or failed)"
      pop="SELECT NOT pm.rft AS sel, json_remove(s.attrs,'\$.\"guild.state\"','\$.\"error.type\"') AS attrs
           FROM pm JOIN posting p ON p.id=pm.posting_id JOIN span s ON s.trace_id=p.trace_id AND s.span_id=p.span_id
           WHERE pm.state IN ('done','failed') AND $pscope" ;;
    *) gm_die "stats: --compare takes slow-tools, slow-hooks, slow-replies, slow-calls or not-right-first-time" ;;
  esac
  local w
  w="WITH RECURSIVE $(gm_sp_cte),
$(gm_pm_cte),
pop AS ($pop),
tot AS (SELECT COALESCE(SUM(sel),0) AS n_sel, COALESCE(SUM(1-sel),0) AS n_base FROM pop),
kv AS (SELECT pop.sel, j.key, CAST(j.value AS TEXT) AS value FROM pop, json_each(pop.attrs) AS j
       WHERE j.type NOT IN ('object','array')
         AND j.key NOT IN ('guild.posting','guild.posting.slug','guild.message.id','session.id','prompt.id','agent_id','gen_ai.tool.call.id',
                           'gen_ai.response.id','gen_ai.conversation.id','guild.writ.sha256','guild.camp.commit','guild.notice.detail',
                           'request_id','client_request_id','tool_use_id','guild.prompt.text','guild.response.text')),
card AS (SELECT key FROM kv GROUP BY key HAVING COUNT(DISTINCT value)*2<=COUNT(*))"
  gm_sql <<SQL
$w
SELECT 'selection: '||n_sel||' $what · baseline: '||n_base||' others'
  ||CASE WHEN n_sel=0 THEN char(10)||'The selection is empty, so there is nothing to compare.'
         WHEN n_base=0 THEN char(10)||'The baseline is empty: every one is in the selection, so there is nothing to compare against.' ELSE '' END
FROM tot;
$w
SELECT printf('%-34s %-18s %9s %9s', 'key', 'value', 'selection', 'baseline') FROM tot WHERE n_sel>0 AND n_base>0;
$w
SELECT printf('%-34s %-18s %8.1f%% %8.1f%%', key, substr(value,1,18), 100.0*SUM(sel)/tot.n_sel, 100.0*SUM(1-sel)/tot.n_base)
FROM kv, tot WHERE tot.n_sel>0 AND tot.n_base>0 AND key IN (SELECT key FROM card)
GROUP BY key, value
ORDER BY ABS(1.0*SUM(sel)/tot.n_sel-1.0*SUM(1-sel)/tot.n_base) DESC, key, value
LIMIT 10;
SQL
}

gm_hook_prompt() {
  local tmp out spill t0 mid
  t0=$(gm_now_ms)
  tmp=$(gm_tmp)
  cat >"$tmp"
  if out=$(gm_hook_prompt_record "$tmp") && [ -n "$out" ]; then
    mid=${out%%$'\n'*}
    out=${out#*$'\n'}
    (gm_trace_prompt "$tmp" "$mid" "$t0") >/dev/null 2>&1 || gm_span_dropped "guild.exchange"
    rm -f "$tmp"
    gm_hook_json UserPromptSubmit "$out"
  else
    mkdir -p "$GM_HALL/spill"
    spill=$GM_HALL/spill/$(date +%Y%m%dT%H%M%S)-$$.json
    mv "$tmp" "$spill"
    gm_hook_json UserPromptSubmit "gm could not write this patron message to the register; the raw message is saved at $spill." \
      "gm could not record your message in the register; it is saved at $spill"
  fi
}

# Runs without errexit (called from a condition); its status is the register write's.
gm_hook_prompt_record() {
  local tmp=$1 focus words sid pid first reftarget='' kind id canon disposition notification=''
  focus=${GM_FOCUS:-}
  words=$(gm_json_field "$tmp" prompt)
  sid=$(gm_json_field "$tmp" session_id)
  pid=$(gm_json_field "$tmp" prompt_id)
  local wsql
  wsql="json_extract(CAST(readfile($(gm_q "$tmp")) AS TEXT),'\$.prompt')"
  first=$(printf '%s' "$words" | sed -n '/[^[:space:]]/{p;q;}')
  local re_ref='^[[:space:]]*(([a-z0-9][a-z0-9-]*)?#[0-9]+)([^0-9a-z-]|$)'
  if [[ $first =~ $re_ref ]]; then
    reftarget=$(gm_resolve "${BASH_REMATCH[1]}" 2>/dev/null) || reftarget=''
  fi
  if [ -n "$reftarget" ]; then
    IFS=$'\t' read -r kind id canon <<<"$reftarget"
  fi
  # A background task's notification arrives through this hook as if typed, but it is the harness's, not the
  # patron's: it is recorded, never made a posting. Its row keeps the command disposition, the schema's word for
  # what is not the patron's message.
  [[ ! $first =~ ^[[:space:]]*'<task-notification>' ]] || notification=1
  case $first in
    /*) disposition='command' ;;
    *) if [ -n "$notification" ]; then disposition='command'; elif [ -n "$reftarget" ]; then disposition=addition; else disposition=posting; fi ;;
  esac
  [ -n "$focus" ] && [ -s "$GM_DB" ] && [ -n "$(gm_focus_id "$focus" 2>/dev/null)" ] || disposition=unplaced
  local sql
  case $disposition in
    posting)
      sql="$(gm_new_posting_sql "$focus" "$(gm_slugify "$words")" "$wsql" patron "$sid" "NULL")
UPDATE posting SET message_id=(SELECT id FROM v WHERE k='message') WHERE id=(SELECT id FROM v WHERE k='posting');
UPDATE message SET posting_id=(SELECT id FROM v WHERE k='posting') WHERE id=(SELECT id FROM v WHERE k='message');
SELECT 'gm recorded this patron message verbatim as posting '||f.name||'#'||p.num||' '||p.slug||' (state received). Its notice line: '||(SELECT line FROM event WHERE posting_id=p.id AND verb='received')
FROM posting p JOIN focus f ON f.id=p.focus_id WHERE p.id=(SELECT id FROM v WHERE k='posting');" ;;
    addition)
      sql="UPDATE message SET posting_id=$id WHERE id=(SELECT id FROM v WHERE k='message');
INSERT INTO event(at, actor, kind, focus_id, posting_id, session_id, line)
  SELECT $GM_NOW, 'patron', 'posting.addition', p.focus_id, p.id, $(gm_qn "$sid"), f.name||'#'||p.num||' '||p.slug||' addition from the patron'
  FROM posting p JOIN focus f ON f.id=p.focus_id WHERE p.id=$id;
SELECT 'gm recorded this patron message verbatim as an addition to posting '||f.name||'#'||p.num||' '||p.slug||' (state '||p.state||'). The posting''s words: \"'||$(gm_summary_sql p.words)||'\"'
FROM posting p JOIN focus f ON f.id=p.focus_id WHERE p.id=$id;" ;;
    command)
      if [ -n "$notification" ]; then
        sql="SELECT 'gm recorded this background task notification verbatim; it is not a message from the patron, so it is not a posting.';"
      else
        sql="SELECT 'gm recorded this slash command verbatim; it is not a posting.';"
      fi ;;
    unplaced) sql="SELECT 'gm recorded this message verbatim, but no focus named '||$(gm_q "${focus:-?}")||' is in the register, so it is not a posting.';" ;;
  esac
  local focus_sql=NULL
  [ "$disposition" = unplaced ] || focus_sql="(SELECT id FROM focus WHERE name=$(gm_q "$focus"))"
  # The patron's message to a focus whose Party Leader asked to close keeps it open.
  case $disposition in
    posting | addition)
      sql="$sql
SELECT 'This message cancels the close that the Party Leader of '||name||' asked for: the focus stays open.' FROM focus
  WHERE name=$(gm_q "$focus") AND close_requested_at IS NOT NULL AND closed_at IS NULL;
$(gm_close_cancel_sql "name=$(gm_q "$focus")" patron)" ;;
  esac
  gm_db_ensure
  gm_sql <<SQL
CREATE TEMP TABLE v(k TEXT PRIMARY KEY, id INTEGER);
BEGIN IMMEDIATE;
INSERT INTO message(focus_id, at, session_id, prompt_id, words, disposition)
  VALUES ($focus_sql, $GM_NOW, $(gm_qn "$sid"), $(gm_qn "$pid"), $wsql, $(gm_q "$disposition"));
INSERT INTO v VALUES ('message', last_insert_rowid());
SELECT id FROM v WHERE k='message';
INSERT INTO guard(session_id, blocks) VALUES ($(gm_q "${sid:-none}"), 0) ON CONFLICT(session_id) DO UPDATE SET blocks=0;
$sql
COMMIT;
SQL
}

gm_hook_json() {
  # $1 event, $2 additionalContext, $3 optional systemMessage, $4 optional sessionTitle
  local f expr
  f=$(gm_tmp)
  printf '%s' "$2" >"$f"
  expr="json_object('hookSpecificOutput', json_object('hookEventName', $(gm_q "$1"), 'additionalContext', CAST(readfile($(gm_q "$f")) AS TEXT)))"
  [ -z "${4:-}" ] || expr="json_set($expr, '\$.hookSpecificOutput.sessionTitle', $(gm_q "$4"))"
  [ -z "${3:-}" ] || expr="json_set($expr, '\$.systemMessage', $(gm_q "$3"))"
  sqlite3 -batch :memory: "SELECT $expr;"
  rm -f "$f"
}

gm_hook_session_start() {
  local tmp source sid focus text t0
  t0=$(gm_now_ms)
  tmp=$(gm_tmp)
  cat >"$tmp"
  focus=${GM_FOCUS:-}
  source=$(gm_json_field "$tmp" source)
  sid=$(gm_json_field "$tmp" session_id)
  if [ -z "$focus" ] || [ ! -s "$GM_DB" ] || [ -z "$(gm_focus_id "$focus")" ]; then
    rm -f "$tmp"
    gm_hook_json SessionStart "gm has no focus named '${focus:-?}' in the register at $GM_DB, so there is nothing to resume." "gm: no focus '${focus:-?}' in $GM_DB"
    return
  fi
  gm_sql "BEGIN IMMEDIATE; INSERT INTO event(at, actor, kind, focus_id, session_id, detail) SELECT $GM_NOW, 'hook', 'session.start', id, $(gm_qn "$sid"), $(gm_qn "$source") FROM focus WHERE name=$(gm_q "$focus"); COMMIT;"
  text=$(gm_where "$focus")
  if [ "${#text}" -gt 9500 ]; then
    text="${text:0:9400}
(The summary was cut to fit; run gm where for the rest.)"
  fi
  printf '%s' "$text" >"$tmp.text"
  (gm_trace_session_start "$tmp" "$t0" "$tmp.text") >/dev/null 2>&1 || gm_span_dropped "guild.hook SessionStart"
  rm -f "$tmp" "$tmp.text"
  gm_hook_json SessionStart "$text" "" "$focus"
}

gm_hook_charter() {
  local focus=${GM_FOCUS:-} charter playbook rules text repo tmp t0
  t0=$(gm_now_ms)
  tmp=$(gm_tmp)
  cat >"$tmp"
  [ -n "$focus" ] && [ -s "$GM_DB" ] && [ -n "$(gm_focus_id "$focus")" ] || { rm -f "$tmp"; return 0; }
  repo=$(gm_focus_field "$focus" repo)
  charter=$(gm_charter_path)
  playbook=$(gm_playbook_path "$(gm_focus_field "$focus" kind)")
  rules=$(gm_rules_path "$repo")
  text="The Party Leader's charter, playbook and repository rules, as the patron wrote them in $GM_HALL."
  local f
  for f in "$charter" "$playbook" "$rules"; do
    if [ -f "$f" ]; then
      text="$text

----- $f -----
$(cat "$f")"
    else
      text="$text

----- $f is missing -----"
    fi
  done
  if [ "${#text}" -gt 9500 ]; then
    text="The charter, playbook and rules are too long to load here together. Read them before acting: $charter, $playbook, $rules.

$(head -c 8000 "$charter")"
  fi
  (gm_trace_charter "$tmp" "$t0" charter "$charter" playbook "$playbook" rules "$rules") >/dev/null 2>&1 || gm_span_dropped "guild.hook SessionStart"
  rm -f "$tmp"
  gm_hook_json SessionStart "$text"
}

gm_hook_stop() {
  local tmp out t0
  t0=$(gm_now_ms)
  tmp=$(gm_tmp)
  cat >"$tmp"
  out=$(gm_tmp)
  GM_STOP_DECISION=allow GM_STOP_BLOCKS=0 GM_STOP_GAVEUP='' GM_STOP_REASON=''
  gm_hook_stop_guard "$tmp" >"$out"
  if [ -n "${GM_FOCUS:-}" ] && [ -s "$GM_DB" ]; then
    (gm_trace_stop "$tmp" "$t0" "$GM_STOP_DECISION" "$GM_STOP_BLOCKS" "$GM_STOP_GAVEUP" "$GM_STOP_REASON") >/dev/null 2>&1 || gm_span_dropped "guild.hook Stop"
  fi
  cat "$out"
  rm -f "$tmp" "$out" "${GM_STOP_REASON:-$tmp}"
}

# Decides the Stop; sets GM_STOP_DECISION, GM_STOP_BLOCKS, GM_STOP_GAVEUP and GM_STOP_REASON for its span.
gm_hook_stop_guard() {
  local tmp=$1 focus sid bg pending blocks
  focus=${GM_FOCUS:-}
  [ -n "$focus" ] && [ -s "$GM_DB" ] && [ -n "$(gm_focus_id "$focus" 2>/dev/null)" ] || return 0
  sid=$(gm_json_field "$tmp" session_id)
  bg=$(sqlite3 -batch :memory: "SELECT COALESCE(json_array_length(CAST(readfile($(gm_q "$tmp")) AS TEXT),'\$.background_tasks'),0);" 2>/dev/null || echo 0)
  local fid
  fid=$(gm_focus_id "$focus")
  pending=$(gm_sql <<SQL
SELECT '- '||f.name||'#'||p.num||' '||p.slug||' is received and has no recorded state yet.'
FROM posting p JOIN focus f ON f.id=p.focus_id WHERE p.focus_id=$fid AND p.state='received' ORDER BY p.num;
SELECT '- '||f.name||'#'||p.num||' '||p.slug||' is active (claimed) and its outcome is not recorded.'
FROM posting p JOIN focus f ON f.id=p.focus_id WHERE p.focus_id=$fid AND p.state='active' AND $bg=0 ORDER BY p.num;
SELECT '- the patron''s addition to '||f.name||'#'||p.num||' '||p.slug||' ('||m.at||') is not acknowledged by a notice yet.'
FROM message m JOIN posting p ON p.id=m.posting_id JOIN focus f ON f.id=p.focus_id
WHERE m.focus_id=$fid AND m.disposition='addition' AND m.sorted_at IS NULL ORDER BY m.id;
SQL
) || { gm_hook_stop_message "gm stop guard could not read the register at $GM_DB; this turn ends unchecked."; return 0; }
  if [ -z "$pending" ]; then
    gm_sql "BEGIN IMMEDIATE; INSERT INTO guard(session_id, blocks) VALUES ($(gm_q "${sid:-none}"), 0) ON CONFLICT(session_id) DO UPDATE SET blocks=0; COMMIT;" >/dev/null 2>&1 || true
    return 0
  fi
  blocks=$(gm_sql "BEGIN IMMEDIATE; INSERT INTO guard(session_id, blocks) VALUES ($(gm_q "${sid:-none}"), 1) ON CONFLICT(session_id) DO UPDATE SET blocks=blocks+1; SELECT blocks FROM guard WHERE session_id=$(gm_q "${sid:-none}"); COMMIT;" 2>/dev/null || echo 999)
  GM_STOP_BLOCKS=$blocks
  if [ "$blocks" -gt "$GM_STOP_BUDGET" ]; then
    GM_STOP_GAVEUP=1
    gm_sql "BEGIN IMMEDIATE; UPDATE guard SET blocks=0 WHERE session_id=$(gm_q "${sid:-none}"); INSERT INTO event(at, actor, kind, focus_id, session_id, detail) VALUES ($GM_NOW, 'hook', 'guard.gave-up', $fid, $(gm_qn "$sid"), $(gm_q "$pending")); COMMIT;" >/dev/null 2>&1 || true
    gm_hook_stop_message "gm stop guard gave up after $GM_STOP_BUDGET blocks; still unrecorded:
$pending"
    return 0
  fi
  local reason="These postings in $focus need a recorded state before the turn ends:
$pending
Record each with gm notice <n> <queued|started|needs-you|done|failed|closed> [detail] or gm park <n> --why TEXT, then show the patron each notice line."
  local f
  f=$(gm_tmp)
  printf '%s' "$reason" >"$f"
  GM_STOP_DECISION=block
  GM_STOP_REASON=$f
  sqlite3 -batch :memory: "SELECT json_object('decision','block','reason',CAST(readfile($(gm_q "$f")) AS TEXT));"
}

gm_hook_stop_message() {
  local f
  f=$(gm_tmp)
  printf '%s' "$1" >"$f"
  sqlite3 -batch :memory: "SELECT json_object('systemMessage',CAST(readfile($(gm_q "$f")) AS TEXT));"
  rm -f "$f"
}

gm_hook_precompact() {
  local tmp focus sid trigger camp snap fid t0
  t0=$(gm_now_ms)
  tmp=$(gm_tmp)
  cat >"$tmp"
  focus=${GM_FOCUS:-}
  [ -n "$focus" ] && [ -s "$GM_DB" ] && [ -n "$(gm_focus_id "$focus" 2>/dev/null)" ] || { rm -f "$tmp"; return 0; }
  sid=$(gm_json_field "$tmp" session_id)
  trigger=$(gm_json_field "$tmp" trigger)
  fid=$(gm_focus_id "$focus")
  camp=$(gm_focus_field "$focus" camp)
  snap="compaction ($trigger); camp git:
$(git -C "$camp" log -1 --format='HEAD %h %s' 2>/dev/null || true)
$(git -C "$camp" status --short --branch 2>/dev/null | head -n 40 || true)
open postings:
$(gm_sql "SELECT '#'||num||' '||slug||' '||state FROM posting WHERE focus_id=$fid AND state NOT IN ('done','closed') ORDER BY num;")"
  gm_sql "BEGIN IMMEDIATE; INSERT INTO event(at, actor, kind, focus_id, session_id, detail) VALUES ($GM_NOW, 'hook', 'session.compact', $fid, $(gm_qn "$sid"), $(gm_q "$snap")); COMMIT;" >/dev/null 2>&1 || true
  (gm_trace_precompact "$tmp" "$t0") >/dev/null 2>&1 || gm_span_dropped "guild.hook PreCompact"
  rm -f "$tmp"
}

gm_cmd_hook() {
  local which=${1:-}
  case $which in
    prompt) gm_hook_prompt ;;
    session-start) gm_hook_session_start ;;
    charter) gm_hook_charter ;;
    stop) gm_hook_stop ;;
    precompact) gm_hook_precompact ;;
    # --clone is what the committed settings pass; a Guildhall's settings from before the front desk moved into the
    # clone pass nothing, and get the same hook.
    front-desk) gm_hook_clone ;;
    front-desk-guard) gm_hook_front_desk_guard ;;
    session-end | pre-tool | post-tool | post-tool-failure | subagent-start | subagent-stop | stop-failure) gm_record_hook "$which" ;;
    *) gm_die "hook: unknown hook '$which'" ;;
  esac
}

# ---- Quarters: herdr keeps every Party Leader running (vision/herdr-design.md) ----
# Every herdr call names its session with --session; HERDR_SESSION alone is not trusted. Business errors such as
# pane_not_found come back as JSON with a non-zero exit, so answers are read from the JSON, not the exit status.

GM_HERDR=${GM_HERDR:-herdr}
# herdr's official installer puts it in ~/.local/bin, which a shell, Claude Code or launchd may not have on its PATH.
if [ "$GM_HERDR" = herdr ] && ! command -v herdr >/dev/null 2>&1 && [ -x "$HOME/.local/bin/herdr" ]; then
  GM_HERDR=$HOME/.local/bin/herdr
fi
GM_HERDR_SESSION=${GM_HERDR_SESSION:-default}
GM_HERDR_WORKSPACE=${GM_HERDR_WORKSPACE:-guild}
GM_HERDR_RESAMPLE=${GM_HERDR_RESAMPLE:-10}
GM_LAUNCH_GRACE=${GM_LAUNCH_GRACE:-60}
GM_START_TRIES=${GM_START_TRIES:-3}
GM_FRONT_DESK=guildmaster
GM_COLLECTOR_TAB=collector
GM_SHELLS="'sh','bash','zsh','fish','dash','ksh','tcsh','csh','nu','login'"

gm_herdr_require() {
  command -v "$GM_HERDR" >/dev/null 2>&1 ||
    gm_die "$1: gm needs herdr, which keeps every Party Leader running and brings them back; install it (README.md) or set GM_HERDR"
}

# gm_herdr <session> <arguments...>: herdr's one JSON answer, or nothing.
gm_herdr() {
  local session=$1
  shift
  "$GM_HERDR" "$@" --session "$session" </dev/null 2>&1 | grep '^{' | tail -n 1 || true
}

# gm_hj <json> <path>...: the values at those paths, tab-separated; nothing when the text is not JSON.
gm_hj() {
  local j=$1 cols='' p
  shift
  for p in "$@"; do cols="${cols:+$cols,}json_extract(j,$(gm_q "$p"))"; done
  sqlite3 -batch -separator "$(printf '\t')" :memory: "SELECT $cols FROM (SELECT $(gm_q "$j") AS j) WHERE json_valid(j);" 2>/dev/null || true
}

gm_herdr_running() {
  [ "$(gm_hj "$(gm_herdr "$1" status --json)" '$.server.running')" = 1 ]
}

# gm_herdr_request <session> <method> <params JSON>: one request on herdr's socket, for what its CLI does not offer
# (workspace.move); herdr's one JSON answer, or nothing. GM_HERDR_SOCKET_CMD, given the socket and the request,
# stands in for nc in the tests.
gm_herdr_request() {
  local s=$1 sock req
  sock=$(gm_hj "$(gm_herdr "$s" status --json)" '$.server.socket')
  [ -n "$sock" ] || return 0
  req=$(sqlite3 -batch :memory: "SELECT json_object('id','gm','method',$(gm_q "$2"),'params',json($(gm_q "$3")));" 2>/dev/null) || return 0
  if [ -n "${GM_HERDR_SOCKET_CMD:-}" ]; then
    "$GM_HERDR_SOCKET_CMD" "$sock" "$req" 2>/dev/null | grep '^{' | head -n 1 || true
  else
    printf '%s\n' "$req" | nc -U -w 5 "$sock" 2>/dev/null | grep '^{' | head -n 1 || true
  fi
}

# gm_herdr_place <session> <guild workspace> <workspace>: herdr's sidebar is one flat list, so a Party Leader's
# workspace is shown under the guild by its label (└ <focus>) and its place: moved to the end of the block of the
# guild's own workspaces right after the guild's. Only the order changes; a failure leaves it where herdr put it.
gm_herdr_place() {
  local s=$1 guild=$2 ws=$3 list params
  list=$(gm_herdr "$s" workspace list)
  params=$(gm_sql "WITH w AS (
  SELECT CAST(key AS INTEGER) AS i, json_extract(value,'\$.workspace_id') AS id
  FROM json_each(CASE WHEN json_valid($(gm_q "$list")) THEN $(gm_q "$list") ELSE '{}' END, '\$.result.workspaces')),
o AS (SELECT id, row_number() OVER (ORDER BY i) - 1 AS j FROM w WHERE id IS NOT $(gm_q "$ws")),
mine AS (SELECT workspace_id AS id FROM endpoint WHERE session=$(gm_q "$s") AND workspace_id NOT IN ($(gm_q "$guild"), $(gm_q "$ws"))),
g AS (SELECT j FROM o WHERE id=$(gm_q "$guild"))
SELECT json_object('workspace_id', $(gm_q "$ws"), 'insert_index', d) FROM (
  SELECT COALESCE((SELECT min(j) FROM o WHERE j > (SELECT j FROM g) AND id NOT IN (SELECT id FROM mine)), (SELECT count(*) FROM o)) AS d)
WHERE EXISTS (SELECT 1 FROM g) AND d IS NOT (SELECT i FROM w WHERE id=$(gm_q "$ws"));")
  [ -z "$params" ] || gm_herdr_request "$s" workspace.move "$params" >/dev/null
}

# Starts the session's server headless when none runs; it outlives gm. The server hands its own environment to
# every pane it opens, so it starts without the variables of whatever session started it.
gm_herdr_server_ensure() {
  local s=$1 i=0
  gm_herdr_running "$s" && return 0
  (cd / && env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_SESSION_ID -u GM_FOCUS -u TRACEPARENT \
    nohup "$GM_HERDR" server --session "$s" </dev/null >/dev/null 2>&1 &)
  while [ "$i" -lt 20 ]; do
    gm_herdr_running "$s" && return 0
    sleep 0.5
    i=$((i + 1))
  done
  gm_die "herdr's server for session $s did not start"
}

# One recorded endpoint: session, workspace, tab, pane, label, and 1 while it was launched moments ago.
gm_endpoint() {
  gm_sql "SELECT session, workspace_id, tab_id, pane_id, label, COALESCE(launched_ms,0) > $GM_NOW_MS-$GM_LAUNCH_GRACE*1000 FROM endpoint WHERE key=$(gm_q "$1");"
}

# gm_endpoint_record <key> <role> <focus or ''> <session> <workspace> <tab> <pane> <label>
gm_endpoint_record() {
  local fid=NULL
  [ -z "$3" ] || fid="(SELECT id FROM focus WHERE name=$(gm_q "$3"))"
  gm_sql "BEGIN IMMEDIATE;
INSERT INTO endpoint(key, role, focus_id, session, workspace_id, tab_id, pane_id, label, launched_ms, recorded_at)
  VALUES ($(gm_q "$1"), $(gm_q "$2"), $fid, $(gm_q "$4"), $(gm_q "$5"), $(gm_q "$6"), $(gm_q "$7"), $(gm_q "$8"), NULL, $GM_NOW)
  ON CONFLICT(key) DO UPDATE SET role=excluded.role, focus_id=excluded.focus_id, session=excluded.session,
    workspace_id=excluded.workspace_id, tab_id=excluded.tab_id, pane_id=excluded.pane_id, label=excluded.label,
    launched_ms=NULL, recorded_at=excluded.recorded_at;
COMMIT;"
}

# The pane still exists in the recorded workspace: present, gone, or unknown when herdr does not say.
gm_herdr_pane_presence() {
  local s=$1 ws=$2 pane=$3 out
  out=$(gm_herdr "$s" pane get "$pane")
  if [ "$(gm_hj "$out" '$.error.code')" = pane_not_found ]; then
    printf 'gone'
  elif [ -z "$(gm_hj "$out" '$.result.pane.workspace_id')" ]; then
    printf 'unknown'
  elif [ "$(gm_hj "$out" '$.result.pane.workspace_id')" != "$ws" ]; then
    printf 'gone'
  else
    printf 'present'
  fi
}

# The guild's workspace in the current session: a recorded one that still carries the guild's label, or a new
# one whose first tab becomes the front desk. A workspace is never adopted by its label alone.
gm_herdr_workspace() {
  local s=$GM_HERDR_SESSION ws out tab pane
  for ws in $(gm_sql "SELECT workspace_id FROM endpoint WHERE session=$(gm_q "$s") AND label NOT LIKE '└ %' GROUP BY workspace_id ORDER BY max(key='front-desk') DESC, max(recorded_at) DESC;"); do
    [ "$(gm_hj "$(gm_herdr "$s" workspace get "$ws")" '$.result.workspace.label')" = "$GM_HERDR_WORKSPACE" ] || continue
    gm_front_desk_ensure "$ws"
    printf '%s' "$ws"
    return 0
  done
  out=$(gm_herdr "$s" workspace create --cwd "$GM_ROOT" --label "$GM_HERDR_WORKSPACE" --no-focus)
  IFS=$'\t' read -r ws tab pane <<<"$(gm_hj "$out" '$.result.workspace.workspace_id' '$.result.tab.tab_id' '$.result.root_pane.pane_id')"
  [ -n "$ws" ] && [ -n "$pane" ] || gm_die "herdr would not make the $GM_HERDR_WORKSPACE workspace: ${out:-no answer}"
  gm_herdr "$s" tab rename "$tab" "$GM_FRONT_DESK" >/dev/null
  gm_endpoint_record front-desk front-desk '' "$s" "$ws" "$tab" "$pane" "$GM_FRONT_DESK"
  printf '%s' "$ws"
}

# The front desk is the workspace's first tab, where the Guildmaster sits: a Claude Code session in the clone, kept
# running by the muster like a Party Leader.
gm_front_desk_ensure() {
  local ws=$1 s=$GM_HERDR_SESSION row rs rws pane out tab
  row=$(gm_endpoint front-desk)
  IFS=$'\t' read -r rs rws _ pane _ _ <<<"$row"
  if [ -n "$row" ] && [ "$rs" = "$s" ] && [ "$rws" = "$ws" ] && [ "$(gm_herdr_pane_presence "$s" "$ws" "$pane")" != gone ]; then
    return 0
  fi
  out=$(gm_herdr "$s" tab create --workspace "$ws" --cwd "$GM_ROOT" --label "$GM_FRONT_DESK" --no-focus)
  IFS=$'\t' read -r tab pane <<<"$(gm_hj "$out" '$.result.tab.tab_id' '$.result.root_pane.pane_id')"
  [ -z "$pane" ] || gm_endpoint_record front-desk front-desk '' "$s" "$ws" "$tab" "$pane" "$GM_FRONT_DESK"
}

# What a pane runs, from herdr's process-info: agent (the Party Leader's claude, in the foreground or under the
# pane's shell), shell (only shells), other:<names>, or unreadable. Claude Code's process is named after its version
# (2.1.288), so it is known by argv0, claude, or by GM_CLAUDE's name.
gm_process_verdict() {
  local out=$1 c row verdict pid names want=claude
  c=$(basename "${GM_CLAUDE:-claude}")
  # The collector's pane runs otelcol-contrib, or the binary GM_OTELCOL names.
  if [ "${2:-}" = collector ]; then
    want=otelcol-contrib
    c=$(gm_otelcol)
    c=$(basename "${c:-otelcol-contrib}")
  fi
  row=$(sqlite3 -batch -separator "$(printf '\t')" :memory: "
WITH j(j) AS (SELECT $(gm_q "$out")),
p(name, argv0) AS (
  SELECT ltrim(COALESCE(json_extract(value,'\$.name'),''),'-'), COALESCE(json_extract(value,'\$.argv0'),'')
  FROM j, json_each(CASE WHEN json_valid(j.j) THEN j.j ELSE '{}' END, '\$.result.process_info.foreground_processes'))
SELECT CASE
  WHEN NOT json_valid(j) OR json_extract(j,'\$.result.type') IS NOT 'pane_process_info' THEN 'unreadable'
  WHEN EXISTS (SELECT 1 FROM p WHERE name IN ($(gm_q "$want"),$(gm_q "$c")) OR argv0 IN ($(gm_q "$want"),$(gm_q "$c"))
    OR argv0 LIKE '%/'||$(gm_q "$want") OR argv0 LIKE '%/'||$(gm_q "$c")) THEN 'agent'
  WHEN NOT EXISTS (SELECT 1 FROM p WHERE name NOT IN ($GM_SHELLS)) THEN 'shell'
  ELSE 'other' END,
  COALESCE(json_extract(j,'\$.result.process_info.shell_pid'),''),
  COALESCE((SELECT group_concat(name, ',') FROM (SELECT DISTINCT name FROM p WHERE name NOT IN ($GM_SHELLS))),'')
FROM j;" 2>/dev/null || true)
  IFS=$'\t' read -r verdict pid names <<<"$row"
  if [ "$verdict" = shell ] || [ "$verdict" = other ]; then
    ! gm_pid_runs "$pid" "$want" && ! gm_pid_runs "$pid" "$c" || verdict=agent
  fi
  case $verdict in
    other) printf 'other:%s' "$names" ;;
    '') printf 'unreadable' ;;
    *) printf '%s' "$verdict" ;;
  esac
}

# gm_pid_runs <pid> <command name>: some descendant of pid runs that command.
gm_pid_runs() {
  case $1 in '' | *[!0-9]*) return 1 ;; esac
  ps -axo pid=,ppid=,comm= 2>/dev/null | awk -v root="$1" -v want="$2" '
    { n = split($3, parts, "/"); name[$1] = parts[n]; parent[$1] = $2 }
    END {
      for (p in parent) {
        if (name[p] != want) continue
        q = parent[p]
        for (i = 0; i < 64 && q > 1; i++) { if (q == root) found = 1; q = parent[q] }
      }
      exit found ? 0 : 1
    }'
}

# A shell still starting runs helpers (printf, tail), so a pane running something else is looked at again
# for a moment before that answer stands.
gm_herdr_pane_process() {
  local s=$1 pane=$2 key=${3:-} i=1 verdict
  while :; do
    verdict=$(gm_process_verdict "$(gm_herdr "$s" pane process-info --pane "$pane")" "$key")
    case $verdict in other:*) ;; *) break ;; esac
    [ "$i" -lt "$GM_HERDR_RESAMPLE" ] || break
    i=$((i + 1))
    sleep 0.2
  done
  printf '%s' "$verdict"
}

# A Party Leader's state, with a detail: alive; dead (its pane holds only a shell); missing (no pane recorded, or
# the pane is gone); starting (launched moments ago); or unknown. Only dead and missing are ever relaunched.
gm_endpoint_state() {
  local key=$1 row s ws pane fresh verdict status
  row=$(gm_endpoint "$key")
  if [ -z "$row" ]; then
    printf 'missing\tno pane recorded'
    return
  fi
  IFS=$'\t' read -r s ws _ pane _ fresh <<<"$row"
  if [ -z "$pane" ]; then
    printf 'missing\tno pane recorded'
    return
  fi
  if ! gm_herdr_running "$s"; then
    printf 'unknown\therdr session %s is not running' "$s"
    return
  fi
  case $(gm_herdr_pane_presence "$s" "$ws" "$pane") in
    gone) printf 'missing\tpane %s is gone' "$pane"; return ;;
    unknown) printf 'unknown\therdr did not describe pane %s' "$pane"; return ;;
  esac
  verdict=$(gm_herdr_pane_process "$s" "$pane" "$key")
  case $verdict in
    agent)
      if [ "$key" = collector ]; then
        printf 'alive\trunning on 127.0.0.1:%s' "${GM_OTEL_PORT:-4318}"
        return
      fi
      status=$(gm_hj "$(gm_herdr "$s" agent get "$pane")" '$.result.agent.agent_status')
      printf 'alive\t%s' "${status:-running}" ;;
    shell | other:*)
      if [ "$fresh" = 1 ]; then
        printf 'starting\tlaunched moments ago'
      elif [ "$verdict" = shell ]; then
        printf 'dead\tthe pane holds only a shell'
      else
        printf 'unknown\tthe pane runs %s, not %s' "${verdict#other:}" "$([ "$key" = collector ] && printf 'the collector' || printf 'a Party Leader')"
      fi ;;
    *) printf 'unknown\therdr could not read what pane %s runs' "$pane" ;;
  esac
}

# A Party Leader's workspace label: shown under the guild's workspace in herdr's sidebar.
gm_party_leader_label() { printf '└ %s' "$1"; }

# gm_party_leader_workspace <focus> <camp>: a pane for a missing Party Leader, recorded as its endpoint. It is a new
# tab in its own workspace when herdr still has that one, under the recorded id and with its label (the patron may
# have opened another tab there); otherwise a new workspace on the camp, placed under the guild's, as Firstmate does
# for its crew. Never one adopted by its label alone.
gm_party_leader_workspace() {
  local focus=$1 dir=$2 s=$GM_HERDR_SESSION key="party-leader:$1" label guild rs rws out ws tab pane
  label=$(gm_party_leader_label "$focus")
  guild=$(gm_herdr_workspace) || return 1
  IFS=$'\t' read -r rs rws _ _ _ _ <<<"$(gm_endpoint "$key")"
  if [ "$rs" = "$s" ] && [ -n "$rws" ] && [ "$rws" != "$guild" ] &&
    [ "$(gm_hj "$(gm_herdr "$s" workspace get "$rws")" '$.result.workspace.label')" = "$label" ]; then
    out=$(gm_herdr "$s" tab create --workspace "$rws" --cwd "$dir" --label "$focus" --no-focus)
    IFS=$'\t' read -r tab pane <<<"$(gm_hj "$out" '$.result.tab.tab_id' '$.result.root_pane.pane_id')"
    ws=$rws
  else
    out=$(gm_herdr "$s" workspace create --cwd "$dir" --label "$label" --no-focus)
    IFS=$'\t' read -r ws tab pane <<<"$(gm_hj "$out" '$.result.workspace.workspace_id' '$.result.tab.tab_id' '$.result.root_pane.pane_id')"
  fi
  if [ -z "$ws" ] || [ -z "$pane" ]; then
    printf 'herdr would not open a workspace: %s' "${out:-no answer}"
    return 1
  fi
  gm_endpoint_record "$key" party-leader "$focus" "$s" "$ws" "$tab" "$pane" "$label"
  [ "$ws" = "$rws" ] || gm_herdr_place "$s" "$guild" "$ws"
}

# Starts a focus's Party Leader, the front desk's Guildmaster (key front-desk) or the collector: in its recorded pane
# when that holds only a shell, otherwise in a new workspace of its own under the guild's (a Party Leader) or a new
# tab in the guild's workspace. The pane runs gm start, which starts claude in the camp, or in the clone.
gm_endpoint_launch() {
  local key=$1 state=$2 cause=$3 name s ws tab pane out dir line v val fid vars role label focus=''
  vars="GM_HALL GM_CLAUDE GM_TELEMETRY GM_CHAT GM_OTEL_ENDPOINT GM_OTEL_PORT"
  case $key in
    front-desk)
      name=$GM_FRONT_DESK
      dir=$GM_ROOT
      gm_front_desk_files
      fid=NULL
      vars=$GM_DESK_VARS ;;
    collector)
      name=$GM_COLLECTOR_TAB role=collector
      dir=$GM_HALL
      fid=NULL
      vars="GM_HALL GM_OTELCOL GM_OTEL_PORT GM_COLLECTOR_CONFIG" ;;
    *)
      name=${key#party-leader:} role=party-leader focus=${key#party-leader:}
      dir=$(gm_focus_field "$name" camp)
      fid="(SELECT id FROM focus WHERE name=$(gm_q "$name"))" ;;
  esac
  # A Party Leader left dead in a tab of the guild's workspace, from before each had a workspace of its own, moves
  # out: its husk, only a shell, is closed, and it starts as a missing one does.
  if [ "$state" = dead ] && [ -n "$focus" ]; then
    IFS=$'\t' read -r s _ _ pane label _ <<<"$(gm_endpoint "$key")"
    if [ "$label" != "$(gm_party_leader_label "$focus")" ]; then
      gm_herdr "$s" pane close "$pane" >/dev/null
      state=missing
    fi
  fi
  if [ "$state" = dead ]; then
    IFS=$'\t' read -r s ws tab pane _ _ <<<"$(gm_endpoint "$key")"
  elif [ "$key" = front-desk ]; then
    s=$GM_HERDR_SESSION
    ws=$(gm_herdr_workspace) || return 1
    IFS=$'\t' read -r _ _ tab pane _ _ <<<"$(gm_endpoint front-desk)"
  elif [ -n "$focus" ]; then
    s=$GM_HERDR_SESSION
    gm_party_leader_workspace "$focus" "$dir" || return 1
    IFS=$'\t' read -r _ ws tab pane _ _ <<<"$(gm_endpoint "$key")"
  else
    s=$GM_HERDR_SESSION
    ws=$(gm_herdr_workspace) || return 1
    out=$(gm_herdr "$s" tab create --workspace "$ws" --cwd "$dir" --label "$name" --no-focus)
    IFS=$'\t' read -r tab pane <<<"$(gm_hj "$out" '$.result.tab.tab_id' '$.result.root_pane.pane_id')"
    if [ -z "$pane" ]; then
      printf 'herdr would not open a tab: %s' "${out:-no answer}"
      return 1
    fi
    gm_endpoint_record "$key" "$role" "$focus" "$s" "$ws" "$tab" "$pane" "$name"
  fi
  [ -n "$pane" ] || { printf 'no pane for %s' "$name"; return 1; }
  line="cd $(gm_shq "$dir") && env"
  for v in $vars; do
    gm_conf_carried "$v" || continue
    eval "val=\${$v:-}"
    [ -z "$val" ] || line="$line $v=$(gm_shq "$val")"
  done
  line="$line bash $(gm_shq "$GM_SELF") start $(gm_shq "$name") --pane $(gm_shq "$pane")"
  gm_sql "BEGIN IMMEDIATE;
UPDATE endpoint SET launched_ms=$GM_NOW_MS WHERE key=$(gm_q "$key");
INSERT INTO event(at, actor, kind, focus_id, detail)
  VALUES ($GM_NOW, 'gm', $(gm_q "${key%%:*}.launched"), $fid, $(gm_q "$state: $cause; herdr session $s pane $pane"));
COMMIT;"
  gm_herdr "$s" pane run "$pane" "$line" >/dev/null
  printf '%s' "$pane"
}

# The muster against herdr, in plain code and with no model: the front desk's Guildmaster and every open focus's
# Party Leader are checked, the dead and the missing are started again (the SessionStart hooks resume them from the
# register), the alive are left as they are, and anything else is reported and left alone. One that has failed to
# start GM_START_TRIES times in a row is held, with one notice, until gm open (or gm alone, for the Guildmaster).
# $1 is what to print: all (gm up), changes (before a command at a terminal, and the Guildmaster's start), quiet (the
# launchd agent: changes, without counting a held notice as told), or one focus's name (that focus's line, and
# changes).
gm_reconcile() {
  local show=$1 focus
  gm_herdr_server_ensure "$GM_HERDR_SESSION"
  gm_herdr_workspace >/dev/null
  gm_muster_one front-desk "$show"
  gm_collector_muster "$show"
  for focus in $(gm_sql "SELECT name FROM focus WHERE closed_at IS NULL ORDER BY name;"); do
    gm_muster_one "party-leader:$focus" "$show"
  done
}

# gm_muster_one <endpoint key> <show>: one Guildmaster or Party Leader, checked and acted on.
gm_muster_one() {
  local key=$1 show=$2 name table where who its retry st detail line='' pane attempts held told tell fid
  if [ "$key" = front-desk ]; then
    name=$GM_FRONT_DESK table=endpoint where="key='front-desk'" who=Guildmaster its='the Guildmaster' retry='gm tries again'
    fid=NULL
  else
    name=${key#party-leader:}
    table=focus where="name=$(gm_q "$name")" who='Party Leader' its='its Party Leader' retry="gm open $name tries again"
    fid="(SELECT id FROM focus WHERE $where)"
  fi
  IFS=$'\t' read -r st detail <<<"$(gm_endpoint_state "$key")"
  # A Party Leader that asked to close its focus is not started again: its close is finished here when it has
  # ended; while it still runs, a finisher is started again unless one is at work.
  if [ "$key" != front-desk ] && [ -n "$(gm_focus_field "$name" close_requested_at)" ]; then
    case $st in
      dead | missing)
        gm_close_done "$name" "$st" gm
        line="$name: closed, as its Party Leader asked" ;;
      alive)
        gm_close_spawn "$name"
        line="$name: asked to close; gm ends it once its turn is over" ;;
    esac
    [ -z "$line" ] || printf '%s\n' "$line"
    return 0
  fi
  IFS=$'\t' read -r attempts held told <<<"$(gm_sql "SELECT start_attempts, held_at IS NOT NULL, held_told FROM $table WHERE $where;")"
  attempts=${attempts:-0} told=${told:-0}
  [ "$held" = 1 ] || held=''
  line=''
  case $st in
    dead | missing)
      if [ -z "$held" ] && [ "$attempts" -ge "$GM_START_TRIES" ]; then
        held=1 told=0
        gm_sql "BEGIN IMMEDIATE;
UPDATE $table SET held_at=$GM_NOW, held_told=0 WHERE $where;
INSERT INTO event(at, actor, kind, focus_id, detail) VALUES ($GM_NOW, 'gm', $(gm_q "${key%%:*}.held"), $fid, $(gm_q "failed to start $attempts times in a row; last $st: $detail"));
COMMIT;"
      fi
      if [ -n "$held" ]; then
        # Told once in the agent's log (held_told 1) and once at a terminal (2); gm up by hand always says it.
        tell=2
        [ "$show" != quiet ] || tell=1
        if [ "$show" = all ] || [ "$show" = "$name" ] || [ "$told" -lt "$tell" ]; then
          line="$name: held: $its failed to start $attempts times in a row ($st: $detail); $retry"
          [ "$told" -ge "$tell" ] || gm_sql "BEGIN IMMEDIATE; UPDATE $table SET held_told=$tell WHERE $where; COMMIT;"
        fi
      else
        gm_sql "BEGIN IMMEDIATE; UPDATE $table SET start_attempts=start_attempts+1 WHERE $where; COMMIT;"
        if pane=$(gm_endpoint_launch "$key" "$st" "$detail"); then
          line="$name: $who started in herdr pane $pane ($st: $detail)"
        else
          line="$name: could not start $its ($st: $detail): $pane"
        fi
      fi ;;
    alive)
      [ "$attempts" = 0 ] && [ -z "$held" ] ||
        gm_sql "BEGIN IMMEDIATE; UPDATE $table SET start_attempts=0, held_at=NULL, held_told=0 WHERE $where; COMMIT;"
      [ "$show" != all ] && [ "$show" != "$name" ] || line="$name: $who already running ($detail), left as it is" ;;
    *) line="$name: $st ($detail); left alone" ;;
  esac
  [ -z "$line" ] || printf '%s\n' "$line"
}

# ---- The tracing collector, kept running while guild.conf says collector: on ----
# It lives in herdr like the Guildmaster and the Party Leaders: in a tab of its own, collector, in the guild's
# workspace, so herdr keeps it through a closed terminal and the patron can look at what it says. The pane runs
# gm start collector, which runs otelcol-contrib on 127.0.0.1 only, as gm collector always has. The muster, plain
# code, starts it when it is dead or missing, never as a second copy: not while one answers on the port (the patron's
# own gm collector, say), and only in the pane the register records. It is quiet: a check says nothing and writes
# nothing, a start or a restart is one ledger row (collector.launched), and only a collector that failed to start
# GM_START_TRIES times in a row says one line, held, once to each channel; it is tried again a day later. Off, nothing
# runs and nothing is said.

# The collector's endpoint row, made before its first start so failures before any pane exists are counted.
gm_collector_row() {
  gm_sql "BEGIN IMMEDIATE;
INSERT OR IGNORE INTO endpoint(key, role, session, workspace_id, tab_id, pane_id, label, recorded_at)
  VALUES ('collector', 'collector', '', '', '', '', $(gm_q "$GM_COLLECTOR_TAB"), $GM_NOW);
COMMIT;"
}

# Why a start cannot happen now, or nothing: no collector installed, or the port taken by something that is not one.
# Prints "answering" when a collector already answers on the port, so none is started beside it.
gm_collector_blocker() {
  local code port=${GM_OTEL_PORT:-4318}
  code=$(gm_otlp_status "http://127.0.0.1:$port")
  if [ "$code" = 200 ]; then
    printf 'answering'
  elif [ -z "$(gm_otelcol)" ]; then
    printf 'no OpenTelemetry Collector is installed (gm init --yes installs it)'
  elif [ -n "$code" ]; then
    printf 'port %s on 127.0.0.1 is taken by something that is not a collector (HTTP %s)' "$port" "$code"
  fi
}

# gm_collector_muster <show>: one muster's look at the collector; show as for gm_reconcile.
gm_collector_muster() {
  local show=$1 st detail attempts held told stale tell why line='' pane
  if [ "${GM_COLLECTOR:-}" != on ]; then
    [ -z "$(gm_endpoint collector)" ] || gm_collector_stop "collector is ${GM_COLLECTOR:-off}"
    return 0
  fi
  gm_collector_row
  IFS=$'\t' read -r attempts held told stale <<<"$(gm_sql "SELECT start_attempts, held_at IS NOT NULL, held_told,
    COALESCE(held_at < strftime('%Y-%m-%dT%H:%M:%fZ','now','-1 day'), 0) FROM endpoint WHERE key='collector';")"
  if [ "$held" = 1 ] && [ "$stale" = 1 ]; then
    gm_sql "BEGIN IMMEDIATE; UPDATE endpoint SET start_attempts=0, held_at=NULL, held_told=0 WHERE key='collector'; COMMIT;"
    attempts=0 held=0 told=0
  fi
  IFS=$'\t' read -r st detail <<<"$(gm_endpoint_state collector)"
  case $st in
    alive)
      [ "$attempts" = 0 ] && [ "$held" = 0 ] ||
        gm_sql "BEGIN IMMEDIATE; UPDATE endpoint SET start_attempts=0, held_at=NULL, held_told=0 WHERE key='collector'; COMMIT;"
      [ "$show" != all ] || line="collector: already running ($detail), left as it is" ;;
    dead | missing)
      why=$(gm_collector_blocker)
      if [ "$why" = answering ]; then
        [ "$show" != all ] || line="collector: a collector already answers on 127.0.0.1:${GM_OTEL_PORT:-4318}, so gm starts no second one"
      else
        if [ "$held" = 0 ] && [ "$attempts" -ge "$GM_START_TRIES" ]; then
          held=1 told=0
          gm_sql "BEGIN IMMEDIATE;
UPDATE endpoint SET held_at=$GM_NOW, held_told=0 WHERE key='collector';
INSERT INTO event(at, actor, kind, detail) VALUES ($GM_NOW, 'gm', 'collector.held', $(gm_q "failed to start $attempts times in a row; ${why:-$st: $detail}"));
COMMIT;"
        fi
        if [ "$held" = 1 ]; then
          tell=2
          [ "$show" != quiet ] || tell=1
          if [ "$show" = all ] || [ "$told" -lt "$tell" ]; then
            line="$GM_COLLECTOR_TAB: held: the tracing collector failed to start $attempts times in a row (${why:-$st: $detail}); gm tries again in a day, or now with gm config set collector on"
            [ "$told" -ge "$tell" ] || gm_sql "BEGIN IMMEDIATE; UPDATE endpoint SET held_told=$tell WHERE key='collector'; COMMIT;"
          fi
        elif [ -n "$why" ]; then
          gm_sql "BEGIN IMMEDIATE;
UPDATE endpoint SET start_attempts=start_attempts+1 WHERE key='collector';
INSERT INTO event(at, actor, kind, detail) VALUES ($GM_NOW, 'gm', 'collector.failed', $(gm_q "$why"));
COMMIT;"
          [ "$show" != all ] || line="collector: not started: $why"
        else
          gm_sql "BEGIN IMMEDIATE; UPDATE endpoint SET start_attempts=start_attempts+1 WHERE key='collector'; COMMIT;"
          if pane=$(gm_endpoint_launch collector "$st" "$detail"); then
            [ "$show" != all ] || line="collector: started in herdr pane $pane ($st: $detail)"
          else
            gm_sql "BEGIN IMMEDIATE; INSERT INTO event(at, actor, kind, detail) VALUES ($GM_NOW, 'gm', 'collector.failed', $(gm_q "$pane")); COMMIT;"
            [ "$show" != all ] || line="collector: could not start it ($st: $detail): $pane"
          fi
        fi
      fi ;;
    *) [ "$show" != all ] || line="collector: $st ($detail); left alone" ;;
  esac
  [ -z "$line" ] || printf '%s\n' "$line"
}

# Stops the collector gm keeps: closes its pane when it runs the collector, holds only a shell, or is starting, and
# forgets it. A pane running something else is only forgotten. One ledger row when there was a pane. Under the
# herdr lock.
gm_collector_stop() {
  local why=$1 s pane st
  IFS=$'\t' read -r s _ _ pane _ _ <<<"$(gm_endpoint collector)"
  if [ -n "$pane" ]; then
    IFS=$'\t' read -r st _ <<<"$(gm_endpoint_state collector)"
    case $st in alive | starting | dead) gm_herdr "$s" pane close "$pane" >/dev/null ;; esac
    gm_sql "BEGIN IMMEDIATE; INSERT INTO event(at, actor, kind, detail) VALUES ($GM_NOW, 'gm', 'collector.stopped', $(gm_q "$why; herdr session $s pane $pane, $st")); COMMIT;"
  fi
  gm_sql "BEGIN IMMEDIATE; DELETE FROM endpoint WHERE key='collector'; COMMIT;"
}

# After gm config set collector or collector-port: the collector started or stopped now, under the herdr lock, and
# one line saying what holds. A new port restarts it; setting it on again clears a hold.
gm_collector_apply() {
  local key=$1 out='' port=${GM_OTEL_PORT:-4318}
  gm_db_ensure
  if ! command -v "$GM_HERDR" >/dev/null 2>&1; then
    printf '%s is recorded in guild.conf; herdr is not installed, so nothing is started or stopped until it is.\n' "$key"
    return 0
  fi
  gm_herdr_lock 30 || gm_die "config: recorded, but another gm is bringing the guild up; the next muster acts on it"
  if [ "${GM_COLLECTOR:-}" != on ]; then
    [ -z "$(gm_endpoint collector)" ] || gm_collector_stop "gm config set $key"
    gm_herdr_unlock
    if [ "$key" = collector-port ]; then
      printf 'collector-port is %s: a collector gm starts listens there, and Party Leaders started from now on send to it.\n' "$port"
    else
      printf 'collector is %s: gm keeps no collector running, and says nothing about it.\n' "${GM_COLLECTOR:-off}"
    fi
    return 0
  fi
  if [ "$key" = collector-port ] && [ -n "$(gm_endpoint collector)" ]; then
    gm_collector_stop "gm config set collector-port $port"
  fi
  gm_sql "BEGIN IMMEDIATE; UPDATE endpoint SET start_attempts=0, held_at=NULL, held_told=0 WHERE key='collector'; COMMIT;"
  out=$( (gm_herdr_server_ensure "$GM_HERDR_SESSION" && gm_herdr_workspace >/dev/null && gm_collector_muster all) 2>&1) || true
  gm_herdr_unlock
  case $out in
    *'already answers'*) printf 'collector is on: a collector already answers on 127.0.0.1:%s, so gm starts no second one; when it stops, gm keeps its own running in herdr tab %s.\n' "$port" "$GM_COLLECTOR_TAB" ;;
    *'not started: '*) printf 'collector is on, but the collector could not start: %s\n' "${out#*not started: }" ;;
    *'started in herdr pane'* | *'already running'*) printf 'collector is on: gm keeps the tracing collector running in herdr tab %s, on 127.0.0.1:%s; Party Leaders started from now on send to it.\n' "$GM_COLLECTOR_TAB" "$port" ;;
    *) out=${out#collector: }; printf 'collector is on, but %s\n' "${out:-gm could not reach herdr; the next muster tries again}" ;;
  esac
}

GM_HERDR_LOCKED=''

# One gm at a time brings Party Leaders up, so two never launch the same one. gm_herdr_lock <seconds to wait>.
gm_herdr_lock() {
  local dir=$GM_HALL/herdr.lock pid waited=0
  mkdir -p "$GM_HALL"
  while ! mkdir "$dir" 2>/dev/null; do
    pid=$(cat "$dir/pid" 2>/dev/null || true)
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$dir/pid"
      rmdir "$dir" 2>/dev/null || true
      continue
    fi
    [ "$waited" -lt "$1" ] || return 1
    sleep 1
    waited=$((waited + 1))
  done
  printf '%s' "$$" >"$dir/pid"
  GM_HERDR_LOCKED=$dir
  trap gm_herdr_unlock EXIT
}

gm_herdr_unlock() {
  [ -n "$GM_HERDR_LOCKED" ] || return 0
  rm -f "$GM_HERDR_LOCKED/pid"
  rmdir "$GM_HERDR_LOCKED" 2>/dev/null || true
  GM_HERDR_LOCKED=''
}

gm_herdr_attach_hint() {
  if [ "$GM_HERDR_SESSION" = default ]; then
    printf 'See them in herdr, workspace %s: run herdr\n' "$GM_HERDR_WORKSPACE"
  else
    printf 'See them in herdr, workspace %s: run herdr --session %s\n' "$GM_HERDR_WORKSPACE" "$GM_HERDR_SESSION"
  fi
}

# gm open's launch: the whole muster, reporting this focus.
gm_party_leader_up() {
  local focus=$1
  gm_herdr_lock 30 || gm_die "open: another gm is bringing Party Leaders up; try again in a moment"
  gm_sql "BEGIN IMMEDIATE; UPDATE focus SET start_attempts=0, held_at=NULL, held_told=0 WHERE name=$(gm_q "$focus"); COMMIT;"
  gm_reconcile "$focus"
  gm_herdr_unlock
}

# One line saying where a focus's Party Leader is in herdr: what the Guildmaster tells the patron. Its own workspace,
# or a tab of the guild's for one started before each had a workspace of its own.
gm_party_leader_where() {
  local focus=$1 s pane label where see=herdr
  IFS=$'\t' read -r s _ _ pane label _ <<<"$(gm_endpoint "party-leader:$focus")"
  [ -n "$pane" ] || return 0
  if [ "$label" = "$(gm_party_leader_label "$focus")" ]; then
    where="workspace $label, under $GM_HERDR_WORKSPACE (pane $pane)"
  else
    where="tab $label (workspace $GM_HERDR_WORKSPACE, pane $pane)"
  fi
  [ "$s" = default ] || see="herdr --session $s"
  printf "%s's Party Leader is in herdr %s; see it with: %s\n" "$focus" "$where" "$see"
}

# Whether there is anything for the muster to keep running: an open focus, or the front desk.
gm_guild_exists() {
  [ -s "$GM_DB" ] && [ -n "$(gm_sql "SELECT 1 FROM focus WHERE closed_at IS NULL UNION ALL SELECT 1 FROM endpoint WHERE key='front-desk' LIMIT 1;" 2>/dev/null)" ]
}

# A closed focus is reopened; one whose Party Leader asked to close and has not yet is kept open instead.
gm_reopen_focus() {
  if [ -z "$(gm_focus_field "$1" closed_at)" ]; then
    [ -n "$(gm_focus_field "$1" close_requested_at)" ] || return 0
    gm_sql "BEGIN IMMEDIATE;
$(gm_close_cancel_sql "name=$(gm_q "$1")" patron)
COMMIT;"
    return 0
  fi
  gm_sql "BEGIN IMMEDIATE;
UPDATE focus SET closed_at=NULL, close_requested_at=NULL WHERE name=$(gm_q "$1");
INSERT INTO event(at, actor, kind, focus_id, line) SELECT $GM_NOW, 'patron', 'focus.reopened', id, name||' reopened' FROM focus WHERE name=$(gm_q "$1");
COMMIT;"
}

# gm_close_cancel_sql <focus condition> <actor>: a pending close request is dropped, with one ledger row.
gm_close_cancel_sql() {
  printf "INSERT INTO event(at, actor, kind, focus_id, line) SELECT %s, %s, 'focus.close-cancelled', id, name||' stays open' FROM focus WHERE %s AND close_requested_at IS NOT NULL AND closed_at IS NULL;
UPDATE focus SET close_requested_at=NULL WHERE %s AND closed_at IS NULL;" "$GM_NOW" "$(gm_q "$2")" "$1" "$1"
}

# After gm init: the muster once, and autostart on, since it is always on unless the patron turned it off.
gm_init_muster() {
  command -v "$GM_HERDR" >/dev/null 2>&1 && [ -s "$GM_DB" ] || return 0
  if gm_guild_exists; then
    (gm_telemetry_refuse && gm_herdr_lock 30 && gm_reconcile changes) >&2 || true
  fi
  local auto
  auto=$(gm_autostart_ensure)
  case $auto in
    installed) gm_say "autostart is on: launchd brings the Guildmaster and the Party Leaders back at login and every $(gm_autostart_every) minutes (gm autostart off stops it)" ;;
    failed:*) gm_say "autostart could not be turned on: ${auto#failed: }" ;;
  esac
}

gm_cmd_up() {
  local show=all
  case ${1:-} in
    '') ;;
    --quiet) show=quiet ;;
    *) gm_die "up: gm up [--quiet]" ;;
  esac
  gm_herdr_require up
  gm_telemetry_refuse
  gm_db_ensure
  gm_herdr_lock 30 || gm_die "up: another gm is bringing Party Leaders up; try again in a moment"
  if ! gm_guild_exists; then
    [ "$show" = quiet ] || printf 'Nothing to bring up yet: start claude in %s, or run gm, to open the front desk; or gm open <focus> --repo <path>.\n' "$GM_ROOT"
    return 0
  fi
  gm_reconcile "$show"
  gm_herdr_unlock
  [ "$show" = quiet ] || gm_herdr_attach_hint
}

# The same muster, quietly, before the patron's own commands at a terminal. Never from a Party Leader, a hook or
# a pipe, and never fatal: what it did or could not do is said on stderr.
gm_auto_reconcile() {
  [ "${GM_HERDR_AUTO:-on}" != off ] || return 0
  [ -z "${GM_FOCUS:-}" ] && [ -z "${CLAUDECODE:-}" ] || return 0
  gm_init_interactive || return 0
  gm_guild_exists || return 0
  if ! command -v "$GM_HERDR" >/dev/null 2>&1; then
    printf 'gm: herdr is not installed, so no Party Leader is kept running (README.md)\n' >&2
    return 0
  fi
  (gm_telemetry_refuse && gm_herdr_lock 0 && gm_reconcile changes) >&2 || true
}

gm_cmd_roster() {
  local all=0 where focus st detail pane closed held attempts last have=1 row s ws
  while [ $# -gt 0 ]; do
    case $1 in
      --all) all=1; shift ;;
      *) gm_die "roster: gm roster [--all]" ;;
    esac
  done
  gm_db_ensure
  command -v "$GM_HERDR" >/dev/null 2>&1 || have=0
  gm_roster_line() { printf '%-24s %-13s %-8s %-8s %s\n' "$@"; }
  row=$(gm_endpoint front-desk)
  if [ -n "$row" ]; then
    IFS=$'\t' read -r _ _ _ pane _ _ <<<"$row"
    if [ "$have" = 0 ]; then
      st=unknown detail="herdr is not installed"
    else
      IFS=$'\t' read -r st detail <<<"$(gm_endpoint_state front-desk)"
    fi
    IFS=$'\t' read -r held attempts last <<<"$(gm_sql "SELECT COALESCE(held_at,'-'), start_attempts,
      COALESCE((SELECT replace(substr(e.at,1,16),'T',' ') FROM event e WHERE e.kind='front-desk.launched' ORDER BY e.id DESC LIMIT 1),'-')
      FROM endpoint WHERE key='front-desk';")"
    if [ "$held" != - ] && [ "$st" != alive ]; then
      st=held detail="failed to start $attempts times in a row; gm tries again"
    fi
    [ "$last" = - ] || detail="${detail:+$detail · }last started $last"
    gm_roster_line "$GM_FRONT_DESK" "front desk" "$st" "$pane" "$detail"
  fi
  # The tracing collector, while guild.conf says collector: on, or while gm still records one.
  row=$(gm_endpoint collector)
  if [ -n "$row" ] || [ "${GM_COLLECTOR:-}" = on ]; then
    IFS=$'\t' read -r _ _ _ pane _ _ <<<"$row"
    if [ "$have" = 0 ]; then
      st=unknown detail="herdr is not installed"
    else
      IFS=$'\t' read -r st detail <<<"$(gm_endpoint_state collector)"
    fi
    IFS=$'\t' read -r held attempts last <<<"$(gm_sql "SELECT COALESCE(held_at,'-'), start_attempts,
      COALESCE((SELECT replace(substr(e.at,1,16),'T',' ') FROM event e WHERE e.kind='collector.launched' ORDER BY e.id DESC LIMIT 1),'-')
      FROM endpoint WHERE key='collector';")"
    if [ "${held:--}" != - ] && [ "$st" != alive ]; then
      st=held detail="failed to start $attempts times in a row; gm tries again in a day"
    fi
    [ "${last:--}" = - ] || detail="${detail:+$detail · }last started $last"
    gm_roster_line "$GM_COLLECTOR_TAB" "collector" "$st" "${pane:--}" "$detail"
  fi
  where="f.closed_at IS NULL"
  [ "$all" = 0 ] || where=1
  while IFS=$'\t' read -r focus closed held attempts last; do
    [ -n "$focus" ] || continue
    [ "$closed" != - ] || closed=''
    [ "$held" != - ] || held=''
    [ "$last" != - ] || last=
    pane=$(gm_sql "SELECT pane_id FROM endpoint WHERE key=$(gm_q "party-leader:$focus");")
    if [ -n "$closed" ]; then
      st=closed detail="since $closed"
    elif [ "$have" = 0 ]; then
      st=unknown detail="herdr is not installed"
    else
      IFS=$'\t' read -r st detail <<<"$(gm_endpoint_state "party-leader:$focus")"
      if [ -n "$held" ] && [ "$st" != alive ]; then
        st=held detail="failed to start $attempts times in a row; gm open $focus tries again"
      fi
    fi
    [ -n "$closed" ] || [ -z "$(gm_focus_field "$focus" close_requested_at)" ] || detail="${detail:+$detail · }closing, as its Party Leader asked"
    [ -z "$last" ] || detail="${detail:+$detail · }last started $last"
    gm_roster_line "$focus" "party leader" "$st" "${pane:--}" "$detail"
  done <<<"$(gm_sql "SELECT f.name, COALESCE(f.closed_at,'-'), COALESCE(f.held_at,'-'), f.start_attempts,
    COALESCE((SELECT replace(substr(e.at,1,16),'T',' ') FROM event e WHERE e.focus_id=f.id AND e.kind='party-leader.launched' ORDER BY e.id DESC LIMIT 1),'-')
    FROM focus f WHERE $where ORDER BY f.name;")"
}

# Retires a focus: its Party Leader is no longer started, and its pane is closed once it holds only a shell. A
# live Party Leader is never killed by gm. From a terminal or the front desk, the patron ends it in its workspace first.
# From inside that Party Leader (GM_FOCUS is the focus), with every posting finished, close is a request instead:
# it is recorded, and a gm of its own, detached from the session, waits for the Party Leader's turn to end, types
# /exit in its pane, and closes the focus once the pane holds only a shell. The muster finishes a request the
# finisher could not. A new message from the patron to that focus cancels it. The camp and postings stay.
gm_cmd_close() {
  local focus='' finish='' row s pane st='' detail open
  while [ $# -gt 0 ]; do
    case $1 in
      --finish) finish=1; shift ;;
      -*) gm_die "close: unknown option $1" ;;
      *) [ -z "$focus" ] || gm_die "close: one focus at a time"; focus=$1; shift ;;
    esac
  done
  [ -n "$focus" ] || gm_die "close: name the focus to close"
  gm_db_ensure
  [ -n "$(gm_focus_id "$focus")" ] || gm_die "no focus named '$focus'"
  if [ -n "$(gm_focus_field "$focus" closed_at)" ]; then
    printf '%s is already closed\n' "$focus"
    return 0
  fi
  if [ -n "$finish" ]; then
    gm_close_finish "$focus"
    return
  fi
  if gm_close_self "$focus"; then
    open=$(gm_sql "SELECT group_concat('#'||num||' '||slug||' '||state, ', ') FROM (SELECT num, slug, state FROM posting
      WHERE focus_id=(SELECT id FROM focus WHERE name=$(gm_q "$focus")) AND state NOT IN ('done','failed','closed') ORDER BY num);")
    [ -z "$open" ] || gm_die "close: $focus still has postings that are not finished: $open; record each one's outcome first (gm notice <n> done|failed|closed), then gm close $focus"
  fi
  gm_herdr_lock 30 || gm_die "close: another gm is bringing Party Leaders up; try again in a moment"
  row=$(gm_endpoint "party-leader:$focus")
  if [ -n "$row" ]; then
    gm_herdr_require close
    IFS=$'\t' read -r s _ _ pane _ _ <<<"$row"
    IFS=$'\t' read -r st detail <<<"$(gm_endpoint_state "party-leader:$focus")"
    case $st in
      dead | missing) ;;
      *)
        if gm_close_self "$focus"; then
          gm_close_request "$focus"
          return
        fi
        gm_die "close: $focus's Party Leader is $st ($detail) in herdr pane $pane; end it there first (/exit), then gm close $focus" ;;
    esac
  fi
  gm_close_done "$focus" "$st" patron
  gm_herdr_unlock
  printf '%s is closed: its Party Leader is not started again. Its camp %s and its postings are kept; gm open %s reopens it.\n' "$focus" "$(gm_focus_field "$focus" camp)" "$focus"
}

# gm_close_self <focus>: this is that focus's Party Leader: GM_FOCUS names it, and herdr's own variables put this
# session in its recorded pane. Any other claude in the camp has GM_FOCUS too, and is not it.
gm_close_self() {
  local rs pane
  [ "${GM_FOCUS:-}" = "$1" ] && [ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] || return 1
  IFS=$'\t' read -r rs _ _ pane _ _ <<<"$(gm_endpoint "party-leader:$1")"
  [ "$pane" = "$HERDR_PANE_ID" ] && [ "$rs" = "${HERDR_SESSION:-default}" ]
}

# gm_close_done <focus> <state> <actor>: under the herdr lock, with the Party Leader dead or missing (or no pane
# recorded), the husk pane is closed and the focus is retired in the register.
gm_close_done() {
  local focus=$1 st=$2 s pane
  if [ "$st" = dead ]; then
    IFS=$'\t' read -r s _ _ pane _ _ <<<"$(gm_endpoint "party-leader:$focus")"
    gm_herdr "$s" pane close "$pane" >/dev/null
  fi
  gm_sql "BEGIN IMMEDIATE;
UPDATE focus SET closed_at=$GM_NOW, close_requested_at=NULL WHERE name=$(gm_q "$focus");
DELETE FROM endpoint WHERE key=$(gm_q "party-leader:$focus");
INSERT INTO event(at, actor, kind, focus_id, line) SELECT $GM_NOW, $(gm_q "$3"), 'focus.closed', id, name||' closed' FROM focus WHERE name=$(gm_q "$focus");
COMMIT;"
}

# The Party Leader asked to close its own focus: recorded, then the finisher is started in its own process group,
# away from the session's pipes, so it outlives the claude it ends. Runs under the herdr lock, and releases it.
gm_close_request() {
  local focus=$1
  gm_sql "BEGIN IMMEDIATE;
UPDATE focus SET close_requested_at=$GM_NOW WHERE name=$(gm_q "$focus");
INSERT INTO event(at, actor, kind, focus_id, line) SELECT $GM_NOW, 'party-leader', 'focus.close-requested', id, name||' asked to close' FROM focus WHERE name=$(gm_q "$focus");
COMMIT;"
  gm_herdr_unlock
  gm_close_spawn "$focus"
  printf '%s closes when this turn ends: gm types /exit in its pane once its Party Leader is idle, then closes the focus. Its camp and postings are kept; gm open %s reopens it. A new message from the patron here before then cancels the close.\n' "$focus" "$focus"
}

# The finisher of one focus's close request, at most one at a time: its pid is kept in close.<focus>.pid in the
# Guildhall, and a finisher whose pid is no longer there stops. Only the finisher runs in the background, with none
# of this command's output open, so neither the Party Leader's tool call nor a $(...) waits for it.
gm_close_spawn() {
  local pid
  pid=$(cat "$GM_HALL/close.$1.pid" 2>/dev/null || true)
  [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null || return 0
  mkdir -p "$GM_HALL"
  (
    set -m
    cd /
    env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_SESSION_ID -u TRACEPARENT -u GM_FOCUS \
      nohup bash "$GM_SELF" close "$1" --finish </dev/null >>"$GM_HALL/close.log" 2>&1 &
    printf '%s' "$!" >"$GM_HALL/close.$1.pid"
  )
}

# The close is still asked for and not yet done.
gm_close_pending() {
  [ -n "$(gm_sql "SELECT 1 FROM focus WHERE name=$(gm_q "$1") AND close_requested_at IS NOT NULL AND closed_at IS NULL;")" ]
}

# gm_close_exit <focus>: types /exit into the Party Leader's pane, as the patron would; the text, then Enter. Only
# while the close is still asked for: the patron's message may have cancelled it a moment ago.
gm_close_exit() {
  local s pane
  gm_close_pending "$1" || return 0
  IFS=$'\t' read -r s _ _ pane _ _ <<<"$(gm_endpoint "party-leader:$1")"
  [ -n "$pane" ] || return 0
  gm_herdr "$s" pane send-text "$pane" /exit >/dev/null
  gm_herdr "$s" pane send-keys "$pane" enter >/dev/null
  gm_sql "BEGIN IMMEDIATE;
INSERT INTO event(at, actor, kind, focus_id, detail) SELECT $GM_NOW, 'gm', 'party-leader.exit', id, $(gm_q "typed /exit in herdr pane $pane, as it asked to close") FROM focus WHERE name=$(gm_q "$1");
COMMIT;"
}

# gm close <focus> --finish, started by gm_close_request: waits up to GM_CLOSE_WAIT seconds for the Party Leader to
# finish its turn (herdr says idle or done, twice in a row, so a moment between tool calls is not taken for the
# end of the turn), types /exit (again every GM_CLOSE_RESEND seconds while it stays idle),
# and closes the focus once its pane holds only a shell. A cancelled request ends it; the muster finishes one it
# gave up on.
gm_close_finish() {
  local focus=$1 waited=0 sent=-1 idle=0 st detail pidf=$GM_HALL/close.$1.pid
  local wait=${GM_CLOSE_WAIT:-900} poll=${GM_CLOSE_POLL:-2} resend=${GM_CLOSE_RESEND:-30}
  # The spawner writes the pid file just after starting this; a moment's wait for it.
  while [ ! -s "$pidf" ] && [ "$waited" -lt 5 ]; do sleep 1; waited=$((waited + 1)); done
  waited=0
  while [ "$waited" -lt "$wait" ]; do
    [ "$(cat "$pidf" 2>/dev/null || true)" = "$$" ] || return 0
    if ! gm_close_pending "$focus"; then
      rm -f "$pidf"
      return 0
    fi
    IFS=$'\t' read -r st detail <<<"$(gm_endpoint_state "party-leader:$focus")"
    case $st in
      dead | missing)
        gm_herdr_lock 30 || { sleep "$poll"; waited=$((waited + poll)); continue; }
        st=''
        if gm_close_pending "$focus"; then
          IFS=$'\t' read -r st detail <<<"$(gm_endpoint_state "party-leader:$focus")"
          case $st in dead | missing) gm_close_done "$focus" "$st" gm ;; esac
        fi
        gm_herdr_unlock
        case $st in dead | missing) rm -f "$pidf"; printf '%s closed, as its Party Leader asked\n' "$focus"; return 0 ;; esac ;;
      alive)
        case $detail in
          idle | done)
            idle=$((idle + 1))
            if [ "$idle" -ge 2 ] && { [ "$sent" -lt 0 ] || [ $((waited - sent)) -ge "$resend" ]; }; then
              gm_close_exit "$focus"
              sent=$waited
            fi ;;
          *) idle=0 ;;
        esac ;;
      *) idle=0 ;;
    esac
    sleep "$poll"
    waited=$((waited + poll))
  done
  rm -f "$pidf"
  printf '%s: its Party Leader did not end within %s seconds; the muster finishes the close\n' "$focus" "$wait"
}

# What a Party Leader's pane runs: claude in the camp, with the telemetry environment gm open has always set.
# Only in the pane gm recorded for that focus, so nothing starts a second Party Leader beside a recorded one.
gm_cmd_start() {
  local focus='' pane='' camp claude=${GM_CLAUDE:-claude} envargs=() a
  while [ $# -gt 0 ]; do
    case $1 in
      --pane) pane=${2:?--pane needs a pane id}; shift 2 ;;
      -*) gm_die "start: unknown option $1" ;;
      *) [ -z "$focus" ] || gm_die "start: one focus at a time"; focus=$1; shift ;;
    esac
  done
  [ -n "$focus" ] || gm_die "start: name the focus"
  gm_db_ensure
  if [ "$focus" = "$GM_FRONT_DESK" ]; then
    gm_front_desk_start "$pane"
    return
  fi
  if [ "$focus" = "$GM_COLLECTOR_TAB" ]; then
    [ -n "$pane" ] && [ "$pane" = "$(gm_sql "SELECT pane_id FROM endpoint WHERE key='collector';")" ] ||
      gm_die "start: gm start $GM_COLLECTOR_TAB runs only in the collector's own herdr pane; gm keeps it there while guild.conf says collector: on"
    gm_collector_exec
  fi
  [ -n "$(gm_focus_id "$focus")" ] || gm_die "no focus named '$focus'"
  [ -z "$(gm_focus_field "$focus" closed_at)" ] || gm_die "start: $focus is closed; gm open $focus reopens it"
  [ -n "$pane" ] && [ "$pane" = "$(gm_sql "SELECT pane_id FROM endpoint WHERE key=$(gm_q "party-leader:$focus");")" ] ||
    gm_die "start: gm start runs only in $focus's own herdr pane; gm open $focus starts its Party Leader there"
  gm_telemetry_refuse
  while IFS= read -r a; do
    [ -z "$a" ] || envargs+=("$a")
  done <<<"$(gm_telemetry_env "$focus")"
  if [ "${#envargs[@]}" -gt 0 ] && [ "$(gm_otlp_status "$(gm_otel_endpoint)")" != 200 ]; then
    printf 'gm: no collector answers at %s, so this session'\''s telemetry will be lost; start one with gm collector\n' "$(gm_otel_endpoint)" >&2
  fi
  camp=$(gm_focus_field "$focus" camp)
  gm_chat_args "$camp" "$focus"
  cd "$camp"
  exec env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_SESSION_ID -u TRACEPARENT -u GM_FOCUS \
    -u GM_CHAT_FOCUS ${envargs[@]+"${envargs[@]}"} ${GM_CHAT_ENV[@]+"${GM_CHAT_ENV[@]}"} "$claude" --name "$focus" \
    ${GM_CHAT_ARGS[@]+"${GM_CHAT_ARGS[@]}"}
}

# The chat setting, for a session gm starts in <dir>: gm_chat_args <dir> [focus]. With chat: banners, claude loads
# the guild-chat mod from the clone (--plugin-dir), told by GM_CHAT_FOCUS which Party Leader it draws for (none at
# the front desk). A checkout of Guildmaster loads the mod itself, from .claude/skills/guild-chat, so there gm passes
# only the variables: a second copy by --plugin-dir would leave Claude Code reporting the first as not loaded.
GM_CHAT_ARGS=()
GM_CHAT_ENV=()
gm_chat_args() {
  GM_CHAT_ARGS=()
  GM_CHAT_ENV=()
  gm_conf_norm chat "${GM_CHAT:-banners}" && [ "$GM_CONF_VAL" != off ] || return 0
  [ -f "$1/.claude/skills/guild-chat/.claude-plugin/plugin.json" ] || GM_CHAT_ARGS=(--plugin-dir "$GM_ROOT/mods/guild-chat")
  GM_CHAT_ENV=("GM_CHAT=$GM_CONF_VAL")
  [ -z "${2:-}" ] || GM_CHAT_ENV+=("GM_CHAT_FOCUS=$2")
}

# What the front desk's pane runs: the Guildmaster, claude in the clone, whose committed SessionStart hook does the
# rest. Only in the pane gm recorded for the front desk, so there is never a second one beside it.
gm_front_desk_start() {
  local pane=$1 claude=${GM_CLAUDE:-claude}
  [ -n "$pane" ] && [ "$pane" = "$(gm_sql "SELECT pane_id FROM endpoint WHERE key='front-desk';")" ] ||
    gm_die "start: gm start $GM_FRONT_DESK runs only in the front desk's own herdr pane; gm opens it there"
  gm_front_desk_files
  gm_chat_args "$GM_ROOT"
  cd "$GM_ROOT"
  exec env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_SESSION_ID -u TRACEPARENT -u GM_FOCUS \
    -u GM_CHAT_FOCUS ${GM_CHAT_ENV[@]+"${GM_CHAT_ENV[@]}"} "$claude" --name "$GM_FRONT_DESK" \
    ${GM_CHAT_ARGS[@]+"${GM_CHAT_ARGS[@]}"}
}

# ---- Autostart: a launchd user agent runs gm up --quiet at login and every few minutes (macOS) ----

GM_LAUNCH_AGENTS=${GM_LAUNCH_AGENTS:-$HOME/Library/LaunchAgents}
GM_LAUNCHCTL=${GM_LAUNCHCTL:-launchctl}

gm_autostart_label() {
  if [ "$GM_HALL" = "$HOME/.guildmaster" ]; then
    printf 'com.guildmaster.up'
  else
    printf 'com.guildmaster.up.%s' "$(printf '%s' "$GM_HALL" | cksum | cut -d ' ' -f 1)"
  fi
}

gm_xml() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

# The agent's property list: gm up --quiet with the environment gm runs with now (launchd's own PATH would not
# find herdr or claude), at load, which is login, and every <seconds>; its output goes to the Guildhall.
gm_autostart_plist() {
  local label=$1 every=$2 v val env=''
  for v in GM_HALL PATH HOME GM_HERDR GM_HERDR_SESSION GM_HERDR_WORKSPACE GM_CLAUDE GM_TELEMETRY GM_CHAT GM_OTEL_ENDPOINT GM_OTEL_PORT GM_COLLECTOR GM_OTELCOL; do
    gm_conf_carried "$v" || continue
    eval "val=\${$v:-}"
    # ~/.local/bin, where gm is linked and herdr's and Claude Code's installers put them, is always on the agent's PATH.
    if [ "$v" = PATH ]; then
      case ":$val:" in *":$HOME/.local/bin:"*) ;; *) val=$HOME/.local/bin${val:+:$val} ;; esac
    fi
    [ -z "$val" ] || env="$env    <key>$v</key><string>$(gm_xml "$val")</string>
"
  done
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$(gm_xml "$label")</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$(gm_xml "$GM_SELF")</string>
    <string>up</string>
    <string>--quiet</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
$env  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>$every</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>$(gm_xml "$GM_HALL/autostart.log")</string>
  <key>StandardErrorPath</key><string>$(gm_xml "$GM_HALL/autostart.log")</string>
</dict>
</plist>
EOF
}

# Writes and loads the agent; gm_autostart_install <minutes>.
gm_autostart_install() {
  local every=$1 label plist domain
  label=$(gm_autostart_label)
  plist=$GM_LAUNCH_AGENTS/$label.plist
  domain=gui/$(id -u)
  mkdir -p "$GM_LAUNCH_AGENTS" "$GM_HALL"
  gm_autostart_plist "$label" $((every * 60)) >"$plist.tmp"
  mv "$plist.tmp" "$plist"
  "$GM_LAUNCHCTL" bootout "$domain/$label" >/dev/null 2>&1 || true
  "$GM_LAUNCHCTL" bootstrap "$domain" "$plist" >/dev/null 2>&1 || { printf 'launchctl would not load %s' "$plist"; return 1; }
}

# The minutes between the agent's musters: guild.conf's autostart-every, or 5.
gm_autostart_every() {
  local v
  v=$(gm_conf_get autostart-every)
  if [ -n "$v" ] && gm_conf_norm minutes "$v"; then printf '%s' "$GM_CONF_VAL"; else printf '5'; fi
}

# Autostart is always on unless the patron turned it off (guild.conf autostart: off). The agent is written and loaded
# only when it is not loaded already, or runs at another interval than autostart-every, so a repeat changes nothing.
# Prints installed, on, off, unsupported, or failed: <why>.
gm_autostart_ensure() {
  local label out every plist
  [ "$(uname -s)" = Darwin ] || { printf 'unsupported'; return 0; }
  [ "$(gm_conf_get autostart)" != off ] || { printf 'off'; return 0; }
  command -v "$GM_HERDR" >/dev/null 2>&1 || { printf 'failed: herdr is not installed'; return 0; }
  label=$(gm_autostart_label)
  plist=$GM_LAUNCH_AGENTS/$label.plist
  every=$(gm_autostart_every)
  if [ -f "$plist" ] && tr -d ' \n\t' <"$plist" | grep -q "<key>StartInterval</key><integer>$((every * 60))</integer>" &&
    "$GM_LAUNCHCTL" print "gui/$(id -u)/$label" >/dev/null 2>&1; then
    printf 'on'
  elif out=$(gm_autostart_install "$every" 2>&1); then
    printf 'installed'
  else
    printf 'failed: %s' "$out"
  fi
}

gm_cmd_autostart() {
  local action=${1:-status} every='' label plist domain err
  [ $# -eq 0 ] || shift
  while [ $# -gt 0 ]; do
    case $1 in
      --every) every=${2:?--every needs minutes}; shift 2 ;;
      *) gm_die "autostart: gm autostart [on [--every MINUTES] | off | status]" ;;
    esac
  done
  [ -z "$every" ] || { gm_is_int "$every" && [ "$every" -ge 1 ]; } || gm_die "autostart: --every takes whole minutes, 1 or more"
  [ "$(uname -s)" = Darwin ] || gm_die "autostart: gm installs a launchd agent, which is macOS's; elsewhere run gm up --quiet from a timer (vision/herdr-design.md)"
  label=$(gm_autostart_label)
  plist=$GM_LAUNCH_AGENTS/$label.plist
  domain=gui/$(id -u)
  case $action in
    on)
      gm_herdr_require autostart
      [ -z "$every" ] || gm_conf_set autostart-every "$every"
      every=$(gm_autostart_every)
      err=$(gm_autostart_install "$every") || gm_die "autostart: $err"
      gm_conf_set autostart on
      printf 'autostart is on: launchd runs gm up --quiet at login and every %s minutes (%s, log %s)\n' "$every" "$plist" "$GM_HALL/autostart.log" ;;
    off)
      "$GM_LAUNCHCTL" bootout "$domain/$label" >/dev/null 2>&1 || true
      rm -f "$plist"
      gm_conf_set autostart off
      printf 'autostart is off, and stays off: the Guildmaster no longer turns it on. Party Leaders come back when you run gm, or with gm up; gm autostart on turns it back on\n' ;;
    status)
      if [ -f "$plist" ] && "$GM_LAUNCHCTL" print "$domain/$label" >/dev/null 2>&1; then
        printf 'autostart is on: %s\n' "$plist"
      elif [ -f "$plist" ]; then
        printf 'autostart is installed but not loaded: %s (gm autostart on loads it)\n' "$plist"
      else
        printf 'autostart is off (gm autostart on)\n'
      fi ;;
    *) gm_die "autostart: gm autostart [on [--every MINUTES] | off | status]" ;;
  esac
}

# Installs herdr when the patron said yes to the Guildmaster's offer: with Homebrew when it is there, otherwise with
# herdr's official installer, never with sudo; then finishes the setup the front desk's hook could not do without it.
gm_cmd_install() {
  local brew=${GM_BREW:-brew} url=${GM_HERDR_INSTALLER:-https://herdr.dev/install.sh} how p
  [ "${1:-}" = herdr ] && [ $# -eq 1 ] || gm_die "install: gm install herdr"
  if command -v "$GM_HERDR" >/dev/null 2>&1; then
    printf 'herdr is already installed, at %s\n' "$(command -v "$GM_HERDR")"
    return 0
  fi
  if command -v "$brew" >/dev/null 2>&1; then
    how='with Homebrew'
    "$brew" install herdr </dev/null >&2 || gm_die "install: brew install herdr failed; nothing else was changed"
  else
    how="with herdr's official installer"
    curl -fsSL "$url" </dev/null | sh >&2 || gm_die "install: herdr's official installer ($url) failed; nothing else was changed"
  fi
  p=$(command -v herdr 2>/dev/null || true)
  [ -n "$p" ] || { [ ! -x "$HOME/.local/bin/herdr" ] || p=$HOME/.local/bin/herdr; }
  [ -n "$p" ] || gm_die "install: the installer finished, but herdr is neither on the PATH nor in ~/.local/bin"
  GM_HERDR=$p
  gm_db_ensure
  [ -n "$(gm_required_problems)" ] || [ -n "$(gm_conf_get initialized)" ] || gm_conf_set initialized "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  gm_front_desk_files
  # The Guildmaster lives in herdr: start it there now, with every Party Leader.
  (gm_telemetry_refuse && gm_herdr_lock 30 && gm_reconcile changes) >&2 || true
  gm_init_muster
  printf 'herdr is installed %s, at %s; the guild is set up, and the Guildmaster is in herdr tab %s: %s.\n' "$how" "$p" "$GM_FRONT_DESK" "$(gm_front_desk_way)"
}

# ---- gm alone: the one thing the patron runs (vision/zero-touch-start.md) ----

# Opens the front desk: the Guildmaster's files, the muster (which starts the Guildmaster in the guild workspace's
# first tab, and every Party Leader), and then herdr at that tab. Inside herdr it only switches to the tab; without
# a terminal, or with GM_ATTACH=off, it says where the Guildmaster is and returns.
gm_cmd_front_desk() {
  local problems s ws tab pane out auto
  [ $# -eq 0 ] || gm_die "unknown command '$1' (gm help lists them; gm alone opens the front desk)"
  problems=$(gm_required_problems)
  [ -z "$problems" ] || gm_die "the Guildmaster cannot start until these are installed:
${problems%
}"
  gm_telemetry_refuse
  gm_db_ensure
  gm_front_desk_files
  gm_herdr_lock 30 || gm_die "another gm is bringing the guild up; try again in a moment"
  gm_sql "BEGIN IMMEDIATE; UPDATE endpoint SET start_attempts=0, held_at=NULL, held_told=0 WHERE key='front-desk'; COMMIT;"
  out=$(gm_reconcile changes)
  gm_herdr_unlock
  [ -z "$out" ] || printf '%s\n' "$out" >&2
  auto=$(gm_autostart_ensure)
  case $auto in failed:*) gm_say "gm: autostart could not be turned on: ${auto#failed: }" ;; esac
  IFS=$'\t' read -r s ws tab pane _ _ <<<"$(gm_endpoint front-desk)"
  [ -n "$pane" ] || gm_die "herdr gave the front desk no pane"
  if gm_attach_ok; then
    gm_herdr "$s" workspace focus "$ws" >/dev/null
    gm_herdr "$s" tab focus "$tab" >/dev/null
    if [ -n "${HERDR_ENV:-}" ]; then
      printf 'The Guildmaster is in the %s tab of workspace %s.\n' "$GM_FRONT_DESK" "$GM_HERDR_WORKSPACE"
      return 0
    fi
    if [ "$s" = default ]; then exec "$GM_HERDR"; else exec "$GM_HERDR" --session "$s"; fi
  fi
  if [ "$s" = default ]; then
    printf 'The Guildmaster is in herdr tab %s (workspace %s, pane %s); see it with: herdr\n' "$GM_FRONT_DESK" "$GM_HERDR_WORKSPACE" "$pane"
  else
    printf 'The Guildmaster is in herdr tab %s (workspace %s, pane %s); see it with: herdr --session %s\n' "$GM_FRONT_DESK" "$GM_HERDR_WORKSPACE" "$pane" "$s"
  fi
}

# Whether gm alone may attach herdr in this terminal: GM_ATTACH=off never; GM_INTERACTIVE as for questions (tests);
# otherwise when both stdin and stdout are a terminal.
gm_attach_ok() {
  [ "${GM_ATTACH:-on}" != off ] || return 1
  case ${GM_INTERACTIVE:-} in
    1) return 0 ;;
    0) return 1 ;;
  esac
  [ -t 0 ] && [ -t 1 ]
}

# Repositories the Guildmaster can open a focus on: those gm already knows from its focuses, then git clones under
# the usual source folders (or guild.conf's repo-roots:, space-separated) whose folder name contains the word. One
# path a line, known ones first; the Guildmaster asks the patron when it is not exactly one.
gm_cmd_repos() {
  local word=${1:-} roots r known
  [ $# -le 1 ] || gm_die "repos: gm repos [<word>]"
  word=$(printf '%s' "$word" | tr '[:upper:]' '[:lower:]')
  known=''
  if [ -s "$GM_DB" ]; then
    known=$(gm_sql "SELECT DISTINCT repo FROM focus ORDER BY repo;")
  fi
  roots=$(gm_conf_get repo-roots)
  [ -n "$roots" ] || roots="$HOME/IdeaProjects $HOME/src $HOME/work $HOME/code $HOME/projects $HOME/dev $HOME/git $HOME/repos $HOME/Developer $HOME/workspace"
  {
    printf '%s\n' "$known"
    set -f
    for r in $roots; do
      case $r in \~) r=$HOME ;; \~/*) r=$HOME/${r#\~/} ;; esac
      [ -d "$r" ] || continue
      find "$r" -maxdepth 4 \( -name node_modules -o -name .gradle -o -name target -o -name vendor \) -prune -o \
        -name .git -print 2>/dev/null | sed 's#/\.git$##'
    done
    set +f
  } | awk -v w="$word" 'NF && !seen[$0]++ { n = split($0, p, "/"); if (w == "" || index(tolower(p[n]), w)) print }'
}

command -v sqlite3 >/dev/null 2>&1 || gm_die "gm needs the sqlite3 command"
cmd=${1:-front-desk}
[ $# -eq 0 ] || shift
# Settings left in setup.conf move to guild.conf here; never from a hook or the status line, which only read them.
case $cmd in
  hook | statusline | help | -h | --help) ;;
  *) gm_conf_migrate ;;
esac
case $cmd in
  open | post | resolve | list | ls | show | notice | park | phase | where | trace | stats | collector) gm_init_auto ;;
esac
if [ -s "$GM_DB" ]; then
  case $cmd in
    statusline) ;;
    hook)
      # The hooks that only record skip the check; a span they cannot write is dropped and counted. The front desk's
      # guard, run before its tool calls, never touches the register.
      case ${1:-} in
        session-end | pre-tool | post-tool | post-tool-failure | subagent-start | subagent-stop | stop-failure | front-desk-guard) ;;
        *) (gm_db_ensure) >/dev/null 2>&1 && GM_DB_READY=1 || true ;;
      esac ;;
    *) gm_db_ensure ;;
  esac
fi
case $cmd in
  front-desk | open | up | close | start | autostart | install | hook | statusline | collector | config | repos | help | -h | --help) ;;
  *) gm_auto_reconcile ;;
esac
case $cmd in
  front-desk) gm_cmd_front_desk "$@" ;;
  repos) gm_cmd_repos "$@" ;;
  open) gm_cmd_open "$@" ;;
  up) gm_cmd_up "$@" ;;
  roster) gm_cmd_roster "$@" ;;
  close) gm_cmd_close "$@" ;;
  start) gm_cmd_start "$@" ;;
  autostart) gm_cmd_autostart "$@" ;;
  install) gm_cmd_install "$@" ;;
  post) gm_cmd_post "$@" ;;
  resolve) gm_cmd_resolve "$@" ;;
  list | ls) gm_cmd_list "$@" ;;
  show) gm_cmd_show "$@" ;;
  notice) gm_cmd_notice "$@" ;;
  park) gm_cmd_park "$@" ;;
  phase) gm_cmd_phase "$@" ;;
  where) gm_cmd_where "$@" ;;
  statusline) gm_cmd_statusline "$@" ;;
  trace) gm_cmd_trace "$@" ;;
  stats) gm_cmd_stats "$@" ;;
  hook) gm_cmd_hook "$@" ;;
  collector) gm_cmd_collector "$@" ;;
  config) gm_cmd_config "$@" ;;
  init) gm_cmd_init "$@" ;;
  doctor) gm_cmd_doctor "$@" ;;
  help | -h | --help) gm_usage ;;
  *) printf "gm: unknown command '%s'\n\n" "$cmd" >&2; gm_usage >&2; exit 1 ;;
esac
