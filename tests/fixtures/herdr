#!/usr/bin/env bash
# Stands in for herdr in tests/run.sh, which puts it first on PATH: no real herdr is ever called.
# State lives in plain files under $HERDR_STUB:
#   running      present while the server runs
#   workspaces   id<TAB>label, in the sidebar's order (herdr-socket moves them)
#   tabs         id<TAB>workspace<TAB>label
#   panes        id<TAB>tab<TAB>workspace<TAB>what runs: shell, claude, or any other command name
#   calls        every call, one a line
#   runs         pane<TAB>the line typed into it by pane run
#   splits       pane split<TAB>the new pane<TAB>its --direction
#   titles       pane<TAB>the title pane rename gave it
#   fg/<pane>    when present, the pane's foreground processes as process-info lists them (JSON objects, comma-
#                separated; its shell is added), in place of what the panes file says it runs
#   run-proc     what a pane runs after pane run (default claude)
#   run-proc-collector  what the collector's pane runs after pane run (default otelcol-contrib)
#   typed        pane<TAB>the text sent to it by pane send-text, or <key> for pane send-keys
#   agent-status what agent get says a claude pane is doing (default idle); agent-status.<pane>, that pane alone
#   screens/     what pane read shows, a screen a file (1, 2, ...): each read shows the next, then the last one again;
#                a pane send-keys ctrl+s moves to the file after-stash when there is one
#   screen.<pane> what pane read shows of that pane alone, every time
#   exit-ignored present while a claude pane ignores /exit; otherwise /exit and Enter leave it holding a shell
#   focused      each workspace or tab focused, one a line
#   attached     present once a client attached (herdr with no command)
#   notifications title<TAB>body<TAB>sound of each notification show
# Every call must carry --session $HERDR_STUB_SESSION; any other session is refused and recorded in violations.
set -u
D=${HERDR_STUB:?HERDR_STUB is not set}
mkdir -p "$D"
touch "$D/workspaces" "$D/tabs" "$D/panes"
if [ "${1:-}" = --version ]; then
  printf 'herdr 0.9.1 (stub)\n'
  exit 0
fi
args=() session=''
while [ $# -gt 0 ]; do
  case $1 in
    --session) session=${2:-}; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"
printf '%s\n' "$* --session $session" >>"$D/calls"
if [ "$session" != "${HERDR_STUB_SESSION:?}" ]; then
  printf '%s\n' "$* --session $session" >>"$D/violations"
  printf '{"error":{"code":"stub_wrong_session","message":"the stub serves only %s"}}\n' "$HERDR_STUB_SESSION"
  exit 2
fi

next() {
  local n
  n=$(cat "$D/next" 2>/dev/null || echo 0)
  n=$((n + 1))
  printf '%s' "$n" >"$D/next"
  printf '%s' "$n"
}
field() { awk -F '\t' -v k="$2" -v c="$3" '$1 == k { print $c; exit }' "$D/$1"; }
err() { printf '{"error":{"code":"%s","message":"%s"}}\n' "$1" "$2"; exit 1; }
up() { [ -e "$D/running" ] || err server_not_running "no server"; }
tab_json() { printf '{"tab_id":"%s","workspace_id":"%s","label":"%s"}' "$1" "$(field tabs "$1" 2)" "$(field tabs "$1" 3)"; }
pane_json() { printf '{"pane_id":"%s","tab_id":"%s","workspace_id":"%s"}' "$1" "$(field panes "$1" 2)" "$(field panes "$1" 3)"; }
new_tab() { # <workspace> <label>: prints tab<TAB>pane
  local t p
  t="$1:t$(next)"
  p="$1:p$(next)"
  printf '%s\t%s\t%s\n' "$t" "$1" "$2" >>"$D/tabs"
  printf '%s\t%s\t%s\tshell\n' "$p" "$t" "$1" >>"$D/panes"
  printf '%s\t%s' "$t" "$p"
}
opt() { # <name> <args...>: the value after --name
  local name=$1
  shift
  while [ $# -gt 0 ]; do
    [ "$1" != "--$name" ] || { printf '%s' "${2:-}"; return; }
    shift
  done
}

case "${1:-} ${2:-}" in
  " ")
    # herdr alone attaches a client; the stub only records it.
    touch "$D/attached" ;;
  "workspace focus" | "tab focus")
    up
    printf '%s\n' "$3" >>"$D/focused"
    printf '{"result":{"type":"ok"}}\n' ;;
  "status --json")
    if [ -e "$D/running" ]; then r=true; else r=false; fi
    printf '{"client":{"version":"0.9.1"},"server":{"running":%s,"socket":"%s/herdr.sock"}}\n' "$r" "$D" ;;
  "server "*)
    touch "$D/running" ;;
  "workspace create")
    up
    w="w$(next)"
    label=$(opt label "$@")
    printf '%s\t%s\n' "$w" "$label" >>"$D/workspaces"
    IFS=$'\t' read -r t p <<<"$(new_tab "$w" 1)"
    printf '{"result":{"type":"workspace_created","workspace":{"workspace_id":"%s","label":"%s"},"tab":%s,"root_pane":%s}}\n' \
      "$w" "$label" "$(tab_json "$t")" "$(pane_json "$p")" ;;
  "workspace list")
    up
    list=$(awk -F '\t' '{ printf "%s{\"workspace_id\":\"%s\",\"label\":\"%s\"}", (NR > 1 ? "," : ""), $1, $2 }' "$D/workspaces")
    printf '{"result":{"type":"workspace_list","workspaces":[%s]}}\n' "$list" ;;
  "workspace get")
    up
    label=$(field workspaces "$3" 2)
    [ -n "$label" ] || err workspace_not_found "workspace $3 not found"
    printf '{"result":{"type":"workspace_info","workspace":{"workspace_id":"%s","label":"%s"}}}\n' "$3" "$label" ;;
  "workspace close")
    up
    [ -n "$(field workspaces "$3" 1)" ] || err workspace_not_found "workspace $3 not found"
    awk -F '\t' -v w="$3" '$1 != w' "$D/workspaces" >"$D/workspaces.new" && mv "$D/workspaces.new" "$D/workspaces"
    awk -F '\t' -v w="$3" '$2 != w' "$D/tabs" >"$D/tabs.new" && mv "$D/tabs.new" "$D/tabs"
    awk -F '\t' -v w="$3" '$3 != w' "$D/panes" >"$D/panes.new" && mv "$D/panes.new" "$D/panes"
    printf '{"result":{"type":"ok"}}\n' ;;
  "tab create")
    up
    w=$(opt workspace "$@")
    [ -n "$(field workspaces "$w" 1)" ] || err workspace_not_found "workspace $w not found"
    IFS=$'\t' read -r t p <<<"$(new_tab "$w" "$(opt label "$@")")"
    printf '{"result":{"type":"tab_created","tab":%s,"root_pane":%s}}\n' "$(tab_json "$t")" "$(pane_json "$p")" ;;
  "tab rename")
    up
    awk -F '\t' -v OFS='\t' -v k="$3" -v l="$4" '$1 == k { $3 = l } { print }' "$D/tabs" >"$D/tabs.new" && mv "$D/tabs.new" "$D/tabs"
    printf '{"result":{"type":"tab_info","tab":%s}}\n' "$(tab_json "$3")" ;;
  "pane split")
    up
    t=$(field panes "$3" 2)
    w=$(field panes "$3" 3)
    [ -n "$t" ] || err pane_not_found "pane $3 not found"
    p="$w:p$(next)"
    printf '%s\t%s\t%s\tshell\n' "$p" "$t" "$w" >>"$D/panes"
    printf '%s\t%s\t%s\n' "$3" "$p" "$(opt direction "$@")" >>"$D/splits"
    printf '{"result":{"type":"pane_info","pane":%s}}\n' "$(pane_json "$p")" ;;
  "pane rename")
    up
    [ -n "$(field panes "$3" 1)" ] || err pane_not_found "pane $3 not found"
    printf '%s\t%s\n' "$3" "$4" >>"$D/titles"
    printf '{"result":{"type":"ok"}}\n' ;;
  "pane get")
    up
    [ -n "$(field panes "$3" 1)" ] || err pane_not_found "pane $3 not found"
    printf '{"result":{"type":"pane_info","pane":%s}}\n' "$(pane_json "$3")" ;;
  "pane process-info")
    up
    p=$(opt pane "$@")
    proc=$(field panes "$p" 4)
    [ -n "$proc" ] || err pane_not_found "pane not found"
    if [ -f "$D/fg/$p" ]; then
      proc='fg'
      fg="$(cat "$D/fg/$p"),{\"name\":\"zsh\",\"argv0\":\"zsh\",\"argv\":[\"-zsh\"],\"pid\":999991}"
    fi
    case $proc in
      fg) ;;
      shell) fg='{"name":"zsh","argv0":"zsh","argv":["-zsh"],"pid":999991}' ;;
      claude) fg='{"name":"claude","argv0":"claude","argv":["claude","--name","x"],"pid":999992},{"name":"zsh","argv0":"zsh","argv":["-zsh"],"pid":999991}' ;;
      *) fg="{\"name\":\"$proc\",\"argv0\":\"$proc\",\"argv\":[\"$proc\"],\"pid\":999993},{\"name\":\"zsh\",\"argv0\":\"zsh\",\"argv\":[\"-zsh\"],\"pid\":999991}" ;;
    esac
    printf '{"result":{"type":"pane_process_info","process_info":{"pane_id":"%s","shell_pid":999991,"foreground_processes":[%s]}}}\n' "$p" "$fg" ;;
  "pane run")
    up
    [ -n "$(field panes "$3" 1)" ] || err pane_not_found "pane $3 not found"
    printf '%s\t%s\n' "$3" "$4" >>"$D/runs"
    proc=$(cat "$D/run-proc" 2>/dev/null || echo claude)
    case $4 in *" start 'collector' "*) proc=$(cat "$D/run-proc-collector" 2>/dev/null || echo otelcol-contrib) ;; esac
    awk -F '\t' -v OFS='\t' -v k="$3" -v v="$proc" '$1 == k { $4 = v } { print }' "$D/panes" >"$D/panes.new" && mv "$D/panes.new" "$D/panes" ;;
  "pane send-text")
    up
    [ -n "$(field panes "$3" 1)" ] || err pane_not_found "pane $3 not found"
    printf '%s\t%s\n' "$3" "$4" >>"$D/typed"
    printf '{"result":{"type":"ok"}}\n' ;;
  "pane send-keys")
    up
    [ -n "$(field panes "$3" 1)" ] || err pane_not_found "pane $3 not found"
    last=$(awk -F '\t' -v k="$3" '$1 == k { t = $2 } END { print t }' "$D/typed" 2>/dev/null)
    printf '%s\t<%s>\n' "$3" "${*:4}" >>"$D/typed"
    [ "$4" != ctrl+s ] || [ ! -d "$D/screens" ] || : >"$D/screens/stashed"
    if [ "$4" = enter ] && [ "$last" = /exit ] && [ "$(field panes "$3" 4)" = claude ] && [ ! -e "$D/exit-ignored" ]; then
      awk -F '\t' -v OFS='\t' -v k="$3" '$1 == k { $4 = "shell" } { print }' "$D/panes" >"$D/panes.new" && mv "$D/panes.new" "$D/panes"
    fi
    printf '{"result":{"type":"ok"}}\n' ;;
  "pane close")
    up
    w=$(field panes "$3" 3)
    awk -F '\t' -v k="$3" '$1 != k' "$D/panes" >"$D/panes.new" && mv "$D/panes.new" "$D/panes"
    # As herdr does, closing a workspace's last pane closes the workspace.
    if [ -n "$w" ] && ! awk -F '\t' -v w="$w" '$3 == w { found = 1 } END { exit !found }' "$D/panes"; then
      awk -F '\t' -v w="$w" '$1 != w' "$D/workspaces" >"$D/workspaces.new" && mv "$D/workspaces.new" "$D/workspaces"
      awk -F '\t' -v w="$w" '$2 != w' "$D/tabs" >"$D/tabs.new" && mv "$D/tabs.new" "$D/tabs"
    fi
    printf '{"result":{"type":"ok"}}\n' ;;
  "pane read")
    up
    [ -n "$(field panes "$3" 1)" ] || err pane_not_found "pane $3 not found"
    n=$(cat "$D/screens/at" 2>/dev/null || echo 0)
    if [ -f "$D/screen.$3" ]; then
      cat "$D/screen.$3"
    elif [ -e "$D/screens/stashed" ] && [ -f "$D/screens/after-stash" ]; then
      cat "$D/screens/after-stash"
    else
      [ ! -f "$D/screens/$((n + 1))" ] || { n=$((n + 1)); printf '%s' "$n" >"$D/screens/at"; }
      [ ! -f "$D/screens/$n" ] || cat "$D/screens/$n"
    fi ;;
  "notification show")
    up
    printf '%s\t%s\t%s\n' "$3" "$(opt body "$@")" "$(opt sound "$@")" >>"$D/notifications"
    printf '{"result":{}}\n' ;;
  "agent get")
    up
    [ "$(field panes "$3" 4)" = claude ] || err agent_not_found "agent target $3 not found"
    printf '{"result":{"agent":{"agent":"claude","agent_status":"%s"}}}\n' "$(cat "$D/agent-status.$3" 2>/dev/null || cat "$D/agent-status" 2>/dev/null || echo idle)" ;;
  *)
    err stub_unknown "the stub does not know: $*" ;;
esac
